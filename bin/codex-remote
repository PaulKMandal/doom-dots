def global_agents_template_path() -> Path:
    return Path(__file__).resolve().parent.parent / "templates" / "codex" / "global-AGENTS.md"


def cmd_install_agents(args: argparse.Namespace) -> dict[str, Any]:
    root, host, _remote_dir, timeout, project_id, project_name = common_local_args(args)
    template = global_agents_template_path()
    if not template.is_file():
        raise CodexRemoteError(
            f"Global AGENTS template is missing: {template}", code="TEMPLATE_MISSING"
        )
    content = template.read_text(encoding="utf-8").strip() + "\n"
    context = ensure_remote_helper(host, timeout)
    value = remote_invoke(
        context,
        ["_server-install-agents", "--project-id", project_id],
        timeout=timeout,
        payload={
            "content": content,
            "sha256": hashlib.sha256(content.encode("utf-8")).hexdigest(),
        },
    )
    value.update(
        {
            "command": "install-agents",
            "project_id": project_id,
            "project_name": project_name,
            "project_root": str(root),
            "remote_host": host,
        }
    )
    return value


# ---------------------------------------------------------------------------
# Server-side implementation
# ---------------------------------------------------------------------------


def server_paths(project_id: str) -> dict[str, Path]:
    validate_safe_id(project_id, "project id")
    home = Path.home()
    share = home / REMOTE_SHARE_RELATIVE
    state_root = home / REMOTE_STATE_RELATIVE
    return {
        "home": home,
        "share": share,
        "state_root": state_root,
        "broker": share / "repos" / f"{project_id}.git",
        "worktrees": share / "worktrees" / project_id,
        "job_worktrees": share / "job-worktrees" / project_id,
        "project_state": state_root / project_id,
        "jobs_state": state_root / "jobs" / project_id,
        "current": state_root / project_id / "current.json",
        "lock": state_root / "locks" / f"{project_id}.lock",
    }


def ensure_server_layout(project_id: str) -> dict[str, Path]:
    paths = server_paths(project_id)
    for key in (
        "share",
        "state_root",
        "worktrees",
        "job_worktrees",
        "project_state",
        "jobs_state",
    ):
        paths[key].mkdir(parents=True, exist_ok=True, mode=0o700)
    paths["broker"].parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    paths["lock"].parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if not paths["broker"].exists():
        run(["git", "init", "--bare", paths["broker"]])
    return paths


def task_state_path(paths: Mapping[str, Path], task: str) -> Path:
    validate_safe_id(task, "task id")
    return paths["project_state"] / task / "task.json"


def load_server_task(paths: Mapping[str, Path], task: str | None = None) -> dict[str, Any] | None:
    if task is None:
        current = read_json(paths["current"])
        if not current:
            return None
        task = current.get("task_id")
        if not task:
            return None
    return read_json(task_state_path(paths, task))


def save_server_task(paths: Mapping[str, Path], task: dict[str, Any]) -> dict[str, Any]:
    task = dict(task)
    task["updated_at"] = utc_now()
    atomic_write_json(task_state_path(paths, task["task_id"]), task)
    atomic_write_json(paths["current"], {"task_id": task["task_id"], "state": task["state"], "updated_at": task["updated_at"]})
    return task


def checkpoint_state_path(task: Mapping[str, Any]) -> Path:
    """Return the state file used for a live interactive checkpoint.

    Checkpoint metadata is deliberately separate from ``task.json``.  The
    interactive runner updates ``task.json`` throughout its lifetime, while a
    laptop pull may publish a committed checkpoint concurrently.  A separate
    file avoids either writer accidentally overwriting the other's fields.
    """
    state_dir = task.get("state_dir")
    if not isinstance(state_dir, str) or not state_dir:
        raise CodexRemoteError(
            "Task is missing its server state directory",
            code="INVALID_TASK_STATE",
        )
    return Path(state_dir) / "checkpoint.json"


def load_task_checkpoint(task: Mapping[str, Any]) -> dict[str, Any] | None:
    return read_json(checkpoint_state_path(task))


def checkpoint_ref_name(task: Mapping[str, Any]) -> str:
    return (
        f"refs/codex/{validate_safe_id(str(task['project_id']), 'project id')}"
        f"/checkpoint/{validate_safe_id(str(task['task_id']), 'task id')}"
    )


def live_job_state_path(task: Mapping[str, Any]) -> Path:
    state_dir = task.get("state_dir")
    if not isinstance(state_dir, str) or not state_dir:
        raise CodexRemoteError(
            "Task is missing its server state directory",
            code="INVALID_TASK_STATE",
        )
    return Path(state_dir) / "live-job.json"


def load_task_live_job(task: Mapping[str, Any]) -> dict[str, Any] | None:
    return read_json(live_job_state_path(task))


def publish_task_checkpoint(
    paths: Mapping[str, Path], task: Mapping[str, Any]
) -> dict[str, Any]:
    """Publish the task's stable committed HEAD without stopping the TUI.

    Uncommitted edits remain private to the server worktree.  Once a checkpoint
    has been published, later checkpoints must descend from it; this makes a
    history rewrite visible instead of silently changing commits already
    imported by the laptop.
    """
    if task_execution_mode(task) != "interactive":
        raise CodexRemoteError(
            "Live checkpoints are available only for interactive Codex tasks",
            code="CHECKPOINT_NOT_INTERACTIVE",
            details=dict(task),
        )
    worktree_value = task.get("worktree")
    if not isinstance(worktree_value, str) or not Path(worktree_value).is_dir():
        raise CodexRemoteError(
            "The interactive task worktree is missing",
            code="CHECKPOINT_WORKTREE_MISSING",
            details=dict(task),
        )
    worktree = Path(worktree_value)
    input_sha = str(task.get("input_sha") or "")
    if not input_sha:
        raise CodexRemoteError(
            "The interactive task is missing its input SHA",
            code="INVALID_TASK_STATE",
        )
    state_path = checkpoint_state_path(task)
    lock_path = state_path.with_name("checkpoint.lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with lock_path.open("a+") as lock_handle:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        prior = load_task_checkpoint(task) or {}
        prior_sha = str(prior.get("sha") or input_sha)
        ref = checkpoint_ref_name(task)
        for _attempt in range(5):
            head = current_head(worktree)
            if git(
                worktree,
                "merge-base",
                "--is-ancestor",
                input_sha,
                head,
                check=False,
            ).returncode != 0:
                raise CodexRemoteError(
                    "Interactive Codex rewrote history outside the task input",
                    code="INVALID_RESULT_HISTORY",
                )
            if git(
                worktree,
                "merge-base",
                "--is-ancestor",
                prior_sha,
                head,
                check=False,
            ).returncode != 0:
                raise CodexRemoteError(
                    "Interactive Codex rewrote commits that were already published. "
                    "Do not amend, rebase, or reset published checkpoints.",
                    code="CHECKPOINT_HISTORY_REWRITTEN",
                    details={"published_sha": prior_sha, "current_head": head},
                )
            check = git(
                worktree,
                "diff",
                "--check",
                input_sha,
                head,
                "--",
                check=False,
            )
            if check.returncode != 0:
                raise CodexRemoteError(
                    "Committed checkpoint failed `git diff --check`:\n"
                    + (check.stdout or check.stderr),
                    code="RESULT_DIFF_CHECK_FAILED",
                )
            ensure_safe_result_delta(
                worktree,
                input_sha,
                head,
                int(task.get("max_untracked_bytes") or DEFAULT_MAX_UNTRACKED_BYTES),
            )
            # A commit may finish while validation is running.  Retry until the
            # SHA we validated is still HEAD immediately before publication.
            if current_head(worktree) != head:
                continue
            run(["git", "--git-dir", paths["broker"], "update-ref", ref, head])
            commit_count = int(
                git(worktree, "rev-list", "--count", f"{input_sha}..{head}")
                .stdout.strip()
                or "0"
            )
            checkpoint = {
                "schema_version": SCHEMA_VERSION,
                "project_id": task.get("project_id"),
                "task_id": task.get("task_id"),
                "ref": ref,
                "sha": head,
                "previous_sha": prior_sha,
                "commit_count": commit_count,
                "dirty": bool(git_status_porcelain(worktree).strip()),
                "published_at": utc_now(),
            }
            atomic_write_json(state_path, checkpoint)
            return checkpoint
    raise CodexRemoteError(
        "Interactive HEAD kept changing while a checkpoint was being validated; retry shortly",
        code="CHECKPOINT_UNSTABLE",
    )


def login_which(program: str) -> str | None:
    script = f"type -P {shlex.quote(program)}"
    completed = run(["bash", "-lc", script], check=False)
    lines = [line.strip() for line in completed.stdout.splitlines() if line.strip()]
    value = lines[-1] if lines else ""
    return value if completed.returncode == 0 and value.startswith("/") else None


def command_version(path: str, *args: str) -> dict[str, Any]:
    completed = run([path, *args], check=False, timeout=30)
    return {
        "ok": completed.returncode == 0,
        "returncode": completed.returncode,
        "stdout": completed.stdout.strip(),
        "stderr": completed.stderr.strip(),
    }


def server_remote_description(paths: Mapping[str, Path]) -> dict[str, Any]:
    return {
        "broker": str(paths["broker"]),
        "worktrees": str(paths["worktrees"]),
        "job_worktrees": str(paths["job_worktrees"]),
        "state_root": str(paths["state_root"]),
        "jobs_state": str(paths["jobs_state"]),
        "lock": str(paths["lock"]),
    }


def server_init(project_id: str) -> dict[str, Any]:
    paths = ensure_server_layout(project_id)
    return {"ok": True, "remote": server_remote_description(paths)}


def server_install_agents(project_id: str, payload: Mapping[str, Any]) -> dict[str, Any]:
    paths = ensure_server_layout(project_id)
    content = payload.get("content")
    expected_hash = payload.get("sha256")
    if not isinstance(content, str) or not content.strip() or len(content.encode("utf-8")) > 64 * 1024:
        raise CodexRemoteError("Invalid global AGENTS content", code="INVALID_AGENTS_CONTENT")
    actual_hash = hashlib.sha256(content.encode("utf-8")).hexdigest()
    if expected_hash != actual_hash:
        raise CodexRemoteError("Global AGENTS content hash mismatch", code="PAYLOAD_HASH_MISMATCH")
    target = paths["home"] / ".codex" / "AGENTS.md"
    existing = target.read_text(encoding="utf-8") if target.is_file() else ""
    begin_count = existing.count(GLOBAL_AGENTS_BEGIN)
    end_count = existing.count(GLOBAL_AGENTS_END)
    if (begin_count, end_count) not in {(0, 0), (1, 1)}:
        raise CodexRemoteError(
            f"Managed markers are malformed in {target}; repair them manually before retrying",
            code="MALFORMED_MANAGED_BLOCK",
        )
    if begin_count:
        start = existing.index(GLOBAL_AGENTS_BEGIN)
        end_start = existing.find(GLOBAL_AGENTS_END, start)
        if end_start < 0:
            raise CodexRemoteError(
                f"Managed markers are out of order in {target}; repair them manually before retrying",
                code="MALFORMED_MANAGED_BLOCK",
            )
        end = end_start + len(GLOBAL_AGENTS_END)
        prefix = existing[:start].rstrip()
        suffix = existing[end:].lstrip()
        outside = "\n\n".join(part for part in (prefix, suffix) if part)
    else:
        outside = existing.strip()
    block = f"{GLOBAL_AGENTS_BEGIN}\n{content.strip()}\n{GLOBAL_AGENTS_END}"
    updated = (outside + "\n\n" + block if outside else block) + "\n"
    atomic_write_text(target, updated)
    return {
        "ok": True,
        "path": str(target),
        "sha256": hashlib.sha256(updated.encode("utf-8")).hexdigest(),
        "managed_content_sha256": actual_hash,
    }


def server_doctor(project_id: str) -> dict[str, Any]:
    paths = ensure_server_layout(project_id)
    tools = {name: login_which(name) for name in ("bash", "git", "tmux", "flock", "codex")}
    tools["python3"] = str(Path(sys.executable).resolve())
    missing = [name for name, path in tools.items() if not path]
    codex_version = command_version(tools["codex"], "--version") if tools.get("codex") else None
    python_version = command_version(tools["python3"], "--version")
    auth = command_version(tools["codex"], "login", "status") if tools.get("codex") else None
    usage = shutil.disk_usage(paths["share"])
    remote = server_remote_description(paths)
    remote.update(
        {
            "tools": tools,
            "missing": missing,
            "codex_version": codex_version,
            "python_version": python_version,
            "codex_auth": auth,
            "disk_free_bytes": usage.free,
        }
    )
    if missing:
        raise CodexRemoteError(
            "Remote prerequisites missing: " + ", ".join(missing),
            code="REMOTE_PREREQUISITES_MISSING",
            details=remote,
        )
    if not auth or not auth["ok"]:
        raise CodexRemoteError(
            "Codex is installed on the server but is not authenticated. Run `codex login --device-auth` "
            "or another supported login method on the server, then retry doctor.",
            code="REMOTE_CODEX_NOT_AUTHENTICATED",
            details=remote,
        )
    if usage.free < 512 * 1024 * 1024:
        raise CodexRemoteError(
            f"Remote Codex storage has only {usage.free} bytes free", code="REMOTE_DISK_LOW", details=remote
        )
    return {"ok": True, "remote": remote}


def task_outstanding(task: Mapping[str, Any] | None) -> bool:
    if not task:
        return False
    return task.get("state", "NONE") not in ALLOW_NEW_TASK_STATES


def data_link_specs(payload: Mapping[str, Any]) -> list[dict[str, str]]:
    value = payload.get("data_links") or []
    if not isinstance(value, list):
        raise CodexRemoteError("data_links must be a list", code="INVALID_DATA_LINK")
    result = []
    for item in value:
        if not isinstance(item, dict) or not isinstance(item.get("source"), str) or not isinstance(item.get("target"), str):
            raise CodexRemoteError("Invalid data link entry", code="INVALID_DATA_LINK")
        source = Path(item["source"]).expanduser()
        target = Path(item["target"])
        if not source.is_absolute():
            raise CodexRemoteError(f"Data-link source must be absolute: {source}", code="INVALID_DATA_LINK")
        if target.is_absolute() or ".." in target.parts or not target.parts:
            raise CodexRemoteError(f"Data-link target must stay inside the worktree: {target}", code="INVALID_DATA_LINK")
        if not source.exists():
            raise CodexRemoteError(f"Data-link source does not exist: {source}", code="INVALID_DATA_LINK")
        result.append({"source": str(source), "target": target.as_posix()})
    return result


def validate_codex_configuration(payload: Mapping[str, Any]) -> None:
    execution_mode = payload.get("execution_mode", "exec")
    if execution_mode not in EXECUTION_MODES:
        raise CodexRemoteError(
            f"Invalid Codex execution mode: {execution_mode}",
            code="INVALID_EXECUTION_MODE",
        )
    effort = payload.get("reasoning_effort")
    if effort and effort not in SAFE_REASONING:
        raise CodexRemoteError(f"Invalid reasoning effort: {effort}", code="INVALID_CODEX_CONFIG")
    for key in ("model", "profile"):
        value = payload.get(key)
        if value is not None and (not isinstance(value, str) or "\n" in value or "\r" in value):
            raise CodexRemoteError(f"Invalid Codex {key}", code="INVALID_CODEX_CONFIG")
    job_policy = payload.get("job_policy", "deny")
    if job_policy not in JOB_POLICIES:
        raise CodexRemoteError(
            f"Invalid job policy: {job_policy}", code="INVALID_JOB_POLICY"
        )


def normalized_env_request(value: Mapping[str, Any]) -> dict[str, Any]:
    action = value.get("action")
    if action not in ENV_ACTIONS:
        raise CodexRemoteError(
            "Environment action must be refresh, test, or check",
            code="INVALID_ENV_REQUEST",
        )
    return {
        "schema_version": SCHEMA_VERSION,
        "action": action,
        "requested_at": value.get("requested_at") or utc_now(),
    }


def request_env_action_file(
    request_file: Path,
    response_file: Path,
    *,
    action: str,
    wait_seconds: int,
) -> dict[str, Any]:
    """Request one trusted environment action from the live runner."""
    if request_file.name != ENV_REQUEST_RELATIVE or response_file.name != ENV_RESPONSE_RELATIVE:
        raise CodexRemoteError(
            "Unexpected environment control path", code="INVALID_ENV_REQUEST"
        )
    expected_path = os.environ.get("CODEX_ENV_REQUEST_PATH")
    if expected_path and request_file.resolve(strict=False) != Path(expected_path).resolve(strict=False):
        raise CodexRemoteError(
            "Environment request path does not match the runner-authorized worktree",
            code="INVALID_ENV_REQUEST",
        )
    request = normalized_env_request({"action": action})
    if request_file.exists() or request_file.is_symlink():
        raise CodexRemoteError(
            "An environment request is already pending", code="ENV_REQUEST_EXISTS"
        )
    with contextlib.suppress(FileNotFoundError):
        response_file.unlink()
    atomic_write_json(request_file, request)
    deadline = time.monotonic() + wait_seconds
    while time.monotonic() < deadline:
        response = read_json(response_file)
        if response is not None:
            with contextlib.suppress(FileNotFoundError):
                response_file.unlink()
            if not response.get("ok", False):
                raise CodexRemoteError(
                    str(response.get("error") or "The trusted environment action failed"),
                    code=str(response.get("error_code") or "ENV_ACTION_FAILED"),
                    details=response.get("details"),
                )
            return response
        time.sleep(0.2)
    raise CodexRemoteError(
        "Timed out waiting for the trusted runner to process the environment request",
        code="ENV_REQUEST_TIMEOUT",
    )


def consume_env_request(task: Mapping[str, Any]) -> dict[str, Any] | None:
    request_path = Path(task["worktree"]) / ENV_REQUEST_RELATIVE
    if not request_path.exists() and not request_path.is_symlink():
        return None
    if request_path.is_symlink() or not request_path.is_file():
        raise CodexRemoteError(
            "The environment request is not a regular file",
            code="INVALID_ENV_REQUEST",
        )
    if request_path.stat().st_size > 64 * 1024:
        with contextlib.suppress(FileNotFoundError):
            request_path.unlink()
        raise CodexRemoteError(
            "The environment request is too large", code="INVALID_ENV_REQUEST"
        )
    try:
        value = read_json(request_path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            request_path.unlink()
    if not isinstance(value, dict):
        raise CodexRemoteError(
            "The environment request is invalid JSON", code="INVALID_ENV_REQUEST"
        )
    return normalized_env_request(value)


def normalized_job_request(value: Mapping[str, Any]) -> dict[str, Any]:
    """Validate and normalize one frozen experiment launch request."""
    name = value.get("name")
    if not isinstance(name, str) or not name.strip() or len(name.strip()) > 96:
        raise CodexRemoteError(
            "A job request needs a nonempty name of at most 96 characters",
            code="INVALID_JOB_REQUEST",
        )
    if any(ord(char) < 32 for char in name):
        raise CodexRemoteError("Job name contains control characters", code="INVALID_JOB_REQUEST")

    command = value.get("command")
    if not isinstance(command, list) or not command:
        raise CodexRemoteError(
            "A job request needs a nonempty argv command",
            code="INVALID_JOB_REQUEST",
        )
    normalized_command: list[str] = []
    for argument in command:
        if not isinstance(argument, str) or not argument or "\x00" in argument:
            raise CodexRemoteError(
                "Job command arguments must be nonempty strings without NUL bytes",
                code="INVALID_JOB_REQUEST",
            )
        if len(argument) > 8192:
            raise CodexRemoteError("Job command argument is too long", code="INVALID_JOB_REQUEST")
        normalized_command.append(argument)
    if len(normalized_command) > 256:
        raise CodexRemoteError("Job command has too many arguments", code="INVALID_JOB_REQUEST")

    gpus = value.get("gpus") or ""
    if not isinstance(gpus, str) or (gpus and not re.fullmatch(r"[0-9]+(?:,[0-9]+)*", gpus)):
        raise CodexRemoteError(
            "GPU selection must be a comma-separated list such as 0,1",
            code="INVALID_JOB_REQUEST",
        )

    completion_marker = value.get("completion_marker") or ""
    if not isinstance(completion_marker, str):
        raise CodexRemoteError("Invalid completion marker", code="INVALID_JOB_REQUEST")
    if completion_marker:
        marker = PurePosixPath(completion_marker)
        if marker.is_absolute() or ".." in marker.parts or not marker.parts:
            raise CodexRemoteError(
                "Completion marker must be relative to the frozen job worktree",
                code="INVALID_JOB_REQUEST",
            )
        completion_marker = marker.as_posix()

    resume_command = value.get("resume_command") or ""
    if not isinstance(resume_command, str) or "\x00" in resume_command or len(resume_command) > 16384:
        raise CodexRemoteError("Invalid resume command", code="INVALID_JOB_REQUEST")

    metadata = value.get("metadata") or {}
    if not isinstance(metadata, dict) or len(metadata) > 64:
        raise CodexRemoteError("Invalid job metadata", code="INVALID_JOB_REQUEST")
    normalized_metadata: dict[str, str] = {}
    for key, item in metadata.items():
        if not isinstance(key, str) or not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", key):
            raise CodexRemoteError(f"Invalid job metadata key: {key!r}", code="INVALID_JOB_REQUEST")
        if not isinstance(item, str) or "\x00" in item or len(item) > 4096:
            raise CodexRemoteError(f"Invalid value for job metadata key {key}", code="INVALID_JOB_REQUEST")
        normalized_metadata[key] = item

    requested_at = value.get("requested_at") or utc_now()
    if not isinstance(requested_at, str) or len(requested_at) > 128 or "\x00" in requested_at:
        raise CodexRemoteError("Invalid job request timestamp", code="INVALID_JOB_REQUEST")

    return {
        "schema_version": SCHEMA_VERSION,
        "name": name.strip(),
        "command": normalized_command,
        "gpus": gpus,
        "completion_marker": completion_marker,
        "resume_command": resume_command,
        "metadata": normalized_metadata,
        "requested_at": requested_at,
    }


def request_job_file(
    request_file: Path,
    *,
    name: str,
    command: Sequence[str],
    gpus: str = "",
    completion_marker: str = "",
    resume_command: str = "",
    metadata_values: Sequence[str] = (),
    response_file: Path | None = None,
    wait_seconds: int = 0,
) -> dict[str, Any]:
    """Write the single job request consumed by the trusted runner.

    Interactive jobctl calls may wait for an unsandboxed runner thread to
    validate, freeze, and launch the job, then return its response while the
    Codex TUI remains open.
    """
    if request_file.name != JOB_REQUEST_RELATIVE:
        raise CodexRemoteError("Unexpected job request path", code="INVALID_JOB_REQUEST")
    expected_path = os.environ.get("CODEX_JOB_REQUEST_PATH")
    if expected_path and request_file.resolve(strict=False) != Path(expected_path).resolve(strict=False):
        raise CodexRemoteError(
            "Job request path does not match the runner-authorized worktree",
            code="INVALID_JOB_REQUEST",
        )
    metadata: dict[str, str] = {}
    for value in metadata_values:
        if "=" not in value:
            raise CodexRemoteError(
                f"Job metadata must have KEY=VALUE form: {value}",
                code="INVALID_JOB_REQUEST",
            )
        key, item = value.split("=", 1)
        if key in metadata:
            raise CodexRemoteError(f"Duplicate job metadata key: {key}", code="INVALID_JOB_REQUEST")
        metadata[key] = item
    request = normalized_job_request(
        {
            "name": name,
            "command": list(command),
            "gpus": gpus,
            "completion_marker": completion_marker,
            "resume_command": resume_command,
            "metadata": metadata,
        }
    )
    if request_file.exists() or request_file.is_symlink():
        raise CodexRemoteError(
            "A job request already exists for this Codex task",
            code="JOB_REQUEST_EXISTS",
        )
    atomic_write_json(request_file, request)
    if response_file is not None and wait_seconds > 0:
        deadline = time.monotonic() + wait_seconds
        while time.monotonic() < deadline:
            response = read_json(response_file)
            if response is not None:
                with contextlib.suppress(FileNotFoundError):
                    response_file.unlink()
                if not response.get("ok", False):
                    raise CodexRemoteError(
                        str(response.get("error") or "The trusted job launcher failed"),
                        code=str(response.get("error_code") or "JOB_LAUNCH_FAILED"),
                        details=response.get("details"),
                    )
                return response
            time.sleep(0.2)
        raise CodexRemoteError(
            "Timed out waiting for the trusted runner to process the job request",
            code="JOB_REQUEST_TIMEOUT",
        )
    return {"ok": True, "request": request, "request_file": str(request_file)}


def job_request_from_arguments(
    *,
    name: str,
    command: Sequence[str],
    gpus: str = "",
    completion_marker: str = "",
    resume_command: str = "",
    metadata_values: Sequence[str] = (),
) -> dict[str, Any]:
    metadata: dict[str, str] = {}
    for value in metadata_values:
        if "=" not in value:
            raise CodexRemoteError(
                f"Job metadata must have KEY=VALUE form: {value}",
                code="INVALID_JOB_REQUEST",
            )
        key, item = value.split("=", 1)
        if key in metadata:
            raise CodexRemoteError(
                f"Duplicate job metadata key: {key}",
                code="INVALID_JOB_REQUEST",
            )
        metadata[key] = item
    return normalized_job_request(
        {
            "name": name,
            "command": list(command),
            "gpus": gpus,
            "completion_marker": completion_marker,
            "resume_command": resume_command,
            "metadata": metadata,
        }
    )


def consume_job_request(task: Mapping[str, Any]) -> dict[str, Any] | None:
    """Remove and validate Codex's request before result publication."""
    request_path = Path(task["worktree"]) / JOB_REQUEST_RELATIVE
    if not request_path.exists() and not request_path.is_symlink():
        return None
    if request_path.is_symlink() or not request_path.is_file():
        raise CodexRemoteError(
            "The job request is not a regular file", code="INVALID_JOB_REQUEST"
        )
    if request_path.stat().st_size > 256 * 1024:
        with contextlib.suppress(FileNotFoundError):
            request_path.unlink()
        raise CodexRemoteError("The job request is too large", code="INVALID_JOB_REQUEST")
    try:
        value = read_json(request_path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            request_path.unlink()
    if not isinstance(value, dict):
        raise CodexRemoteError("The job request is invalid JSON", code="INVALID_JOB_REQUEST")
    request = normalized_job_request(value)
    policy = task.get("job_policy", "deny")
    if policy == "deny":
        raise CodexRemoteError(
            "Codex attempted to request a detached job without explicit authorization",
            code="JOB_NOT_AUTHORIZED",
            details=request,
        )
    state_dir = Path(task["state_dir"])
    atomic_write_json(state_dir / "job-request.json", request)
    return request


def codex_job_instructions(task: Mapping[str, Any]) -> str:
    """Return per-task launch rules injected as Codex developer instructions."""
    policy = task.get("job_policy", "deny")
    base = (
        "This repository is managed by codex-remote. Do not push, merge, switch branches, "
        "edit outside the assigned worktree, or delete existing "
        "result directories. Do not inspect unrelated repositories, SSH keys, credentials, "
        "tokens, or secret files. Run bounded foreground tests normally."
    )
    if task_execution_mode(task) == "interactive":
        base += (
            " Create small, coherent Git commits whenever a logical unit is complete and "
            "validated so the laptop can pull those commits while this session remains open. "
            "Do not amend, rebase, reset, or otherwise rewrite commits created in this "
            "session; the laptop may publish them at any time. Leave incomplete work "
            "uncommitted until it forms a coherent checkpoint."
            " When the user asks you to implement, build, fix, or change something, carry "
            "the in-scope task through inspection, editing, relevant non-destructive "
            "validation, failure diagnosis, and iteration; do not stop after merely "
            "proposing a plan or ask for routine worktree actions. The trusted runner has "
            "prepared the project development environment and exposes it through ordinary "
            "PATH plus the stable $CODEX_DEV wrapper. You may run uv add, uv sync, uv run, "
            "Python, Ruff, pytest, compilers, and other project-shell tools directly; use "
            "$CODEX_DEV COMMAND ... whenever you want the latest refreshed environment. "
            "You may update project dependency declarations and lock files when the task "
            "requires it, including flake.nix, flake.lock, pyproject.toml, and uv.lock. "
            "The Linux sandbox intentionally cannot contact the Nix daemon directly. After "
            "committing dependency or lock-file changes, use $CODEX_ENVCTL refresh to rerun "
            "the exact trusted bootstrap outside the sandbox, $CODEX_ENVCTL test to run the "
            "configured trusted test command, or $CODEX_ENVCTL check to do both. Do not "
            "retry direct nix daemon commands when they are sandbox-blocked. Do not use "
            "sudo, doas, su, "
            "nixos-rebuild, home-manager switch, nix profile, nix-env, systemctl, or any "
            "other host activation or service-management command."
        )
    else:
        base += " Do not create commits; the trusted runner publishes one sanitized result commit."
    if policy == "launch":
        if task_execution_mode(task) == "interactive":
            return base + (
                " One frozen long-running experiment launch is explicitly authorized, but you "
                "must not start it directly with tmux, nohup, systemd, a scheduler, shell "
                "backgrounding, or another detached mechanism. Commit the exact source revision "
                "to run, complete reasonable foreground validation, then create exactly one request using: "
                "\"$CODEX_JOBCTL\" request --name NAME [--gpus 0,1] "
                "[--completion-marker RELATIVE_PATH] [--resume-command TEXT] "
                "[--metadata KEY=VALUE] -- COMMAND ARG... . The trusted runner validates the "
                "request, safety-checks and freezes the committed revision, and launches the "
                "independent job immediately. The frozen job reruns the configured bootstrap and "
                "test commands before its experiment command; this interactive TUI remains open."
            )
        return base + (
            " One frozen long-running experiment launch is explicitly authorized, but you "
            "must not start it directly with tmux, nohup, systemd, a scheduler, shell "
            "backgrounding, or another detached mechanism. Finish the implementation and "
            "foreground validation, then create exactly one request using: "
            "\"$CODEX_JOBCTL\" request --name NAME [--gpus 0,1] "
            "[--completion-marker RELATIVE_PATH] [--resume-command TEXT] "
            "[--metadata KEY=VALUE] -- COMMAND ARG... . After you exit, the trusted runner "
            "publishes the sanitized result, runs the configured tests, freezes that result, "
            "and launches the independent job only when validation succeeds."
        )
    if policy == "prepare":
        return base + (
            " You may prepare exactly one frozen job request with \"$CODEX_JOBCTL\" request, "
            "but it will be recorded rather than launched. Do not start detached work directly."
        )
    return base + (
        " No detached, long-running, scheduled, or background job is authorized for this task. "
        "Do not invoke \"$CODEX_JOBCTL\" or start such work by any other mechanism."
    )


def interactive_tool_cache_dir(task: Mapping[str, Any]) -> Path:
    """Return the task-private writable cache exposed to interactive Codex."""
    state_dir = task.get("state_dir")
    if not isinstance(state_dir, str) or not state_dir:
        raise CodexRemoteError(
            "Interactive Codex task is missing its state directory",
            code="INVALID_TASK_STATE",
        )
    cache = Path(state_dir) / "tool-cache"
    cache.mkdir(parents=True, exist_ok=True, mode=0o700)
    return cache


def nix_develop_prefix_from_command(
    command: str | None, nix: str | None
) -> list[str] | None:
    """Extract a safe ``nix develop ... --command`` prefix from COMMAND."""
    if not command or not nix:
        return None
    try:
        tokens = shlex.split(command)
    except ValueError:
        return None
    if len(tokens) < 2 or Path(tokens[0]).name != "nix" or tokens[1] != "develop":
        return None
    shell_operators = {"&&", "||", ";", "|", "&", ">", ">>", "<"}
    for index, token in enumerate(tokens[2:], start=2):
        if token in shell_operators:
            return None
        if token in {"--command", "-c"}:
            return [nix, *tokens[1 : index + 1]]
    return [nix, *tokens[1:], "--command"]


def nonmutating_nix_develop_prefix(
    prefix: Sequence[str], worktree: Path
) -> list[str]:
    """Prevent trusted environment discovery from mutating ``flake.lock``.

    ``nix develop`` writes a newly generated lock file by default and may update
    an existing one.  Managed Codex startup must be observational: a missing
    lock file may be resolved ephemerally, while an existing committed lock must
    be used as-is.
    """
    value = list(prefix)
    if len(value) < 2 or Path(value[0]).name != "nix" or value[1] != "develop":
        return value
    flags = ["--no-write-lock-file"]
    if (worktree / "flake.lock").is_file():
        flags.insert(0, "--no-update-lock-file")
    existing = set(value[2:])
    guarded = [flag for flag in flags if flag not in existing]
    return [*value[:2], *guarded, *value[2:]]


def nonmutating_nix_develop_command(
    command: str | None, worktree: Path, nix: str | None
) -> str | None:
    """Guard a simple configured ``nix develop`` command against lock writes."""
    if not command or not nix:
        return command
    try:
        tokens = shlex.split(command)
    except ValueError:
        return command
    if len(tokens) < 2 or Path(tokens[0]).name != "nix" or tokens[1] != "develop":
        return command
    shell_operators = {"&&", "||", ";", "|", "&", ">", ">>", "<"}
    if any(token in shell_operators for token in tokens[2:]):
        return command
    tokens[0] = nix
    return shlex.join(nonmutating_nix_develop_prefix(tokens, worktree))


def interactive_nix_develop_candidates(
    task: Mapping[str, Any], worktree: Path
) -> list[list[str]]:
    """Return ordered, non-mutating Nix development-shell candidates."""
    tools = task.get("tools")
    nix = tools.get("nix") if isinstance(tools, Mapping) else None
    if not isinstance(nix, str) or not nix:
        return []
    candidates: list[list[str]] = []
    for configured in (task.get("bootstrap_cmd"), task.get("test_cmd")):
        prefix = nix_develop_prefix_from_command(
            configured if isinstance(configured, str) else None,
            nix,
        )
        if prefix:
            prefix = nonmutating_nix_develop_prefix(prefix, worktree)
        if prefix and prefix not in candidates:
            candidates.append(prefix)
    if (worktree / "flake.nix").is_file():
        for fallback in (
            [nix, "develop", "--command"],
            [nix, "develop", ".#server", "--command"],
        ):
            fallback = nonmutating_nix_develop_prefix(fallback, worktree)
            if fallback not in candidates:
                candidates.append(fallback)
    return candidates


def filtered_dev_environment(value: Mapping[str, str]) -> dict[str, str]:
    """Keep project-toolchain variables while excluding ambient credentials."""
    result: dict[str, str] = {}
    for key, item in value.items():
        upper = key.upper()
        if upper in DEV_ENV_EXCLUDED_NAMES or DEV_ENV_SECRET_NAME_RE.search(upper):
            continue
        if key in DEV_ENV_EXACT_NAMES or key.startswith(DEV_ENV_PREFIXES):
            if isinstance(item, str) and "\x00" not in item:
                result[key] = item
    return result


def interactive_dev_environment_path(task: Mapping[str, Any]) -> Path:
    return Path(task["state_dir"]) / "interactive-dev-environment.json"


def interactive_dev_wrapper_path(task: Mapping[str, Any]) -> Path:
    return Path(task["state_dir"]) / "codex-dev"


def load_interactive_dev_environment(task: Mapping[str, Any]) -> dict[str, str]:
    value = read_json(interactive_dev_environment_path(task))
    if not isinstance(value, dict):
        return {}
    variables = value.get("variables")
    if not isinstance(variables, dict):
        return {}
    return {
        str(key): str(item)
        for key, item in variables.items()
        if isinstance(key, str) and isinstance(item, str) and "\x00" not in item
    }


def write_interactive_dev_wrapper(task: Mapping[str, Any]) -> Path:
    """Create a sandbox-inherited command wrapper for the latest dev environment."""
    wrapper = interactive_dev_wrapper_path(task)
    python = str(task["tools"]["python3"])
    env_path = interactive_dev_environment_path(task)
    worktree = Path(task["worktree"])
    wrapper.write_text(
        f"#!{python}\n"
        "import json\n"
        "import os\n"
        "from pathlib import Path\n"
        "import sys\n\n"
        f"ENV_PATH = Path({str(env_path)!r})\n"
        f"WORKTREE = Path({str(worktree)!r})\n\n"
        "if len(sys.argv) < 2:\n"
        "    print('usage: codex-dev COMMAND [ARG ...]', file=sys.stderr)\n"
        "    raise SystemExit(2)\n"
        "value = json.loads(ENV_PATH.read_text(encoding='utf-8'))\n"
        "variables = value.get('variables', {})\n"
        "env = os.environ.copy()\n"
        "env.update({str(k): str(v) for k, v in variables.items()})\n"
        "venv = WORKTREE / '.venv'\n"
        "env['UV_PROJECT_ENVIRONMENT'] = str(venv)\n"
        "env['PYTHONNOUSERSITE'] = '1'\n"
        "venv_bin = venv / 'bin'\n"
        "if venv_bin.is_dir():\n"
        "    env['VIRTUAL_ENV'] = str(venv)\n"
        "    env['PATH'] = str(venv_bin) + os.pathsep + env.get('PATH', '')\n"
        "os.chdir(WORKTREE)\n"
        "os.execvpe(sys.argv[1], sys.argv[1:], env)\n",
        encoding="utf-8",
    )
    wrapper.chmod(0o700)
    return wrapper


def capture_interactive_dev_environment(
    task: dict[str, Any], worktree: Path, log_path: Path
) -> dict[str, Any]:
    """Resolve a project development environment outside Codex's sandbox.

    Nix daemon access happens here in the trusted runner.  The resulting
    toolchain variables are saved for Codex and for ``$CODEX_DEV``; model-run
    commands remain subject to Codex's workspace sandbox.
    """
    marker = "__CODEX_REMOTE_ENV_JSON__="
    script = (
        "import json, os; "
        f"print({marker!r} + json.dumps(dict(os.environ), sort_keys=True))"
    )
    attempts: list[dict[str, Any]] = []
    selected: list[str] | None = None
    captured: dict[str, str] | None = None
    log_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with log_path.open("a", encoding="utf-8") as log:
        for prefix in interactive_nix_develop_candidates(task, worktree):
            command = [*prefix, task["tools"]["python3"], "-c", script]
            completed = run(command, cwd=worktree, check=False, timeout=1800)
            attempt = {
                "command": shlex.join(command),
                "exit_code": completed.returncode,
            }
            attempts.append(attempt)
            log.write(f"$ {attempt['command']}\n")
            if completed.stderr:
                log.write(completed.stderr)
                if not completed.stderr.endswith("\n"):
                    log.write("\n")
            payload: str | None = None
            for line in completed.stdout.splitlines():
                if line.startswith(marker):
                    payload = line[len(marker) :]
                else:
                    log.write(line + "\n")
            log.flush()
            if completed.returncode != 0 or payload is None:
                continue
            try:
                parsed = json.loads(payload)
            except json.JSONDecodeError:
                continue
            if isinstance(parsed, dict) and isinstance(parsed.get("PATH"), str):
                captured = {
                    str(key): str(item)
                    for key, item in parsed.items()
                    if isinstance(key, str) and isinstance(item, str)
                }
                selected = prefix
                break

    if captured is None:
        captured = dict(os.environ)
        source = "server login environment"
    else:
        source = shlex.join(selected[:-1] if selected else []) or "Nix development shell"

    filtered = filtered_dev_environment(captured)
    if "PATH" not in filtered:
        filtered["PATH"] = os.environ.get("PATH", "")
    record = {
        "captured_at": utc_now(),
        "source": source,
        "nix_prefix": selected,
        "variables": filtered,
        "attempts": attempts,
    }
    path = interactive_dev_environment_path(task)
    atomic_write_json(path, record)
    path.chmod(0o600)
    wrapper = write_interactive_dev_wrapper(task)
    task["interactive_environment"] = source
    task["interactive_nix_prefix"] = selected
    task["interactive_dev_environment_path"] = str(path)
    task["dev_wrapper_path"] = str(wrapper)
    return record


def inferred_interactive_bootstrap(
    task: Mapping[str, Any], worktree: Path
) -> tuple[str | None, bool]:
    """Infer a locked uv bootstrap only when the project omitted one."""
    configured = task.get("bootstrap_cmd")
    if isinstance(configured, str) and configured.strip():
        tools = task.get("tools")
        nix = tools.get("nix") if isinstance(tools, Mapping) else None
        protected = nonmutating_nix_develop_command(
            configured, worktree, nix if isinstance(nix, str) else None
        )
        return protected or configured, False
    if not (worktree / "pyproject.toml").is_file() or not (worktree / "uv.lock").is_file():
        return None, False
    prefix = task.get("interactive_nix_prefix")
    if isinstance(prefix, list) and all(isinstance(item, str) for item in prefix):
        return shlex.join([*prefix, "uv", "sync", "--frozen"]), True
    dev_env = load_interactive_dev_environment(task)
    uv = shutil.which("uv", path=dev_env.get("PATH"))
    if uv:
        return shlex.join([uv, "sync", "--frozen"]), True
    tools = task.get("tools")
    uv = tools.get("uv") if isinstance(tools, Mapping) else None
    if isinstance(uv, str) and uv:
        return shlex.join([uv, "sync", "--frozen"]), True
    raise CodexRemoteError(
        "The project contains pyproject.toml and uv.lock, but neither its Nix "
        "development shell nor the server login PATH provides uv",
        code="INTERACTIVE_ENVIRONMENT_UNAVAILABLE",
    )


def codex_process_environment(task: Mapping[str, Any]) -> dict[str, str]:
    env = os.environ.copy()
    if task_execution_mode(task) == "interactive":
        env.update(load_interactive_dev_environment(task))
    env.update(
        {
            "CODEX_JOB_POLICY": str(task.get("job_policy", "deny")),
            "CODEX_JOBCTL": str(task.get("jobctl_path") or ""),
            "CODEX_JOB_REQUEST_PATH": str(
                Path(task["worktree"]) / JOB_REQUEST_RELATIVE
            ),
            "CODEX_ENVCTL": str(task.get("envctl_path") or ""),
            "CODEX_ENV_REQUEST_PATH": str(
                Path(task["worktree"]) / ENV_REQUEST_RELATIVE
            ),
            "CODEX_DEV": str(task.get("dev_wrapper_path") or ""),
        }
    )
    if task_execution_mode(task) == "interactive":
        cache = interactive_tool_cache_dir(task)
        worktree = Path(task["worktree"])
        venv = worktree / ".venv"
        env.update(
            {
                "XDG_CACHE_HOME": str(cache),
                "UV_CACHE_DIR": str(cache / "uv"),
                "PIP_CACHE_DIR": str(cache / "pip"),
                "UV_PROJECT_ENVIRONMENT": str(venv),
                "PYTHONNOUSERSITE": "1",
                # Give server-created commits a stable, explicit identity without
                # mutating the user's global or repository Git configuration.
                "GIT_AUTHOR_NAME": "Codex Remote",
                "GIT_AUTHOR_EMAIL": "codex-remote@localhost",
                "GIT_COMMITTER_NAME": "Codex Remote",
                "GIT_COMMITTER_EMAIL": "codex-remote@localhost",
            }
        )
        venv_bin = venv / "bin"
        if venv_bin.is_dir():
            env["VIRTUAL_ENV"] = str(venv)
            env["PATH"] = str(venv_bin) + os.pathsep + env.get("PATH", "")
    return env


def cleanup_tmux_session(task: Mapping[str, Any]) -> bool:
    """Remove a retained tmux session for a terminal task.

    Completed runners use ``remain-on-exit`` so their final screen can be
    inspected.  Archive/discard is the boundary where that retained session
    must be removed.  Treat an already-absent session as a successful no-op,
    but fail cleanup if tmux still reports it after a kill request.
    """
    tmux = task.get("tools", {}).get("tmux") or login_which("tmux")
    session = task.get("tmux_session")
    if not tmux or not isinstance(session, str) or not session:
        return False

    present = run([tmux, "has-session", "-t", session], check=False)
    if present.returncode != 0:
        return False

    killed = run([tmux, "kill-session", "-t", session], check=False)
    remaining = run([tmux, "has-session", "-t", session], check=False)
    if remaining.returncode == 0:
        raise CommandError(
            [tmux, "kill-session", "-t", session],
            killed.returncode,
            killed.stdout or "",
            killed.stderr or "tmux session still exists after cleanup",
        )
    return True


def cleanup_server_task_artifacts(
    paths: Mapping[str, Path], task: dict[str, Any], action: str
) -> dict[str, Any]:
    if action not in {"archive", "discard"}:
        raise CodexRemoteError(f"Unknown clean action: {action}", code="INVALID_ACTION")
    if cleanup_tmux_session(task):
        task["tmux_cleaned_at"] = utc_now()
    worktree_value = task.get("worktree")
    if worktree_value:
        worktree = Path(worktree_value)
        if worktree.exists():
            removed = run(
                ["git", "--git-dir", paths["broker"], "worktree", "remove", "--force", str(worktree)],
                check=False,
            )
            if removed.returncode != 0 and worktree.exists():
                raise CommandError(
                    ["git", "--git-dir", str(paths["broker"]), "worktree", "remove", "--force", str(worktree)],
                    removed.returncode,
                    removed.stdout,
                    removed.stderr,
                )
    run(["git", "--git-dir", paths["broker"], "worktree", "prune"], check=False)
    state_dir_value = task.get("state_dir")
    if isinstance(state_dir_value, str) and state_dir_value:
        tool_cache = Path(state_dir_value) / "tool-cache"
        if tool_cache.exists():
            shutil.rmtree(tool_cache)
            task["tool_cache_cleaned_at"] = utc_now()
    refs_to_remove: set[str] = set()
    for key in ("input_ref", "result_ref"):
        ref = task.get(key)
        if isinstance(ref, str) and ref.startswith("refs/codex/"):
            refs_to_remove.add(ref)
    if task_execution_mode(task) == "interactive":
        refs_to_remove.add(checkpoint_ref_name(task))
    for ref in refs_to_remove:
        run(["git", "--git-dir", paths["broker"], "update-ref", "-d", ref], check=False)
    task["state"] = "ARCHIVED" if action == "archive" else "DISCARDED"
    task[f"{action}ed_at"] = utc_now()
    return save_server_task(paths, task)


def server_start(project_id: str, task_id_value: str, payload: dict[str, Any]) -> dict[str, Any]:
    validate_safe_id(project_id, "project id")
    validate_safe_id(task_id_value, "task id")
    if payload.get("project_id") != project_id or payload.get("task_id") != task_id_value:
        raise CodexRemoteError("Task identity mismatch", code="TASK_ID_MISMATCH")
    validate_codex_configuration(payload)
    links = data_link_specs(payload)
    execution_mode = payload.get("execution_mode", "exec")
    prompt = payload.get("prompt")
    if execution_mode == "exec":
        if not isinstance(prompt, str) or not prompt.strip():
            raise CodexRemoteError("Submitted prompt is empty or invalid", code="EMPTY_PROMPT")
        expected_prompt_hash = hashlib.sha256(prompt.encode("utf-8")).hexdigest()
        if payload.get("prompt_sha256") != expected_prompt_hash:
            raise CodexRemoteError(
                "Prompt hash does not match submitted prompt", code="PAYLOAD_HASH_MISMATCH"
            )
    elif prompt is not None or payload.get("prompt_sha256") is not None:
        raise CodexRemoteError(
            "Interactive tasks must not include a startup prompt",
            code="INVALID_EXECUTION_MODE",
        )
    paths = ensure_server_layout(project_id)
    existing_same = load_server_task(paths, task_id_value)
    if existing_same:
        return {"ok": True, "task": existing_same, "idempotent": True}

    lock_handle = paths["lock"].open("a+")
    try:
        try:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            current = load_server_task(paths)
            raise CodexRemoteError(
                "Another Codex writer currently holds the project lock",
                code="PROJECT_LOCKED",
                details=current,
            ) from exc
        current = load_server_task(paths)
        if current and current.get("state") in {"IMPORTED", "DISCARDED", "ARCHIVED"}:
            # Resolved tasks retain logs and metadata, but no live tmux session,
            # worktree, or hidden refs should survive into the next task.  This
            # also repairs terminal tasks cleaned by older helper versions that
            # forgot to remove their remain-on-exit tmux session.
            cleanup_action = (
                "discard" if current.get("state") == "DISCARDED" else "archive"
            )
            cleanup_server_task_artifacts(paths, current, cleanup_action)
            current = load_server_task(paths)
        if task_outstanding(current):
            raise CodexRemoteError(
                f"Project already has outstanding task {current.get('task_id')} in state {current.get('state')}",
                code="OUTSTANDING_TASK",
                details=current,
            )

        input_ref = payload["input_ref"]
        input_sha = payload["input_sha"]
        expected_input_ref = f"refs/codex/{project_id}/input/{task_id_value}"
        if input_ref != expected_input_ref:
            raise CodexRemoteError("Input ref does not match the task identity", code="REF_MISMATCH")
        resolved = run(["git", "--git-dir", paths["broker"], "rev-parse", input_ref]).stdout.strip()
        if resolved != input_sha:
            raise CodexRemoteError("Input ref does not match the submitted SHA", code="REF_MISMATCH")

        tools = {name: login_which(name) for name in ("bash", "git", "tmux", "flock", "codex")}
        tools["python3"] = str(Path(sys.executable).resolve())
        missing = [name for name, path in tools.items() if not path]
        if missing:
            raise CodexRemoteError(
                "Remote prerequisites missing: " + ", ".join(missing),
                code="REMOTE_PREREQUISITES_MISSING",
            )
        # Optional project-environment tools.  They are not universal remote
        # prerequisites, but allow the trusted runner to prepare checked-in
        # Nix/uv environments before the sandboxed Codex process starts.
        tools["nix"] = login_which("nix")
        tools["uv"] = login_which("uv")
        auth = command_version(tools["codex"], "login", "status")
        if not auth["ok"]:
            raise CodexRemoteError(
                "Remote Codex is not authenticated; run `codex login --device-auth` on the server",
                code="REMOTE_CODEX_NOT_AUTHENTICATED",
            )
        usage = shutil.disk_usage(paths["share"])
        if usage.free < 512 * 1024 * 1024:
            raise CodexRemoteError(
                f"Remote Codex storage has only {usage.free} bytes free", code="REMOTE_DISK_LOW"
            )

        state_dir = paths["project_state"] / task_id_value
        state_dir.mkdir(parents=True, exist_ok=False, mode=0o700)
        prompt_path: Path | None = None
        if execution_mode == "exec":
            prompt_path = state_dir / "prompt.txt"
            prompt_path.write_text(prompt, encoding="utf-8")
            prompt_path.chmod(0o600)
        runner_helper = state_dir / "codex-remote-runner.py"
        runner_helper.write_bytes(Path(__file__).resolve().read_bytes())
        runner_helper.chmod(0o700)
        worktree = paths["worktrees"] / task_id_value
        worktree.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        jobctl_path = state_dir / "codex-jobctl"
        envctl_path = state_dir / "codex-envctl"
        request_path = worktree / JOB_REQUEST_RELATIVE
        response_path = worktree / JOB_RESPONSE_RELATIVE
        env_request_path = worktree / ENV_REQUEST_RELATIVE
        env_response_path = worktree / ENV_RESPONSE_RELATIVE
        jobctl_command = (
            f"exec {shlex.quote(str(Path(sys.executable).resolve()))} "
            f"{shlex.quote(str(runner_helper))} _job-request "
            f"--request-file {shlex.quote(str(request_path))} "
        )
        if execution_mode == "interactive":
            # The live broker consumes the request while Codex remains open and
            # writes a response that the helper can report to the TUI.  One-shot
            # tasks have no live broker: they must return immediately after
            # writing the request so the enclosing runner can finalize and
            # launch it after Codex exits.
            jobctl_command += (
                f"--response-file {shlex.quote(str(response_path))} "
                f"--wait-seconds 900 "
            )
        jobctl_path.write_text(
            "#!/bin/sh\n"
            "set -eu\n"
            "if [ \"${1:-}\" != request ]; then\n"
            "  echo 'usage: codex-jobctl request --name NAME [options] -- COMMAND ARG...' >&2\n"
            "  exit 2\n"
            "fi\n"
            "shift\n"
            + jobctl_command
            + '"$@"\n',
            encoding="utf-8",
        )
        jobctl_path.chmod(0o700)

        envctl_path.write_text(
            "#!/bin/sh\n"
            "set -eu\n"
            "case \"${1:-}\" in\n"
            "  refresh|test|check) action=$1 ;;\n"
            "  *) echo 'usage: codex-envctl {refresh|test|check}' >&2; exit 2 ;;\n"
            "esac\n"
            f"exec {shlex.quote(str(Path(sys.executable).resolve()))} "
            f"{shlex.quote(str(runner_helper))} _env-request "
            f"--request-file {shlex.quote(str(env_request_path))} "
            f"--response-file {shlex.quote(str(env_response_path))} "
            "--wait-seconds 1800 --action \"$action\"\n",
            encoding="utf-8",
        )
        envctl_path.chmod(0o700)

        session_prefix = "codexi" if execution_mode == "interactive" else "codex"
        session = f"{session_prefix}-{project_id[-12:]}-{task_id_value[-8:]}"
        task = {
            "schema_version": SCHEMA_VERSION,
            "project_id": project_id,
            "project_name": payload.get("project_name"),
            "task_id": task_id_value,
            "state": "STARTING",
            "execution_mode": execution_mode,
            "created_at": payload.get("created_at") or utc_now(),
            "input_ref": input_ref,
            "input_sha": input_sha,
            "input_tree": payload.get("input_tree"),
            "input_index_tree": payload.get("input_index_tree"),
            "local_head": payload.get("local_head"),
            "local_branch": payload.get("local_branch"),
            "normal_remote_dir": payload.get("normal_remote_dir"),
            "broker": str(paths["broker"]),
            "worktree": str(worktree),
            "state_dir": str(state_dir),
            "prompt_path": str(prompt_path) if prompt_path else None,
            "prompt_sha256": payload.get("prompt_sha256"),
            "runner_helper": str(runner_helper),
            "runner_helper_sha256": sha256_file(runner_helper),
            "jobctl_path": str(jobctl_path),
            "envctl_path": str(envctl_path),
            "tmux_session": session,
            "lock_path": str(paths["lock"]),
            "bootstrap_cmd": payload.get("bootstrap_cmd"),
            "test_cmd": payload.get("test_cmd"),
            "data_links": links,
            "max_untracked_bytes": int(payload.get("max_untracked_bytes") or DEFAULT_MAX_UNTRACKED_BYTES),
            "model": payload.get("model")
            or (DEFAULT_INTERACTIVE_MODEL if execution_mode == "interactive" else None),
            "profile": payload.get("profile"),
            # Managed interactive sessions are deliberately pinned to Extra High.
            # Project-local `high` settings remain available to one-shot tasks, but
            # must not silently reduce the autonomous SPC r c i workflow.
            "reasoning_effort": (
                DEFAULT_INTERACTIVE_REASONING
                if execution_mode == "interactive"
                else payload.get("reasoning_effort")
            ),
            "approval_policy": (
                DEFAULT_INTERACTIVE_APPROVAL_POLICY
                if execution_mode == "interactive"
                else "never"
            ),
            "network_access": execution_mode == "interactive",
            "enable_search": bool(payload.get("enable_search")),
            "job_policy": payload.get("job_policy", "deny"),
            "lock_hashes": payload.get("lock_hashes") or {},
            "tools": tools,
        }
        task = save_server_task(paths, task)
        env = os.environ.copy()
        env["GIT_LFS_SKIP_SMUDGE"] = "1"
        run(
            ["git", "--git-dir", paths["broker"], "worktree", "add", "--detach", str(worktree), input_sha],
            env=env,
        )
        task["worktree_created_at"] = utc_now()
        task = save_server_task(paths, task)
        runner_argv = [
            tools["flock"],
            "-w",
            "10",
            str(paths["lock"]),
            tools["python3"],
            str(runner_helper),
            "_server-run",
            "--project-id",
            project_id,
            "--task-id",
            task_id_value,
        ]
        # The SSH helper itself uses absolute tool paths, but Codex-generated
        # commands need the server user's normal login environment (notably
        # Nix profile and uv paths).  Start the durable runner under bash -lc.
        command = shlex.join(
            [tools["bash"], "-lc", "exec " + shlex.join(runner_argv)]
        )
        task["runner_command"] = command
        task = save_server_task(paths, task)
        run([tools["tmux"], "new-session", "-d", "-s", session, command])
        run([tools["tmux"], "set-option", "-t", session, "remain-on-exit", "on"])
        return {"ok": True, "task": task, "idempotent": False}
    except Exception:
        # Preserve any created state/worktree.  If metadata exists, classify it.
        state_path = task_state_path(paths, task_id_value)
        task = read_json(state_path)
        if task and task.get("state") == "STARTING":
            task["state"] = "ORPHANED"
            task["error"] = "Submission failed after creating server state"
            save_server_task(paths, task)
        raise
    finally:
        with contextlib.suppress(OSError):
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)
        lock_handle.close()


def data_link_target_path(
    worktree: Path,
    relative: str,
    *,
    create_parents: bool,
) -> Path:
    """Resolve a data-link target without following worktree symlink parents."""
    target_parts = PurePosixPath(relative).parts
    if not target_parts:
        raise CodexRemoteError("Data-link target is empty", code="INVALID_DATA_LINK")
    parent = worktree
    for part in target_parts[:-1]:
        parent = parent / part
        if parent.is_symlink():
            raise CodexRemoteError(
                f"Data-link parent is a symlink and could escape the worktree: {parent}",
                code="DATA_LINK_TAMPERED",
            )
        if parent.exists():
            if not parent.is_dir():
                raise CodexRemoteError(
                    f"Data-link parent is not a directory: {parent}",
                    code="DATA_LINK_COLLISION",
                )
        elif create_parents:
            parent.mkdir(mode=0o700)
        else:
            raise CodexRemoteError(
                f"Data-link parent disappeared: {parent}",
                code="DATA_LINK_TAMPERED",
            )
    return parent / target_parts[-1]


def create_data_links(task: Mapping[str, Any]) -> list[Path]:
    worktree = Path(task["worktree"])
    created: list[Path] = []
    try:
        for item in task.get("data_links") or []:
            source = Path(item["source"])
            target = data_link_target_path(
                worktree,
                item["target"],
                create_parents=True,
            )
            if target.exists() or target.is_symlink():
                raise CodexRemoteError(
                    f"Data-link target already exists: {target}",
                    code="DATA_LINK_COLLISION",
                )
            target.symlink_to(source, target_is_directory=source.is_dir())
            created.append(target)
    except Exception:
        # Link creation is all-or-nothing.  A later collision must not leave
        # earlier datasets exposed in a worktree whose task never started.
        for target in reversed(created):
            with contextlib.suppress(OSError):
                target.unlink()
            parent = target.parent
            while parent != worktree:
                try:
                    parent.rmdir()
                except OSError:
                    break
                parent = parent.parent
        raise
    return created


def remove_data_links(task: Mapping[str, Any]) -> None:
    worktree = Path(task["worktree"])
    for item in task.get("data_links") or []:
        source = Path(item["source"])
        target = data_link_target_path(
            worktree,
            item["target"],
            create_parents=False,
        )
        if not target.is_symlink():
            raise CodexRemoteError(
                f"Configured data link was replaced or removed: {target}", code="DATA_LINK_TAMPERED"
            )
        actual = Path(os.readlink(target))
        if actual != source:
            raise CodexRemoteError(
                f"Configured data link target changed: {target} -> {actual}", code="DATA_LINK_TAMPERED"
            )
        target.unlink()
        # Remove newly-created empty parent directories, stopping at worktree.
        parent = target.parent
        while parent != worktree:
            try:
                parent.rmdir()
            except OSError:
                break
            parent = parent.parent


def tracked_status_porcelain(root: Path) -> str:
    """Return staged/unstaged tracked status without reporting untracked paths."""
    return git(root, "status", "--porcelain=v1", "--untracked-files=no").stdout


def git_status_porcelain(root: Path) -> str:
    return git(root, "status", "--porcelain=v1", "--untracked-files=all").stdout


def terminate_child_process(
    process: subprocess.Popen[Any], *, process_group: bool = True
) -> None:
    """Terminate PROCESS, including its process group when one was created."""
    if process.poll() is not None:
        return
    if process_group:
        try:
            os.killpg(process.pid, signal.SIGTERM)
            return
        except (OSError, ProcessLookupError):
            pass
    with contextlib.suppress(ProcessLookupError):
        process.terminate()


@contextlib.contextmanager
def foreground_child_process_group(process: subprocess.Popen[Any]):
    """Give PROCESS's group the tmux pane while preserving the runner parent.

    An interactive Codex TUI must receive terminal signals such as Ctrl-C
    without also signalling the Python finalizer.  The child is launched in a
    separate process group, then made foreground for the duration of the TUI.
    Non-TTY test and recovery environments safely skip the handoff.
    """
    try:
        terminal_fd = sys.stdin.fileno()
    except (AttributeError, OSError, ValueError):
        yield
        return
    if not os.isatty(terminal_fd):
        yield
        return

    runner_group = os.tcgetpgrp(terminal_fd)
    previous_ttou = signal.getsignal(signal.SIGTTOU)
    signal.signal(signal.SIGTTOU, signal.SIG_IGN)
    handed_off = False
    try:
        try:
            os.tcsetpgrp(terminal_fd, process.pid)
            handed_off = True
        except OSError:
            # A CLI argument/startup error may terminate the child before the
            # runner can hand over the pane.  In that case there is nothing
            # left to foreground; otherwise surface the terminal failure.
            if process.poll() is None:
                raise
        yield
    finally:
        if handed_off:
            with contextlib.suppress(OSError):
                os.tcsetpgrp(terminal_fd, runner_group)
        signal.signal(signal.SIGTTOU, previous_ttou)


def run_shell_logged(
    shell: str,
    command: str,
    cwd: Path,
    log_path: Path,
    active: dict[str, Any],
    *,
    env: Mapping[str, str] | None = None,
    login_shell: bool = True,
) -> int:
    log_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with log_path.open("a", encoding="utf-8") as log:
        process = subprocess.Popen(
            [shell, "-lc" if login_shell else "-c", command],
            cwd=cwd,
            env=dict(env) if env is not None else None,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            start_new_session=True,
        )
        active["process"] = process
        active["process_group"] = True
        assert process.stdout is not None
        for line in process.stdout:
            log.write(line)
            log.flush()
            print(line, end="", flush=True)
        process.stdout.close()
        return process.wait()


def run_shell_quiet_logged(
    shell: str,
    command: str,
    cwd: Path,
    log_path: Path,
    *,
    timeout: int = 1800,
    env: Mapping[str, str] | None = None,
    login_shell: bool = True,
) -> int:
    """Run a trusted shell command without writing over an active Codex TUI."""
    log_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with log_path.open("a", encoding="utf-8") as log:
        log.write(f"{utc_now()} $ {command}\n")
        log.flush()
        try:
            completed = subprocess.run(
                [shell, "-lc" if login_shell else "-c", command],
                cwd=cwd,
                env=dict(env) if env is not None else None,
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=subprocess.STDOUT,
                timeout=timeout,
                check=False,
                text=True,
            )
        except subprocess.TimeoutExpired:
            log.write(f"{utc_now()} timed out after {timeout} seconds\n")
            log.flush()
            return 124
        log.write(f"{utc_now()} exit {completed.returncode}\n")
        log.flush()
        return completed.returncode


def tee_stream(stream: Any, destination: Any, prefix: str = "") -> None:
    for line in iter(stream.readline, ""):
        destination.write(line)
        destination.flush()
        print(prefix + line, end="", flush=True)
    stream.close()


def commit_dirty_result(task: dict[str, Any], paths: Mapping[str, Path]) -> tuple[str, bool]:
    worktree = Path(task["worktree"])
    input_sha = task["input_sha"]
    head = current_head(worktree)
    if git(worktree, "merge-base", "--is-ancestor", input_sha, head, check=False).returncode != 0:
        raise CodexRemoteError("Codex rewrote history outside the input snapshot", code="INVALID_RESULT_HISTORY")
    git(worktree, "diff", "--check", "HEAD", "--")
    ensure_safe_untracked(worktree, int(task["max_untracked_bytes"]))
    dirty = bool(git_status_porcelain(worktree).strip())
    if dirty:
        git(worktree, "add", "-A", "--", ".")
        staged_check = git(worktree, "diff", "--cached", "--check", check=False)
        if staged_check.returncode != 0:
            raise CodexRemoteError(
                "Codex result failed `git diff --cached --check`:\n"
                + (staged_check.stdout or staged_check.stderr),
                code="RESULT_DIFF_CHECK_FAILED",
            )
        staged = git(worktree, "diff", "--cached", "--quiet", check=False)
        if staged.returncode != 0:
            env = os.environ.copy()
            env.setdefault("GIT_AUTHOR_NAME", "Codex Remote")
            env.setdefault("GIT_AUTHOR_EMAIL", "codex-remote@localhost")
            env.setdefault("GIT_COMMITTER_NAME", "Codex Remote")
            env.setdefault("GIT_COMMITTER_EMAIL", "codex-remote@localhost")
            git(worktree, "commit", "-m", f"Codex remote result {task['task_id']}", env=env)
    codex_head = current_head(worktree)
    if git(worktree, "merge-base", "--is-ancestor", input_sha, codex_head, check=False).returncode != 0:
        raise CodexRemoteError("Final result is not descended from input", code="INVALID_RESULT_HISTORY")
    result_check = git(worktree, "diff", "--check", input_sha, codex_head, "--", check=False)
    if result_check.returncode != 0:
        raise CodexRemoteError(
            "Committed Codex result failed `git diff --check`:\n"
            + (result_check.stdout or result_check.stderr),
            code="RESULT_DIFF_CHECK_FAILED",
        )
    ensure_safe_result_delta(worktree, input_sha, codex_head, int(task["max_untracked_bytes"]))

    checkpoint = load_task_checkpoint(task) if task_execution_mode(task) == "interactive" else None
    if checkpoint:
        published_sha = str(checkpoint.get("sha") or "")
        if published_sha and git(
            worktree,
            "merge-base",
            "--is-ancestor",
            published_sha,
            codex_head,
            check=False,
        ).returncode != 0:
            raise CodexRemoteError(
                "Interactive Codex rewrote commits that were already pulled from a live checkpoint",
                code="CHECKPOINT_HISTORY_REWRITTEN",
                details={"published_sha": published_sha, "current_head": codex_head},
            )

    input_tree = git(worktree, "rev-parse", f"{input_sha}^{{tree}}").stdout.strip()
    result_tree = git(worktree, "rev-parse", f"{codex_head}^{{tree}}").stdout.strip()
    has_changes = result_tree != input_tree
    if task_execution_mode(task) == "interactive":
        # Interactive sessions are expected to create small coherent commits.
        # The safety scan above checks every committed state, so the original
        # chain can be published without sacrificing the secret/generated-file
        # protections used by one-shot tasks.
        result = codex_head if has_changes else input_sha
    elif has_changes:
        # One-shot tasks retain the historical behavior: publish one sanitized
        # commit so internal scratch commits never become user-facing history.
        env = os.environ.copy()
        env.setdefault("GIT_AUTHOR_NAME", "Codex Remote")
        env.setdefault("GIT_AUTHOR_EMAIL", "codex-remote@localhost")
        env.setdefault("GIT_COMMITTER_NAME", "Codex Remote")
        env.setdefault("GIT_COMMITTER_EMAIL", "codex-remote@localhost")
        result = git(
            worktree,
            "commit-tree",
            result_tree,
            "-p",
            input_sha,
            env=env,
            input_data=f"Codex remote result {task['task_id']}\n",
        ).stdout.strip()
    else:
        result = input_sha
    result_ref = f"refs/codex/{task['project_id']}/result/{task['task_id']}"
    run(["git", "--git-dir", paths["broker"], "update-ref", result_ref, result])
    task["codex_head_sha"] = codex_head
    task["result_squashed"] = task_execution_mode(task) != "interactive" and codex_head != result
    task["result_preserves_commits"] = task_execution_mode(task) == "interactive"
    task["result_ref"] = result_ref
    task["result_sha"] = result
    if task_execution_mode(task) == "interactive":
        # Keep the live checkpoint ref at the final result as well, allowing a
        # final pull to reuse the same incremental path.
        publish_task_checkpoint(paths, task)
    return result, has_changes


def codex_command(task: Mapping[str, Any]) -> list[str]:
    codex = task["tools"]["codex"]
    final_message = str(Path(task["state_dir"]) / "final-message.txt")
    # In Codex CLI 0.147+, --ask-for-approval is a global option.  Placing it
    # after the `exec` subcommand causes clap to reject the invocation before
    # Codex starts.  Keep global options before `exec`; exec-specific options
    # follow the subcommand.
    command = [
        codex,
        "--ask-for-approval",
        "never",
    ]
    if task.get("enable_search"):
        command.append("--search")
    command.extend([
        "exec",
        "--json",
        "--sandbox",
        "workspace-write",
        "--output-last-message",
        final_message,
    ])
    if task.get("model"):
        command.extend(["--model", task["model"]])
    if task.get("profile"):
        command.extend(["--profile", task["profile"]])
    if task.get("reasoning_effort"):
        command.extend(["--config", f"model_reasoning_effort={task['reasoning_effort']}"])
    command.extend(
        [
            "--config",
            "developer_instructions=" + json.dumps(codex_job_instructions(task)),
        ]
    )
    command.append("-")
    return command


def interactive_codex_command(task: Mapping[str, Any]) -> list[str]:
    """Build an autonomous but workspace-confined interactive Codex TUI command."""
    cache = interactive_tool_cache_dir(task)
    command = [
        task["tools"]["codex"],
        "--sandbox",
        "workspace-write",
        "--ask-for-approval",
        str(task.get("approval_policy") or DEFAULT_INTERACTIVE_APPROVAL_POLICY),
        "--add-dir",
        str(cache),
    ]
    if task.get("network_access"):
        command.extend(
            [
                "--config",
                "sandbox_workspace_write.network_access=true",
                "--config",
                "features.network_proxy.enabled=true",
                "--config",
                'features.network_proxy.domains={ "*" = "allow" }',
            ]
        )
    if task.get("enable_search"):
        command.append("--search")
    if task.get("profile"):
        command.extend(["--profile", task["profile"]])
    command.extend(
        [
            "--model",
            str(task.get("model") or DEFAULT_INTERACTIVE_MODEL),
            "--config",
            "model_reasoning_effort="
            + json.dumps(
                str(task.get("reasoning_effort") or DEFAULT_INTERACTIVE_REASONING)
            ),
            "--config",
            "developer_instructions=" + json.dumps(codex_job_instructions(task)),
        ]
    )
    return command


def parse_codex_event(task: dict[str, Any], line: str, paths: Mapping[str, Path]) -> None:
    try:
        event = json.loads(line)
    except json.JSONDecodeError:
        return
    if event.get("type") == "thread.started" and event.get("thread_id"):
        task["codex_thread_id"] = event["thread_id"]
        save_server_task(paths, task)


def linux_boot_id() -> str | None:
    path = Path("/proc/sys/kernel/random/boot_id")
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return None


def process_start_ticks(pid: int) -> int | None:
    """Return Linux /proc start ticks for PID, or None off Linux."""
    try:
        # The comm field may contain spaces and parentheses.  Everything after
        # the final ') ' starts at proc stat field 3; starttime is field 22.
        value = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
        rest = value.rsplit(") ", 1)[1].split()
        return int(rest[19])
    except (OSError, IndexError, ValueError):
        return None


def interactive_job_request_watcher(
    project_id: str,
    task_id_value: str,
    stop_event: threading.Event,
) -> None:
    """Broker trusted environment and job requests while the TUI is active."""
    paths = ensure_server_layout(project_id)
    while not stop_event.is_set():
        task = load_server_task(paths, task_id_value)
        if not task:
            return
        env_request_path = Path(task["worktree"]) / ENV_REQUEST_RELATIVE
        env_response_path = Path(task["worktree"]) / ENV_RESPONSE_RELATIVE
        if env_request_path.exists() or env_request_path.is_symlink():
            try:
                request = consume_env_request(task)
                if request is None:
                    time.sleep(0.1)
                    continue
                response = server_interactive_env_action(
                    project_id, task_id_value, request
                )
            except CodexRemoteError as exc:
                response = {
                    "ok": False,
                    "error": str(exc),
                    "error_code": exc.code,
                    "details": exc.details,
                }
            except Exception as exc:  # defensive broker boundary
                response = {
                    "ok": False,
                    "error": str(exc),
                    "error_code": "UNEXPECTED_ENV_BROKER_ERROR",
                    "details": traceback.format_exc(),
                }
            atomic_write_json(env_response_path, response)
            continue
        request_path = Path(task["worktree"]) / JOB_REQUEST_RELATIVE
        response_path = Path(task["worktree"]) / JOB_RESPONSE_RELATIVE
        if request_path.exists() or request_path.is_symlink():
            try:
                request = consume_job_request(task)
                if request is None:
                    time.sleep(0.1)
                    continue
                response = server_request_job(project_id, task_id_value, request)
            except CodexRemoteError as exc:
                response = {
                    "ok": False,
                    "error": str(exc),
                    "error_code": exc.code,
                    "details": exc.details,
                }
            except Exception as exc:  # defensive broker boundary
                response = {
                    "ok": False,
                    "error": str(exc),
                    "error_code": "UNEXPECTED_JOB_BROKER_ERROR",
                    "details": traceback.format_exc(),
                }
            atomic_write_json(response_path, response)
            continue
        time.sleep(0.2)


def server_interactive_env_action(
    project_id: str,
    task_id_value: str,
    request: Mapping[str, Any],
) -> dict[str, Any]:
    """Run a frozen, user-configured environment action outside the sandbox."""
    paths = ensure_server_layout(project_id)
    task = load_server_task(paths, task_id_value)
    if not task:
        raise CodexRemoteError("Task state not found", code="TASK_NOT_FOUND")
    if task_execution_mode(task) != "interactive" or task.get("state") != "RUNNING":
        raise CodexRemoteError(
            "Environment control is available only while an interactive task is running",
            code="ENV_CONTROL_NOT_RUNNING",
        )
    action = normalized_env_request(request)["action"]
    worktree = Path(task["worktree"])
    tracked = tracked_status_porcelain(worktree)
    if tracked.strip():
        raise CodexRemoteError(
            "Commit the current tracked work before requesting a trusted environment refresh or test",
            code="ENV_REQUIRES_COMMITTED_CHECKPOINT",
            details={"status": tracked},
        )

    state_dir = Path(task["state_dir"])
    result: dict[str, Any] = {
        "ok": True,
        "action": action,
        "started_at": utc_now(),
    }
    if action in {"refresh", "check"}:
        bootstrap = task.get("bootstrap_cmd")
        if not isinstance(bootstrap, str) or not bootstrap.strip():
            raise CodexRemoteError(
                "No trusted bootstrap command is configured or inferable for this task",
                code="ENV_REFRESH_NOT_CONFIGURED",
            )
        tools = task.get("tools")
        nix = tools.get("nix") if isinstance(tools, Mapping) else None
        bootstrap = nonmutating_nix_develop_command(
            bootstrap, worktree, nix if isinstance(nix, str) else None
        ) or bootstrap
        refresh_log = state_dir / "interactive-environment-refresh.log"
        rc = run_shell_quiet_logged(
            task["tools"]["bash"],
            bootstrap,
            worktree,
            refresh_log,
            env=codex_process_environment(task),
            login_shell=False,
        )
        result["refresh"] = {
            "command": bootstrap,
            "exit_code": rc,
            "log": str(refresh_log),
        }
        if rc != 0:
            raise CodexRemoteError(
                f"Trusted environment refresh exited {rc}",
                code="ENV_REFRESH_FAILED",
                details=result,
            )
        dirty = tracked_status_porcelain(worktree)
        if dirty.strip():
            raise CodexRemoteError(
                "The trusted environment refresh changed tracked source files; inspect and commit them before retrying",
                code="ENV_REFRESH_DIRTY",
                details={**result, "status": dirty},
            )
        record = capture_interactive_dev_environment(
            task, worktree, state_dir / "interactive-environment-probe.log"
        )
        result["refresh"]["environment"] = record.get("source")

    if action in {"test", "check"}:
        test_command = task.get("test_cmd")
        if not isinstance(test_command, str) or not test_command.strip():
            raise CodexRemoteError(
                "No trusted test command is configured for this task",
                code="ENV_TEST_NOT_CONFIGURED",
                details=result,
            )
        tools = task.get("tools")
        nix = tools.get("nix") if isinstance(tools, Mapping) else None
        test_command = nonmutating_nix_develop_command(
            test_command, worktree, nix if isinstance(nix, str) else None
        ) or test_command
        test_log = state_dir / "interactive-trusted-tests.log"
        rc = run_shell_quiet_logged(
            task["tools"]["bash"],
            test_command,
            worktree,
            test_log,
            env=codex_process_environment(task),
            login_shell=False,
        )
        result["test"] = {
            "command": test_command,
            "exit_code": rc,
            "log": str(test_log),
        }
        dirty = tracked_status_porcelain(worktree)
        if dirty.strip():
            raise CodexRemoteError(
                "The trusted test command changed tracked source files",
                code="ENV_TEST_DIRTY",
                details={**result, "status": dirty},
            )
        if rc != 0:
            raise CodexRemoteError(
                f"Trusted test command exited {rc}",
                code="ENV_TEST_FAILED",
                details=result,
            )

    result["finished_at"] = utc_now()
    task["last_interactive_environment_action"] = result
    save_server_task(paths, task)
    return result


def server_run(project_id: str, task_id_value: str) -> int:
    paths = ensure_server_layout(project_id)
    task = load_server_task(paths, task_id_value)
    if not task:
        raise CodexRemoteError("Task state not found", code="TASK_NOT_FOUND")
    state_dir = Path(task["state_dir"])
    runner_log = state_dir / "runner.log"
    active: dict[str, Any] = {
        "process": None,
        "process_group": False,
        "cancelled": False,
    }

    def handle_signal(signum: int, _frame: Any) -> None:
        active["cancelled"] = True
        process = active.get("process")
        if process is not None and process.poll() is None:
            terminate_child_process(
                process,
                process_group=bool(active.get("process_group")),
            )
        task["cancel_requested"] = True
        task["state"] = "CANCEL_REQUESTED"
        save_server_task(paths, task)
        with runner_log.open("a", encoding="utf-8") as log:
            log.write(f"{utc_now()} received signal {signum}\n")

    signal.signal(signal.SIGTERM, handle_signal)
    signal.signal(signal.SIGINT, handle_signal)

    def note(message: str) -> None:
        line = f"{utc_now()} {message}\n"
        with runner_log.open("a", encoding="utf-8") as log:
            log.write(line)
        print(line, end="", flush=True)

    def finish_cancelled_noop(stage: str) -> bool:
        """Finalize cancellation before Codex has produced a result."""
        latest = load_server_task(paths, task_id_value)
        if latest and latest.get("cancel_requested"):
            task["cancel_requested"] = True
        if not (active["cancelled"] or task.get("cancel_requested")):
            return False
        task["cancel_requested"] = True
        task["state"] = "CANCELLED_NOOP"
        task["finished_at"] = utc_now()
        save_server_task(paths, task)
        note(f"task was cancelled {stage}")
        return True

    try:
        task["runner_pid"] = os.getpid()
        task["server_boot_id"] = linux_boot_id()
        task["runner_start_ticks"] = process_start_ticks(os.getpid())
        if finish_cancelled_noop("before the runner started"):
            return 0
        task["state"] = "BOOTSTRAPPING"
        save_server_task(paths, task)
        note("runner started")
        worktree = Path(task["worktree"])
        if current_head(worktree) != task["input_sha"]:
            raise CodexRemoteError("Worktree no longer points at the input snapshot", code="WORKTREE_MISMATCH")

        bootstrap = task.get("bootstrap_cmd")
        if task_execution_mode(task) == "interactive":
            capture_interactive_dev_environment(
                task,
                worktree,
                state_dir / "interactive-environment-probe.log",
            )
            bootstrap, inferred = inferred_interactive_bootstrap(task, worktree)
            task["bootstrap_cmd"] = bootstrap
            task["bootstrap_inferred"] = inferred
            save_server_task(paths, task)
        if bootstrap:
            note(f"running bootstrap command: {bootstrap}")
            interactive = task_execution_mode(task) == "interactive"
            rc = run_shell_logged(
                task["tools"]["bash"],
                bootstrap,
                worktree,
                state_dir / "bootstrap.log",
                active,
                env=codex_process_environment(task) if interactive else None,
                login_shell=not interactive,
            )
            task["bootstrap_exit_code"] = rc
            save_server_task(paths, task)
            active["process"] = None
            if finish_cancelled_noop("during bootstrap"):
                return 0
            if rc != 0:
                task["state"] = "FAILED_BOOTSTRAP"
                task["error"] = f"bootstrap command exited {rc}"
                save_server_task(paths, task)
                return rc
        active["process"] = None
        dirty_after_bootstrap = git_status_porcelain(worktree)
        if dirty_after_bootstrap.strip():
            task["state"] = "FAILED_BOOTSTRAP_DIRTY"
            task["error"] = "bootstrap command changed nonignored repository files"
            task["bootstrap_dirty_status"] = dirty_after_bootstrap
            save_server_task(paths, task)
            note("bootstrap left a dirty worktree; stopping before Codex")
            return 1

        if task_execution_mode(task) == "interactive":
            capture_interactive_dev_environment(
                task,
                worktree,
                state_dir / "interactive-environment-probe.log",
            )
            save_server_task(paths, task)

        if finish_cancelled_noop("before Codex started"):
            return 0
        create_data_links(task)
        if finish_cancelled_noop("while preparing Codex data links"):
            remove_data_links(task)
            return 0
        task["state"] = "RUNNING"
        task["codex_started_at"] = utc_now()
        save_server_task(paths, task)
        execution_mode = task_execution_mode(task)
        if execution_mode == "interactive":
            job_watcher_stop = threading.Event()
            job_watcher = threading.Thread(
                target=interactive_job_request_watcher,
                args=(project_id, task_id_value, job_watcher_stop),
                name=f"codex-job-broker-{task_id_value}",
                daemon=True,
            )
            job_watcher.start()
            command = interactive_codex_command(task)
            note("launching interactive Codex TUI: " + shlex.join(command))
            process = subprocess.Popen(
                command,
                cwd=worktree,
                env=codex_process_environment(task),
                preexec_fn=os.setpgrp,
            )
            active["process"] = process
            active["process_group"] = True
            task["codex_pid"] = process.pid
            save_server_task(paths, task)
            if active["cancelled"] or task.get("cancel_requested"):
                terminate_child_process(process, process_group=True)
            with foreground_child_process_group(process):
                codex_rc = process.wait()
            job_watcher_stop.set()
            job_watcher.join(timeout=120)
            if job_watcher.is_alive():
                note("trusted interactive job broker did not stop within 120 seconds")
            with contextlib.suppress(FileNotFoundError):
                (worktree / JOB_RESPONSE_RELATIVE).unlink()
            with contextlib.suppress(FileNotFoundError):
                (worktree / ENV_RESPONSE_RELATIVE).unlink()
            with contextlib.suppress(FileNotFoundError):
                (worktree / ENV_REQUEST_RELATIVE).unlink()
        else:
            prompt_path = task.get("prompt_path")
            if not isinstance(prompt_path, str) or not prompt_path:
                raise CodexRemoteError(
                    "Noninteractive task is missing its prompt",
                    code="EMPTY_PROMPT",
                )
            prompt = Path(prompt_path).read_text(encoding="utf-8")
            command = codex_command(task)
            note("launching: " + shlex.join(command[:-1]) + " < prompt.txt")
            jsonl_path = state_dir / "codex.jsonl"
            stderr_path = state_dir / "codex.stderr.log"
            with jsonl_path.open("a", encoding="utf-8") as jsonl, stderr_path.open("a", encoding="utf-8") as errlog:
                process = subprocess.Popen(
                    command,
                    cwd=worktree,
                    env=codex_process_environment(task),
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    bufsize=1,
                    start_new_session=True,
                )
                active["process"] = process
                active["process_group"] = True
                task["codex_pid"] = process.pid
                save_server_task(paths, task)
                if active["cancelled"] or task.get("cancel_requested"):
                    terminate_child_process(process, process_group=True)
                assert process.stdin is not None and process.stdout is not None and process.stderr is not None
                stderr_thread = threading.Thread(
                    target=tee_stream, args=(process.stderr, errlog, "[codex stderr] "), daemon=True
                )
                stderr_thread.start()
                try:
                    if not (active["cancelled"] or task.get("cancel_requested")):
                        process.stdin.write(prompt)
                except BrokenPipeError:
                    if not (active["cancelled"] or task.get("cancel_requested")):
                        raise
                finally:
                    with contextlib.suppress(BrokenPipeError):
                        process.stdin.close()
                for line in process.stdout:
                    jsonl.write(line)
                    jsonl.flush()
                    print(line, end="", flush=True)
                    parse_codex_event(task, line, paths)
                process.stdout.close()
                codex_rc = process.wait()
                stderr_thread.join()
        active["process"] = None
        active["process_group"] = False
        task.pop("codex_pid", None)
        task["codex_exit_code"] = codex_rc
        task["codex_finished_at"] = utc_now()
        task["state"] = "FINALIZING"
        save_server_task(paths, task)
        note(f"Codex exited {codex_rc}; finalizing result")

        remove_data_links(task)
        job_request = consume_job_request(task)
        task["job_request"] = job_request
        result_sha, has_changes = commit_dirty_result(task, paths)
        task["result_sha"] = result_sha
        task["has_changes"] = has_changes
        result_lock_hashes, changed_locks = changed_lock_files(task, worktree)
        task["result_lock_hashes"] = result_lock_hashes
        task["lock_files_changed"] = changed_locks
        save_server_task(paths, task)

        environment_state: str | None = None
        bootstrap = task.get("bootstrap_cmd")
        if task_execution_mode(task) == "interactive" and isinstance(bootstrap, str):
            tools = task.get("tools")
            nix = tools.get("nix") if isinstance(tools, Mapping) else None
            bootstrap = nonmutating_nix_develop_command(
                bootstrap, worktree, nix if isinstance(nix, str) else None
            ) or bootstrap
        if has_changes and changed_locks:
            if bootstrap:
                task["state"] = "REFRESHING_ENVIRONMENT"
                task["environment_refresh"] = {
                    "command": bootstrap,
                    "lock_files": changed_locks,
                    "started_at": utc_now(),
                }
                save_server_task(paths, task)
                note(
                    "lock files changed; refreshing the server environment with: "
                    + bootstrap
                )
                interactive = task_execution_mode(task) == "interactive"
                refresh_rc = run_shell_logged(
                    task["tools"]["bash"],
                    bootstrap,
                    worktree,
                    state_dir / "environment-refresh.log",
                    active,
                    env=codex_process_environment(task) if interactive else None,
                    login_shell=not interactive,
                )
                active["process"] = None
                refresh_dirty = git_status_porcelain(worktree)
                task["environment_refresh"].update(
                    {
                        "exit_code": refresh_rc,
                        "finished_at": utc_now(),
                        "dirty_after_refresh": bool(refresh_dirty.strip()),
                    }
                )
                if refresh_dirty.strip():
                    task["environment_refresh"]["dirty_status"] = refresh_dirty
                    environment_state = "READY_ENVIRONMENT_DIRTY"
                elif refresh_rc != 0:
                    environment_state = "READY_ENVIRONMENT_FAILED"
                elif task_execution_mode(task) == "interactive":
                    record = capture_interactive_dev_environment(
                        task,
                        worktree,
                        state_dir / "interactive-environment-probe.log",
                    )
                    task["environment_refresh"]["environment"] = record.get("source")
                save_server_task(paths, task)
            else:
                environment_state = "READY_ENVIRONMENT_UNVERIFIED"
                task["environment_refresh"] = {
                    "lock_files": changed_locks,
                    "skipped": True,
                    "reason": "No bootstrap command is configured",
                }
                save_server_task(paths, task)

        test_rc: int | None = None
        test_dirty = ""
        test_command = task.get("test_cmd")
        if task_execution_mode(task) == "interactive" and isinstance(test_command, str):
            tools = task.get("tools")
            nix = tools.get("nix") if isinstance(tools, Mapping) else None
            test_command = nonmutating_nix_develop_command(
                test_command, worktree, nix if isinstance(nix, str) else None
            ) or test_command
        can_test = environment_state not in {
            "READY_ENVIRONMENT_FAILED",
            "READY_ENVIRONMENT_DIRTY",
        }
        if (has_changes or job_request) and test_command and can_test and not active["cancelled"]:
            create_data_links(task)
            task["state"] = "TESTING"
            task["tests"] = {"command": test_command, "started_at": utc_now()}
            save_server_task(paths, task)
            note(f"running test command: {test_command}")
            interactive = task_execution_mode(task) == "interactive"
            test_rc = run_shell_logged(
                task["tools"]["bash"],
                test_command,
                worktree,
                state_dir / "tests.log",
                active,
                env=codex_process_environment(task) if interactive else None,
                login_shell=not interactive,
            )
            active["process"] = None
            remove_data_links(task)
            test_dirty = git_status_porcelain(worktree)
            task["tests"].update(
                {
                    "exit_code": test_rc,
                    "finished_at": utc_now(),
                    "dirty_after_tests": bool(test_dirty.strip()),
                }
            )
            if test_dirty.strip():
                task["tests"]["dirty_status"] = test_dirty
            save_server_task(paths, task)

        launched_job: dict[str, Any] | None = None
        job_launch_error: str | None = None
        if job_request and task.get("job_policy") == "prepare":
            task["prepared_job_request"] = job_request
            note("validated and recorded a prepared job request without launching it")
        elif job_request and task.get("job_policy") == "launch":
            if active["cancelled"] or task.get("cancel_requested"):
                job_launch_error = "Task was cancelled before the requested job could launch"
            elif codex_rc != 0:
                job_launch_error = f"Codex exited {codex_rc}; requested job was not launched"
            elif not test_command:
                job_launch_error = (
                    "No test command is configured; a runner-mediated job requires a successful "
                    "smoke/test command before launch"
                )
            elif environment_state:
                job_launch_error = (
                    f"Environment validation ended in {environment_state}; requested job was not launched"
                )
            elif test_dirty.strip():
                job_launch_error = "The test command dirtied the source worktree; requested job was not launched"
            elif test_rc != 0:
                job_launch_error = f"The test command exited {test_rc}; requested job was not launched"
            else:
                try:
                    launched_job = start_frozen_job(paths, task, job_request)
                    task["launched_job"] = {
                        "run_id": launched_job["run_id"],
                        "state": launched_job["state"],
                        "worktree": launched_job["worktree"],
                        "state_dir": launched_job["state_dir"],
                        "tmux_session": launched_job["tmux_session"],
                        "source_sha": launched_job["source_sha"],
                    }
                    note(
                        f"launched frozen experiment job {launched_job['run_id']} "
                        f"from {launched_job['source_sha']}"
                    )
                except Exception as exc:
                    job_launch_error = str(exc)
            if job_launch_error:
                task["job_launch_error"] = job_launch_error
                note("requested job was not launched: " + job_launch_error)
        save_server_task(paths, task)

        if active["cancelled"] or task.get("cancel_requested"):
            task["state"] = "CANCELLED_READY" if has_changes else "CANCELLED_NOOP"
        elif job_launch_error:
            task["state"] = "READY_JOB_NOT_LAUNCHED"
        elif job_request and task.get("job_policy") == "prepare":
            task["state"] = "READY_JOB_PREPARED"
        elif not has_changes and codex_rc == 0:
            task["state"] = "NOOP"
        elif not has_changes:
            task["state"] = "FAILED"
            task["error"] = f"Codex exited {codex_rc} without producing changes"
        elif environment_state in {
            "READY_ENVIRONMENT_FAILED",
            "READY_ENVIRONMENT_DIRTY",
        }:
            task["state"] = environment_state
        elif test_dirty.strip():
            task["state"] = "READY_TESTS_DIRTY"
        elif test_rc not in (None, 0):
            task["state"] = "READY_TESTS_FAILED"
        elif codex_rc != 0:
            task["state"] = "READY_CODEX_FAILED"
        elif environment_state:
            task["state"] = environment_state
        else:
            task["state"] = "READY"
        task["finished_at"] = utc_now()
        save_server_task(paths, task)
        note(f"task finished in state {task['state']}")
        return 0 if task["state"] in RESULT_READY_STATES | {"NOOP", "CANCELLED_NOOP"} else 1
    except CodexRemoteError as exc:
        task["state"] = "BLOCKED_UNSAFE_RESULT" if exc.code in {
            "UNSAFE_UNTRACKED",
            "UNSAFE_RESULT",
            "RESULT_DIFF_CHECK_FAILED",
            "DATA_LINK_TAMPERED",
        } else "FAILED"
        task["error"] = str(exc)
        task["error_code"] = exc.code
        task["error_details"] = exc.details
        save_server_task(paths, task)
        note(f"task failed: {exc.code}: {exc}")
        return 1
    except Exception as exc:  # defensive preservation path
        task["state"] = "FAILED"
        task["error"] = str(exc)
        task["error_code"] = "UNEXPECTED_SERVER_ERROR"
        task["traceback"] = traceback.format_exc()
        save_server_task(paths, task)
        note(f"unexpected failure: {exc}")
        return 1


def tmux_pane_state(task: Mapping[str, Any]) -> dict[str, Any]:
    tmux = task.get("tools", {}).get("tmux") or login_which("tmux")
    session = task.get("tmux_session")
    if not tmux or not session:
        return {"exists": False, "running": False, "pane_dead": None, "pane_dead_status": None}
    completed = run(
        [tmux, "list-panes", "-t", session, "-F", "#{pane_dead}\t#{pane_dead_status}\t#{pane_pid}"],
        check=False,
    )
    lines = completed.stdout.splitlines()
    if completed.returncode != 0 or not lines:
        return {"exists": False, "running": False, "pane_dead": None, "pane_dead_status": None}
    first = lines[0].split("\t")
    pane_dead = first[0] == "1" if first else None
    return {
        "exists": True,
        "running": pane_dead is False,
        "pane_dead": pane_dead,
        "pane_dead_status": int(first[1]) if len(first) > 1 and first[1].isdigit() else None,
        "pane_pid": int(first[2]) if len(first) > 2 and first[2].isdigit() else None,
    }


def lock_is_held(path: Path) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with path.open("a+") as handle:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        else:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
            return False


def server_status(project_id: str) -> dict[str, Any]:
    paths = ensure_server_layout(project_id)
    task = load_server_task(paths)
    if not task:
        return {"ok": True, "task": {"state": "NONE"}}
    pane = tmux_pane_state(task)
    task["tmux"] = pane
    worktree = task.get("worktree")
    task["worktree_exists"] = bool(worktree and Path(worktree).exists())
    task["lock_held"] = lock_is_held(paths["lock"])
    if task_execution_mode(task) == "interactive":
        checkpoint = load_task_checkpoint(task)
        if checkpoint:
            task["checkpoint"] = checkpoint
        live_job = load_task_live_job(task)
        if live_job:
            task["launched_job"] = live_job
    runner_missing = not pane.get("exists") and not task["lock_held"]
    if task.get("state") in ACTIVE_STATES and (pane.get("pane_dead") or runner_missing):
        task["state"] = "ORPHANED"
        if pane.get("pane_dead"):
            task["error"] = (
                f"tmux runner exited unexpectedly with status {pane.get('pane_dead_status')} "
                f"while task state was active"
            )
        else:
            task["error"] = "tmux session and project lock disappeared while task state was active"
        save_server_task(paths, task)
    return {"ok": True, "task": task}


def server_checkpoint(project_id: str, task_id_value: str) -> dict[str, Any]:
    """Publish the latest committed interactive checkpoint while Codex runs."""
    paths = ensure_server_layout(project_id)
    task = load_server_task(paths)
    if not task or task.get("task_id") != task_id_value:
        raise CodexRemoteError(
            "The requested interactive task is not current",
            code="TASK_NOT_FOUND",
            details=task,
        )
    state = str(task.get("state") or "NONE")
    if state not in ACTIVE_STATES | RESULT_READY_STATES | {"NOOP", "CANCELLED_NOOP"}:
        raise CodexRemoteError(
            f"Task state {state} cannot publish a checkpoint",
            code="CHECKPOINT_NOT_AVAILABLE",
            details=task,
        )
    checkpoint = publish_task_checkpoint(paths, task)
    return {"ok": True, "task": task, "checkpoint": checkpoint}


def tail_file(path: Path, lines: int) -> str:
    if not path.exists():
        return ""
    # Logs are expected to be modest.  Bound the read to the final 4 MiB.
    with path.open("rb") as handle:
        handle.seek(0, os.SEEK_END)
        size = handle.tell()
        handle.seek(max(0, size - 4 * 1024 * 1024))
        text = handle.read().decode("utf-8", errors="replace")
    return "\n".join(text.splitlines()[-lines:])


def server_recover(project_id: str) -> dict[str, Any]:
    """Publish a preserved worktree after its original runner disappeared.

    Recovery never reruns Codex.  It performs the normal result safety checks
    and publishes the current worktree, but deliberately marks the result
    unverified because the interrupted server environment/tests are not rerun.
    """
    paths = ensure_server_layout(project_id)
    task = load_server_task(paths)
    if not task:
        raise CodexRemoteError("No task exists", code="TASK_NOT_FOUND")
    if task.get("state") not in {"ORPHANED", "FAILED"}:
        raise CodexRemoteError(
            f"Task is not recoverable; current state is {task.get('state')}",
            code="TASK_NOT_RECOVERABLE",
            details=task,
        )
    pane = tmux_pane_state(task)
    if pane.get("running") or lock_is_held(paths["lock"]):
        raise CodexRemoteError(
            "The original runner still appears active; refusing recovery",
            code="TASK_STILL_ACTIVE",
            details={"task": task, "tmux": pane},
        )
    worktree_value = task.get("worktree")
    if not isinstance(worktree_value, str) or not Path(worktree_value).is_dir():
        raise CodexRemoteError(
            "The preserved server worktree is missing",
            code="RECOVERY_WORKTREE_MISSING",
            details=task,
        )

    paths["lock"].parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock_handle = paths["lock"].open("a+")
    try:
        try:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise CodexRemoteError(
                "Another writer acquired the project lock before recovery",
                code="TASK_STILL_ACTIVE",
            ) from exc
        cleanup_tmux_session(task)
        previous = {
            "state": task.get("state"),
            "error": task.get("error"),
            "error_code": task.get("error_code"),
        }
        task["state"] = "FINALIZING"
        task["recovery"] = {
            "started_at": utc_now(),
            "previous": previous,
            "codex_rerun": False,
            "tests_rerun": False,
        }
        save_server_task(paths, task)
        remove_data_links(task)
        result_sha, has_changes = commit_dirty_result(task, paths)
        task["result_sha"] = result_sha
        task["has_changes"] = has_changes
        task["recovery"]["finished_at"] = utc_now()
        task["recovery"]["result_sha"] = result_sha
        task.pop("error", None)
        task.pop("error_code", None)
        task.pop("error_details", None)
        if has_changes:
            task["state"] = "READY_RECOVERED_UNVERIFIED"
            message = (
                "Recovered and published the preserved worktree without rerunning "
                "Codex or server tests. SPC r c f will warn before import."
            )
        else:
            task["state"] = "NOOP"
            message = "The preserved worktree contained no changes; task is a no-op."
        task["finished_at"] = utc_now()
        task = save_server_task(paths, task)
        return {"ok": True, "task": task, "message": message}
    except CodexRemoteError as exc:
        task["state"] = "BLOCKED_UNSAFE_RESULT" if exc.code in {
            "UNSAFE_UNTRACKED",
            "UNSAFE_RESULT",
            "RESULT_DIFF_CHECK_FAILED",
            "DATA_LINK_TAMPERED",
        } else "FAILED"
        task["error"] = str(exc)
        task["error_code"] = exc.code
        task["error_details"] = exc.details
        save_server_task(paths, task)
        raise
    finally:
        with contextlib.suppress(OSError):
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)
        lock_handle.close()


def server_logs(project_id: str, lines: int) -> dict[str, Any]:
    paths = ensure_server_layout(project_id)
    task = load_server_task(paths)
    if not task:
        return {"ok": True, "task": {"state": "NONE"}, "log": "No Codex task exists for this project."}
    state_dir = Path(task["state_dir"])
    sections = []
    for title, name in (
        ("Runner", "runner.log"),
        ("Bootstrap", "bootstrap.log"),
        ("Codex stderr", "codex.stderr.log"),
        ("Codex events", "codex.jsonl"),
        ("Tests", "tests.log"),
        ("Final message", "final-message.txt"),
    ):
        content = tail_file(state_dir / name, lines)
        if content:
            sections.append(f"===== {title} =====\n{content}")
    return {"ok": True, "task": task, "log": "\n\n".join(sections)}


# ---------------------------------------------------------------------------
# Frozen long-running experiment jobs
# ---------------------------------------------------------------------------


def job_state_path(paths: Mapping[str, Path], run_id: str) -> Path:
    validate_safe_id(run_id, "run id")
    return paths["jobs_state"] / run_id / "run.json"


def load_server_job(paths: Mapping[str, Path], run_id: str) -> dict[str, Any] | None:
    return read_json(job_state_path(paths, run_id))


def save_server_job(paths: Mapping[str, Path], job: Mapping[str, Any]) -> dict[str, Any]:
    value = dict(job)
    state_path = job_state_path(paths, value["run_id"])
    # A stop request is monotonic.  Preserve it when the runner writes state
    # concurrently with the user-facing stop command.
    existing = read_json(state_path)
    if isinstance(existing, dict) and existing.get("stop_requested"):
        value["stop_requested"] = True
    value["updated_at"] = utc_now()
    atomic_write_json(state_path, value)
    atomic_write_json(
        state_path.parent / "status.json",
        {
            "schema_version": SCHEMA_VERSION,
            "project_id": value.get("project_id"),
            "run_id": value.get("run_id"),
            "name": value.get("name"),
            "state": value.get("state"),
            "created_at": value.get("created_at"),
            "started_at": value.get("started_at"),
            "finished_at": value.get("finished_at"),
            "exit_code": value.get("exit_code"),
            "completion_marker_present": value.get("completion_marker_present"),
            "updated_at": value["updated_at"],
            "error": value.get("error"),
            "analysis": value.get("analysis"),
        },
    )
    return value


def job_slug(name: str) -> str:
    value = re.sub(r"[^A-Za-z0-9]+", "-", name.strip()).strip("-").lower()
    return (value or "run")[:40]


def experiment_run_id(name: str) -> str:
    timestamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    return f"{timestamp}-{job_slug(name)}-{os.urandom(3).hex()}"


def job_environment_text(job: Mapping[str, Any]) -> str:
    fields = {
        "run_id": job.get("run_id"),
        "hostname": job.get("hostname"),
        "platform": job.get("platform"),
        "python": job.get("python"),
        "git_version": job.get("git_version"),
        "source_sha": job.get("source_sha"),
        "bootstrap_command": job.get("bootstrap_cmd") or "(none)",
        "requested_cuda_visible_devices": job.get("gpus") or "(inherited)",
        "effective_cuda_visible_devices": job.get("effective_cuda_visible_devices")
        or "(unset)",
        "worktree": job.get("worktree"),
        "run_dir": job.get("state_dir"),
    }
    text = "".join(f"{key}={value}\n" for key, value in fields.items())
    lock_hashes = job.get("lock_hashes") or {}
    if isinstance(lock_hashes, Mapping):
        for path, digest in sorted(lock_hashes.items()):
            text += f"lock_sha256[{path}]={digest}\n"
    return text


def create_job_data_links(job: Mapping[str, Any]) -> None:
    create_data_links(
        {
            "worktree": job["worktree"],
            "data_links": job.get("data_links") or [],
        }
    )


def validate_job_completion_marker(
    task: Mapping[str, Any], completion_marker: str
) -> None:
    """Keep completion evidence inside the frozen worktree, not a linked dataset."""
    if not completion_marker:
        return
    marker = PurePosixPath(completion_marker)
    for item in task.get("data_links") or []:
        target_value = item.get("target") if isinstance(item, Mapping) else None
        if not isinstance(target_value, str):
            continue
        target = PurePosixPath(target_value)
        if marker == target or target in marker.parents:
            raise CodexRemoteError(
                "Completion marker cannot be located inside a configured data link",
                code="INVALID_JOB_REQUEST",
            )


def job_completion_marker_path(worktree: Path, completion_marker: str) -> Path:
    """Return a marker path without permitting symlink-parent escapes."""
    marker = PurePosixPath(completion_marker)
    if marker.is_absolute() or ".." in marker.parts or not marker.parts:
        raise CodexRemoteError(
            "Completion marker must be a nonempty path inside the frozen worktree",
            code="INVALID_JOB_REQUEST",
        )
    parent = worktree
    for part in marker.parts[:-1]:
        parent = parent / part
        if parent.is_symlink():
            raise CodexRemoteError(
                f"Completion-marker parent is a symlink: {parent}",
                code="INVALID_COMPLETION_MARKER",
            )
        if parent.exists() and not parent.is_dir():
            raise CodexRemoteError(
                f"Completion-marker parent is not a directory: {parent}",
                code="INVALID_COMPLETION_MARKER",
            )
    return parent / marker.parts[-1]


def start_frozen_job(
    paths: Mapping[str, Path],
    task: Mapping[str, Any],
    request: Mapping[str, Any],
    *,
    preflight_test_cmd: str = "",
) -> dict[str, Any]:
    """Launch REQUEST from an immutable result SHA, independently of Codex."""
    normalized = normalized_job_request(request)
    validate_job_completion_marker(task, normalized["completion_marker"])
    source_sha = task.get("result_sha")
    if not isinstance(source_sha, str) or not source_sha:
        raise CodexRemoteError(
            "Cannot launch a job before publishing a result snapshot",
            code="JOB_SOURCE_MISSING",
        )
    tools = dict(task.get("tools") or {})
    for name in ("bash", "git", "tmux"):
        if not tools.get(name):
            tools[name] = login_which(name)
    missing = [name for name in ("bash", "git", "tmux") if not tools.get(name)]
    if missing:
        raise CodexRemoteError(
            "Cannot launch job; server tools missing: " + ", ".join(missing),
            code="REMOTE_PREREQUISITES_MISSING",
        )
    tools["python3"] = str(Path(sys.executable).resolve())
    git_version = command_version(tools["git"], "--version")

    run_id = experiment_run_id(normalized["name"])
    state_dir = paths["jobs_state"] / run_id
    state_dir.mkdir(parents=True, exist_ok=False, mode=0o700)
    for name in ("checkpoints", "results"):
        (state_dir / name).mkdir(mode=0o700)
    worktree = paths["job_worktrees"] / run_id
    source_ref = f"refs/codex/{task['project_id']}/job/{run_id}"
    session = f"job-{task['project_id'][-10:]}-{run_id[-12:]}"
    runner_helper = state_dir / "codex-job-runner.py"
    runner_helper.write_bytes(Path(__file__).resolve().read_bytes())
    runner_helper.chmod(0o700)
    job: dict[str, Any] = {
        "schema_version": SCHEMA_VERSION,
        "project_id": task["project_id"],
        "project_name": task.get("project_name"),
        "run_id": run_id,
        "name": normalized["name"],
        "state": "STARTING",
        "created_at": utc_now(),
        "source_task_id": task.get("task_id"),
        "source_sha": source_sha,
        "source_ref": source_ref,
        "input_sha": task.get("input_sha"),
        "command": normalized["command"],
        "bootstrap_cmd": task.get("bootstrap_cmd") or "",
        "gpus": normalized["gpus"],
        "inherited_cuda_visible_devices": os.environ.get("CUDA_VISIBLE_DEVICES"),
        "effective_cuda_visible_devices": normalized["gpus"]
        or os.environ.get("CUDA_VISIBLE_DEVICES"),
        "completion_marker": normalized["completion_marker"],
        "resume_command": normalized["resume_command"],
        "metadata": normalized["metadata"],
        "requested_at": normalized["requested_at"],
        "launch_validation": {
            "codex_exit_code": task.get("codex_exit_code"),
            "environment_refresh": task.get("environment_refresh"),
            "tests": task.get("tests"),
        },
        "preflight_test_cmd": preflight_test_cmd,
        "worktree": str(worktree),
        "state_dir": str(state_dir),
        "results_dir": str(state_dir / "results"),
        "checkpoints_dir": str(state_dir / "checkpoints"),
        "run_log": str(state_dir / "run.log"),
        "tmux_session": session,
        "runner_helper": str(runner_helper),
        "runner_helper_sha256": sha256_file(runner_helper),
        "data_links": list(task.get("data_links") or []),
        "data_links_active": False,
        "lock_hashes": dict(
            task.get("result_lock_hashes") or task.get("lock_hashes") or {}
        ),
        "model": task.get("model"),
        "profile": task.get("profile"),
        "reasoning_effort": task.get("reasoning_effort"),
        "tools": tools,
        "hostname": socket.gethostname(),
        "platform": platform.platform(),
        "python": sys.version.replace("\n", " "),
        "git_version": git_version.get("stdout") or git_version.get("stderr"),
    }
    save_server_job(paths, job)
    try:
        run(["git", "--git-dir", paths["broker"], "update-ref", source_ref, source_sha])
        env = os.environ.copy()
        env["GIT_LFS_SKIP_SMUDGE"] = "1"
        run(
            [
                "git",
                "--git-dir",
                paths["broker"],
                "worktree",
                "add",
                "--detach",
                str(worktree),
                source_sha,
            ],
            env=env,
        )
        marker = job.get("completion_marker") or ""
        if marker:
            marker_path = job_completion_marker_path(worktree, marker)
            if marker_path.exists() or marker_path.is_symlink():
                raise CodexRemoteError(
                    f"Completion marker already exists in the frozen source: {marker}",
                    code="COMPLETION_MARKER_EXISTS",
                )
            job["completion_marker_initially_absent"] = True
        atomic_write_text(state_dir / "command.txt", shlex.join(job["command"]) + "\n")
        if job.get("bootstrap_cmd"):
            atomic_write_text(
                state_dir / "bootstrap-command.txt",
                str(job["bootstrap_cmd"]) + "\n",
            )
        atomic_write_text(state_dir / "source-snapshot.txt", source_sha + "\n")
        atomic_write_text(state_dir / "environment.txt", job_environment_text(job))
        runner_argv = [
            tools["python3"],
            str(runner_helper),
            "_server-job-run",
            "--project-id",
            task["project_id"],
            "--run-id",
            run_id,
        ]
        command = shlex.join([tools["bash"], "-lc", "exec " + shlex.join(runner_argv)])
        job["runner_command"] = command
        job = save_server_job(paths, job)
        run([tools["tmux"], "new-session", "-d", "-s", session, command])
        tmux_option = run(
            [tools["tmux"], "set-option", "-t", session, "remain-on-exit", "on"],
            check=False,
        )
        if tmux_option.returncode != 0:
            atomic_write_text(
                state_dir / "tmux-warning.txt",
                (tmux_option.stderr or tmux_option.stdout or "tmux set-option failed")
                + "\n",
            )
        # The runner can advance to RUNNING or even finish before tmux returns.
        # Never overwrite that newer state with this stale STARTING object.
        return load_server_job(paths, run_id) or job
    except Exception as exc:
        if job.get("data_links_active"):
            try:
                remove_data_links(job)
            except Exception as cleanup_exc:
                job["data_link_cleanup_error"] = str(cleanup_exc)
            else:
                job["data_links_active"] = False
        job["state"] = "FAILED"
        job["error"] = f"Job launch setup failed: {exc}"
        job["finished_at"] = utc_now()
        save_server_job(paths, job)
        raise


def server_request_job(
    project_id: str, task_id_value: str, request: Mapping[str, Any]
) -> dict[str, Any]:
    """Freeze and launch a committed interactive checkpoint immediately.

    The interactive TUI remains alive.  The job gets a separate immutable
    worktree and performs its configured bootstrap/test preflight before the
    experiment command begins.
    """
    paths = ensure_server_layout(project_id)
    task = load_server_task(paths)
    if not task or task.get("task_id") != task_id_value:
        raise CodexRemoteError(
            "The requesting interactive task is not current",
            code="TASK_NOT_FOUND",
            details=task,
        )
    if task_execution_mode(task) != "interactive":
        raise CodexRemoteError(
            "Only an interactive Codex task may launch a job while it remains open",
            code="JOB_NOT_AUTHORIZED",
            details=task,
        )
    if task.get("job_policy") not in {"launch", "prepare"}:
        raise CodexRemoteError(
            "This interactive task was not authorized to request an experiment job",
            code="JOB_NOT_AUTHORIZED",
            details=task,
        )
    if task.get("state") not in INTERACTIVE_ATTACH_STATES:
        raise CodexRemoteError(
            f"Interactive job requests require a live TUI; current state is {task.get('state')}",
            code="TASK_NOT_ACTIVE",
            details=task,
        )
    normalized = normalized_job_request(request)
    state_path = live_job_state_path(task)
    request_lock = state_path.with_name("live-job.lock")
    request_lock.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with request_lock.open("a+") as lock_handle:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        existing = load_task_live_job(task)
        if existing:
            raise CodexRemoteError(
                "This interactive Codex task has already requested a frozen job",
                code="JOB_REQUEST_EXISTS",
                details=existing,
            )
        worktree = Path(str(task["worktree"]))
        status = git_status_porcelain(worktree)
        if status.strip():
            raise CodexRemoteError(
                "Commit all source changes before requesting a frozen job. The job must "
                "start from an exact committed checkpoint.",
                code="JOB_SOURCE_DIRTY",
                details={"status": status},
            )
        checkpoint = publish_task_checkpoint(paths, task)
        if task.get("job_policy") == "prepare":
            prepared = {
                "schema_version": SCHEMA_VERSION,
                "state": "PREPARED",
                "request": normalized,
                "source_sha": checkpoint["sha"],
                "prepared_at": utc_now(),
            }
            atomic_write_json(state_path, prepared)
            return {
                "ok": True,
                "task": task,
                "checkpoint": checkpoint,
                "prepared": prepared,
                "message": "Prepared a frozen job request without launching it.",
            }

        source_task = dict(task)
        source_task["result_sha"] = checkpoint["sha"]
        source_task["result_lock_hashes"] = file_hashes(worktree)
        job = start_frozen_job(
            paths,
            source_task,
            normalized,
            preflight_test_cmd=str(task.get("test_cmd") or ""),
        )
        record = {
            "schema_version": SCHEMA_VERSION,
            "state": "LAUNCHED",
            "run_id": job.get("run_id"),
            "name": job.get("name"),
            "source_sha": checkpoint["sha"],
            "requested_at": normalized.get("requested_at"),
            "launched_at": utc_now(),
            "job_state": job.get("state"),
            "tmux_session": job.get("tmux_session"),
        }
        atomic_write_json(state_path, record)
        return {
            "ok": True,
            "task": task,
            "checkpoint": checkpoint,
            "job": job,
            "message": (
                f"Launched frozen job {job.get('run_id')} from committed checkpoint "
                f"{str(checkpoint['sha'])[:12]}; the interactive Codex session remains active."
            ),
        }


def job_process_environment(job: Mapping[str, Any]) -> dict[str, str]:
    env = os.environ.copy()
    env.update(
        {
            "PYTHONUNBUFFERED": "1",
            "CODEX_RUN_ID": str(job["run_id"]),
            "CODEX_RUN_DIR": str(job["state_dir"]),
            "CODEX_RESULTS_DIR": str(job["results_dir"]),
            "CODEX_CHECKPOINTS_DIR": str(job["checkpoints_dir"]),
            "CODEX_SOURCE_SHA": str(job["source_sha"]),
        }
    )
    if job.get("gpus"):
        env["CUDA_VISIBLE_DEVICES"] = str(job["gpus"])
    return env


def inspect_job_source(job: Mapping[str, Any]) -> dict[str, Any]:
    """Compare a job worktree with the exact source commit it was given."""
    worktree = Path(job["worktree"])
    source_sha = str(job["source_sha"])
    head_sha = git(worktree, "rev-parse", "HEAD").stdout.strip()
    tracked_changes = git(
        worktree, "diff", "--name-status", source_sha, "--"
    ).stdout.strip()
    untracked_paths = git(
        worktree, "ls-files", "--others", "--exclude-standard"
    ).stdout.splitlines()
    return {
        "expected_head_sha": source_sha,
        "head_sha": head_sha,
        "head_matches_source": head_sha == source_sha,
        "tracked_changes": tracked_changes,
        "tracked_clean": not bool(tracked_changes) and head_sha == source_sha,
        "untracked_paths": untracked_paths,
    }


def server_job_run(project_id: str, run_id: str) -> int:
    paths = ensure_server_layout(project_id)
    job = load_server_job(paths, run_id)
    if not job:
        raise CodexRemoteError("Job not found", code="JOB_NOT_FOUND")
    if job.get("state") != "STARTING":
        raise CodexRemoteError(
            f"Job runner may start only from STARTING, not {job.get('state')}",
            code="JOB_NOT_STARTABLE",
            details=job,
        )
    log_path = Path(job["run_log"])
    active: dict[str, Any] = {"process": None, "stop": False}

    def save_note(message: str) -> None:
        with log_path.open("a", encoding="utf-8") as handle:
            handle.write(f"{utc_now()} [runner] {message}\n")
            handle.flush()

    def refresh_stop_request() -> bool:
        latest = load_server_job(paths, run_id)
        if latest and (
            latest.get("stop_requested")
            or latest.get("state") in {"STOPPED", "STOP_REQUESTED"}
        ):
            active["stop"] = True
            job["stop_requested"] = True
        return bool(active["stop"] or job.get("stop_requested"))

    def handle_signal(signum: int, _frame: Any) -> None:
        active["stop"] = True
        job["stop_requested"] = True
        process = active.get("process")
        if process is not None and process.poll() is None:
            terminate_child_process(process, process_group=True)
        save_server_job(paths, job)
        save_note(f"received signal {signum}")

    def run_job_process(argv: Sequence[str], output_path: Path) -> int:
        output_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        with output_path.open("a", encoding="utf-8") as output:
            process = subprocess.Popen(
                list(argv),
                cwd=Path(job["worktree"]),
                env=job_process_environment(job),
                stdout=output,
                stderr=subprocess.STDOUT,
                text=True,
                start_new_session=True,
            )
            active["process"] = process
            job["process_pid"] = process.pid
            job["process_start_ticks"] = process_start_ticks(process.pid)
            save_server_job(paths, job)
            if refresh_stop_request():
                terminate_child_process(process, process_group=True)
            returncode = process.wait()
            refresh_stop_request()
        active["process"] = None
        job.pop("process_pid", None)
        job.pop("process_start_ticks", None)
        save_server_job(paths, job)
        return returncode

    def finish_before_command(state: str, exit_code: int, error: str | None = None) -> int:
        if job.get("data_links_active"):
            remove_data_links(job)
            job["data_links_active"] = False
        job["source_integrity"] = inspect_job_source(job)
        job["state"] = state
        job["phase"] = "finished"
        job["exit_code"] = exit_code
        if error:
            job["error"] = error
        job["finished_at"] = utc_now()
        job.pop("process_pid", None)
        save_server_job(paths, job)
        save_note(f"finished in state {state} before experiment command; exit code {exit_code}")
        return 0 if state == "SUCCEEDED" else 1

    signal.signal(signal.SIGTERM, handle_signal)
    signal.signal(signal.SIGINT, handle_signal)
    try:
        job["runner_pid"] = os.getpid()
        job["server_boot_id"] = linux_boot_id()
        job["runner_start_ticks"] = process_start_ticks(os.getpid())
        job["started_at"] = utc_now()
        bootstrap = str(job.get("bootstrap_cmd") or "")
        if bootstrap:
            tools = job.get("tools")
            nix = tools.get("nix") if isinstance(tools, Mapping) else None
            bootstrap = nonmutating_nix_develop_command(
                bootstrap, Path(job["worktree"]), nix if isinstance(nix, str) else None
            ) or bootstrap
        job["state"] = "BOOTSTRAPPING" if bootstrap else "RUNNING"
        job["phase"] = "bootstrap" if bootstrap else "preparing-data"
        job = save_server_job(paths, job)
        if refresh_stop_request():
            return finish_before_command("STOPPED", 0, "Job was stopped before startup completed")

        if bootstrap:
            bootstrap_log = Path(job["state_dir"]) / "bootstrap.log"
            job["bootstrap"] = {
                "command": bootstrap,
                "started_at": utc_now(),
                "log": str(bootstrap_log),
            }
            job = save_server_job(paths, job)
            save_note("bootstrapping frozen worktree: " + bootstrap)
            bootstrap_rc = run_job_process(
                [job["tools"]["bash"], "-lc", bootstrap], bootstrap_log
            )
            bootstrap_status = git_status_porcelain(Path(job["worktree"]))
            bootstrap_integrity = inspect_job_source(job)
            job["bootstrap"].update(
                {
                    "exit_code": bootstrap_rc,
                    "finished_at": utc_now(),
                    "dirty_after_bootstrap": bool(bootstrap_status.strip()),
                    "source_integrity": bootstrap_integrity,
                }
            )
            if bootstrap_status.strip():
                job["bootstrap"]["dirty_status"] = bootstrap_status
            job = save_server_job(paths, job)
            if refresh_stop_request():
                return finish_before_command(
                    "STOPPED", bootstrap_rc, "Job was stopped during frozen-worktree bootstrap"
                )
            if bootstrap_rc != 0:
                return finish_before_command(
                    "FAILED",
                    bootstrap_rc,
                    f"Frozen-worktree bootstrap command exited {bootstrap_rc}",
                )
            if bootstrap_status.strip() or not bootstrap_integrity["tracked_clean"]:
                return finish_before_command(
                    "FAILED",
                    bootstrap_rc,
                    "Frozen-worktree bootstrap changed the pinned source checkout",
                )
            marker = str(job.get("completion_marker") or "")
            if marker:
                marker_path = job_completion_marker_path(Path(job["worktree"]), marker)
                if marker_path.exists() or marker_path.is_symlink():
                    return finish_before_command(
                        "FAILED",
                        bootstrap_rc,
                        "Frozen-worktree bootstrap created the experiment completion marker before the command ran",
                    )

        job["phase"] = "preparing-data"
        job["state"] = "RUNNING"
        job = save_server_job(paths, job)
        create_job_data_links(job)
        job["data_links_active"] = bool(job.get("data_links"))
        job = save_server_job(paths, job)
        if refresh_stop_request():
            return finish_before_command("STOPPED", 0, "Job was stopped before the experiment command started")

        preflight = str(job.get("preflight_test_cmd") or "")
        if preflight:
            tools = job.get("tools")
            nix = tools.get("nix") if isinstance(tools, Mapping) else None
            preflight = nonmutating_nix_develop_command(
                preflight, Path(job["worktree"]), nix if isinstance(nix, str) else None
            ) or preflight
            preflight_log = Path(job["state_dir"]) / "preflight-tests.log"
            job["phase"] = "preflight-tests"
            job["preflight_tests"] = {
                "command": preflight,
                "started_at": utc_now(),
                "log": str(preflight_log),
            }
            job = save_server_job(paths, job)
            save_note("running frozen-source preflight tests: " + preflight)
            preflight_rc = run_job_process(
                [job["tools"]["bash"], "-lc", preflight], preflight_log
            )
            preflight_status = git_status_porcelain(Path(job["worktree"]))
            preflight_integrity = inspect_job_source(job)
            job["preflight_tests"].update(
                {
                    "exit_code": preflight_rc,
                    "finished_at": utc_now(),
                    "dirty_after_tests": bool(preflight_status.strip()),
                    "source_integrity": preflight_integrity,
                }
            )
            if preflight_status.strip():
                job["preflight_tests"]["dirty_status"] = preflight_status
            job = save_server_job(paths, job)
            if refresh_stop_request():
                return finish_before_command(
                    "STOPPED", preflight_rc, "Job was stopped during preflight tests"
                )
            if preflight_rc != 0:
                return finish_before_command(
                    "FAILED",
                    preflight_rc,
                    f"Frozen-source preflight test command exited {preflight_rc}",
                )
            if preflight_status.strip() or not preflight_integrity["tracked_clean"]:
                return finish_before_command(
                    "FAILED",
                    preflight_rc,
                    "Frozen-source preflight tests changed the pinned source checkout",
                )

        job["phase"] = "command"
        job["command_started_at"] = utc_now()
        job = save_server_job(paths, job)
        save_note("starting: " + shlex.join(job["command"]))
        returncode = run_job_process(job["command"], log_path)
        job["command_finished_at"] = utc_now()
        job["exit_code"] = returncode

        marker = str(job.get("completion_marker") or "")
        marker_present = True
        marker_error: str | None = None
        if marker:
            try:
                marker_path = job_completion_marker_path(Path(job["worktree"]), marker)
                marker_present = marker_path.is_file() and not marker_path.is_symlink()
                if not marker_present:
                    marker_error = (
                        "Completion marker is missing or is not a regular, non-symlink file: "
                        + marker
                    )
            except CodexRemoteError as exc:
                marker_present = False
                marker_error = str(exc)
        job["completion_marker_present"] = marker_present
        if marker_error:
            job["completion_marker_error"] = marker_error
        else:
            job.pop("completion_marker_error", None)

        # Data links are needed only while the experiment runs. Removing them
        # narrows later read-only analysis to the frozen source and captured run
        # artifacts, and verifies that the command did not replace a configured
        # link.
        remove_data_links(job)
        job["data_links_active"] = False
        source_integrity = inspect_job_source(job)
        job["source_integrity"] = source_integrity
        tracked_changes = str(source_integrity["tracked_changes"])
        head_sha = str(source_integrity["head_sha"])
        source_sha = str(source_integrity["expected_head_sha"])

        if refresh_stop_request():
            job["state"] = "STOPPED"
        elif returncode != 0:
            job["state"] = "FAILED"
        elif not source_integrity["tracked_clean"]:
            job["state"] = "SOURCE_DIRTY"
            details = []
            if head_sha != source_sha:
                details.append(f"HEAD moved from {source_sha} to {head_sha}")
            if tracked_changes:
                details.append("tracked changes: " + tracked_changes.replace("\n", "; "))
            job["error"] = (
                "The experiment altered its frozen source identity: " + "; ".join(details)
            )
        elif not marker_present:
            job["state"] = "INCOMPLETE"
            job["error"] = marker_error or f"Completion marker was not created: {marker}"
        else:
            job["state"] = "SUCCEEDED"
        job["phase"] = "finished"
        job["finished_at"] = utc_now()
        job.pop("process_pid", None)
        job = save_server_job(paths, job)
        save_note(f"finished in state {job['state']} with exit code {returncode}")
        return 0 if job["state"] == "SUCCEEDED" else 1
    except Exception as exc:
        if job.get("data_links_active"):
            try:
                remove_data_links(job)
            except Exception as cleanup_exc:
                job["data_link_cleanup_error"] = str(cleanup_exc)
            else:
                job["data_links_active"] = False
        job["state"] = "STOPPED" if active["stop"] else "FAILED"
        job["phase"] = "finished"
        job["error"] = str(exc)
        job["traceback"] = traceback.format_exc()
        job["finished_at"] = utc_now()
        job.pop("process_pid", None)
        job.pop("process_start_ticks", None)
        save_server_job(paths, job)
        save_note(f"failed: {exc}")
        return 1


def process_identity_alive(pid: Any, boot_id: Any, start_ticks: Any) -> bool:
    try:
        value = int(pid)
    except (TypeError, ValueError):
        return False
    if boot_id and linux_boot_id() and boot_id != linux_boot_id():
        return False
    if start_ticks is not None and process_start_ticks(value) != int(start_ticks):
        return False
    try:
        os.kill(value, 0)
    except (OSError, ProcessLookupError):
        return False
    return True


def job_with_runtime_status(paths: Mapping[str, Path], job: dict[str, Any]) -> dict[str, Any]:
    value = dict(job)
    value["tmux"] = tmux_pane_state(value)
    worktree_value = value.get("worktree")
    value["worktree_exists"] = bool(
        isinstance(worktree_value, str) and worktree_value and Path(worktree_value).is_dir()
    )
    value["process_alive"] = process_identity_alive(
        value.get("process_pid"),
        value.get("server_boot_id"),
        value.get("process_start_ticks"),
    )
    if value.get("state") in JOB_ACTIVE_STATES:
        pane = value["tmux"]
        if not value["process_alive"] and (pane.get("pane_dead") or not pane.get("exists")):
            value["state"] = "ORPHANED"
            value["error"] = "Job runner and process disappeared while the job was active"
            value["finished_at"] = utc_now()
            if value.get("data_links_active"):
                try:
                    remove_data_links(value)
                except Exception as exc:
                    value["data_link_cleanup_error"] = str(exc)
                else:
                    value["data_links_active"] = False
            value = save_server_job(paths, value)
            value["tmux"] = pane
            value["worktree_exists"] = bool(
                isinstance(worktree_value, str)
                and worktree_value
                and Path(worktree_value).is_dir()
            )
            value["process_alive"] = False
    analysis = value.get("analysis")
    if isinstance(analysis, dict) and analysis.get("state") in {"STARTING", "RUNNING"}:
        analysis_task = {
            "tools": value.get("tools") or {},
            "tmux_session": analysis.get("tmux_session"),
        }
        analysis_tmux = tmux_pane_state(analysis_task)
        value["analysis_tmux"] = analysis_tmux
        if analysis_tmux.get("pane_dead") or not analysis_tmux.get("exists"):
            analysis = dict(analysis)
            analysis["state"] = "ORPHANED"
            analysis["error"] = "Codex analysis runner disappeared while analysis was active"
            analysis["finished_at"] = utc_now()
            value["analysis"] = analysis
            value = save_server_job(paths, value)
            value["analysis_tmux"] = analysis_tmux
    return value


def server_jobs(project_id: str) -> dict[str, Any]:
    paths = ensure_server_layout(project_id)
    jobs = []
    for path in paths["jobs_state"].glob("*/run.json"):
        value = read_json(path)
        if isinstance(value, dict):
            jobs.append(job_with_runtime_status(paths, value))
    jobs.sort(key=lambda item: item.get("created_at") or "", reverse=True)
    return {"ok": True, "jobs": jobs}


def server_job_status(project_id: str, run_id: str) -> dict[str, Any]:
    paths = ensure_server_layout(project_id)
    job = load_server_job(paths, run_id)
    if not job:
        raise CodexRemoteError(f"Job not found: {run_id}", code="JOB_NOT_FOUND")
    return {"ok": True, "job": job_with_runtime_status(paths, job)}


def server_job_logs(project_id: str, run_id: str, lines: int) -> dict[str, Any]:
    status = server_job_status(project_id, run_id)
    job = status["job"]
    state_dir = Path(job["state_dir"])
    sections = []
    for title, filename in (
        ("Run", "run.log"),
        ("Frozen-worktree bootstrap", "bootstrap.log"),
        ("Analysis events", "analysis.jsonl"),
        ("Analysis stderr", "analysis.stderr.log"),
    ):
        content = tail_file(state_dir / filename, lines)
        if content:
            sections.append(f"===== {title} =====\n{content}")
    return {"ok": True, "job": job, "log": "\n\n".join(sections)}


def server_job_stop(project_id: str, run_id: str) -> dict[str, Any]:
    paths = ensure_server_layout(project_id)
    job = load_server_job(paths, run_id)
    if not job:
        raise CodexRemoteError(f"Job not found: {run_id}", code="JOB_NOT_FOUND")
    job = job_with_runtime_status(paths, job)
    if job.get("state") not in JOB_ACTIVE_STATES:
        raise CodexRemoteError(
            f"Job is not active; current state is {job.get('state')}",
            code="JOB_NOT_ACTIVE",
            details=job,
        )
    job["stop_requested"] = True
    job["state"] = "STOP_REQUESTED"
    job = save_server_job(paths, job)
    pid = job.get("process_pid")
    if process_identity_alive(pid, job.get("server_boot_id"), job.get("process_start_ticks")):
        try:
            os.killpg(int(pid), signal.SIGTERM)
        except (OSError, ProcessLookupError):
            pass
    elif not pid:
        tmux = job.get("tools", {}).get("tmux") or login_which("tmux")
        if tmux and job.get("tmux_session"):
            run([tmux, "kill-session", "-t", job["tmux_session"]], check=False)
        job["state"] = "STOPPED"
        job["finished_at"] = utc_now()
        job = save_server_job(paths, job)
    return {"ok": True, "job": job}


def job_analysis_schema() -> dict[str, Any]:
    string_array = {"type": "array", "items": {"type": "string"}}
    return {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": False,
        "properties": {
            "run_complete": {"type": "boolean"},
            "summary": {"type": "string"},
            "source_and_command": {"type": "string"},
            "coverage_checks": string_array,
            "headline_results": string_array,
            "anomalies": string_array,
            "supported_conclusions": string_array,
            "unsupported_conclusions": string_array,
            "recommended_actions": string_array,
        },
        "required": [
            "run_complete",
            "summary",
            "source_and_command",
            "coverage_checks",
            "headline_results",
            "anomalies",
            "supported_conclusions",
            "unsupported_conclusions",
            "recommended_actions",
        ],
    }


def job_analysis_prompt(job: Mapping[str, Any]) -> str:
    return f"""Inspect and interpret frozen experiment run {job['run_id']}.

Read the run manifest at {Path(job['state_dir']) / 'run.json'}, the status and logs in
{job['state_dir']}, the frozen source at {job['worktree']}, and any artifacts in
{job['results_dir']} and {job['checkpoints_dir']}.

First verify the exit status, completion marker, expected groups/rows/artifacts, malformed or
zero-byte files, and whether the run is actually complete. Do not infer completion merely from
a nonempty output file. Identify the exact source SHA and command, headline metrics and
uncertainty, comparison with any clearly identified prior comparable output, anomalies that
could invalidate interpretation, supported conclusions, unsupported conclusions, and concrete
next actions. Do not modify files, relaunch work, stop processes, or delete outputs. Return only
the requested structured result.
"""


def job_analysis_command(job: Mapping[str, Any]) -> list[str]:
    codex = job.get("tools", {}).get("codex") or login_which("codex")
    if not codex:
        raise CodexRemoteError("Codex is unavailable for analysis", code="REMOTE_PREREQUISITES_MISSING")
    state_dir = Path(job["state_dir"])
    command = [codex, "--ask-for-approval", "never", "exec", "--json", "--sandbox", "read-only"]
    command.extend(["--output-schema", str(state_dir / "analysis-schema.json")])
    command.extend(["--output-last-message", str(state_dir / "analysis.json")])
    if job.get("model"):
        command.extend(["--model", job["model"]])
    if job.get("profile"):
        command.extend(["--profile", job["profile"]])
    if job.get("reasoning_effort"):
        command.extend(["--config", f"model_reasoning_effort={job['reasoning_effort']}"])
    command.extend(
        [
            "--config",
            "developer_instructions="
            + json.dumps(
                "Analyze this completed experiment read-only. Do not edit files, start or stop "
                "jobs, use network search, or claim completion without checking the manifest, "
                "exit status, completion marker, and artifact coverage."
            ),
            "-",
        ]
    )
    return command


def render_job_analysis(value: Mapping[str, Any], run_id: str) -> str:
    sections = [f"# Experiment analysis: {run_id}", ""]
    sections.append(f"**Run complete:** {'yes' if value.get('run_complete') else 'no'}")
    sections.extend(["", "## Summary", "", str(value.get("summary") or "")])
    sections.extend(["", "## Source and command", "", str(value.get("source_and_command") or "")])
    for heading, key in (
        ("Coverage checks", "coverage_checks"),
        ("Headline results", "headline_results"),
        ("Anomalies", "anomalies"),
        ("Supported conclusions", "supported_conclusions"),
        ("Unsupported conclusions", "unsupported_conclusions"),
        ("Recommended actions", "recommended_actions"),
    ):
        sections.extend(["", f"## {heading}", ""])
        items = value.get(key) or []
        if items:
            sections.extend(f"- {item}" for item in items)
        else:
            sections.append("- None identified.")
    return "\n".join(sections).rstrip() + "\n"


def server_job_analyze(project_id: str, run_id: str) -> int:
    paths = ensure_server_layout(project_id)
    job = load_server_job(paths, run_id)
    if not job:
        raise CodexRemoteError("Job not found", code="JOB_NOT_FOUND")
    state_dir = Path(job["state_dir"])
    analysis = dict(job.get("analysis") or {})
    analysis["state"] = "RUNNING"
    analysis["started_at"] = utc_now()
    analysis["runner_pid"] = os.getpid()
    job["analysis"] = analysis
    save_server_job(paths, job)
    try:
        atomic_write_json(state_dir / "analysis-schema.json", job_analysis_schema())
        # A failed rerun must never be mistaken for the structured output from
        # an earlier successful analysis attempt.
        for stale_name in ("analysis.json", "analysis.md"):
            with contextlib.suppress(FileNotFoundError):
                (state_dir / stale_name).unlink()
        command = job_analysis_command(job)
        with (state_dir / "analysis.jsonl").open("w", encoding="utf-8") as out, (
            state_dir / "analysis.stderr.log"
        ).open("w", encoding="utf-8") as err:
            completed = subprocess.run(
                command,
                cwd=Path(job["worktree"]),
                input=job_analysis_prompt(job),
                stdout=out,
                stderr=err,
                text=True,
                check=False,
            )
        value = read_json(state_dir / "analysis.json")
        if completed.returncode != 0 or not isinstance(value, dict):
            raise CodexRemoteError(
                f"Codex analysis exited {completed.returncode} without valid structured output",
                code="JOB_ANALYSIS_FAILED",
            )
        atomic_write_text(state_dir / "analysis.md", render_job_analysis(value, run_id))
        analysis.update(
            {
                "state": "SUCCEEDED",
                "exit_code": completed.returncode,
                "finished_at": utc_now(),
                "analysis_json": str(state_dir / "analysis.json"),
                "analysis_markdown": str(state_dir / "analysis.md"),
            }
        )
        job["analysis"] = analysis
        save_server_job(paths, job)
        return 0
    except Exception as exc:
        analysis.update(
            {
                "state": "FAILED",
                "error": str(exc),
                "finished_at": utc_now(),
            }
        )
        job["analysis"] = analysis
        save_server_job(paths, job)
        return 1


def server_job_summarize(project_id: str, run_id: str) -> dict[str, Any]:
    paths = ensure_server_layout(project_id)
    job = load_server_job(paths, run_id)
    if not job:
        raise CodexRemoteError(f"Job not found: {run_id}", code="JOB_NOT_FOUND")
    status = job_with_runtime_status(paths, job)
    if status.get("state") in JOB_ACTIVE_STATES:
        raise CodexRemoteError(
            "Wait until the experiment job is no longer active before interpreting it",
            code="JOB_ACTIVE",
            details=status,
        )
    analysis = dict(job.get("analysis") or {})
    if analysis.get("state") in {"STARTING", "RUNNING"}:
        return {"ok": True, "job": status, "analysis": analysis, "idempotent": True}
    tmux = job.get("tools", {}).get("tmux") or login_which("tmux")
    bash = job.get("tools", {}).get("bash") or login_which("bash")
    python3 = job.get("tools", {}).get("python3") or str(Path(sys.executable).resolve())
    if not tmux or not bash:
        raise CodexRemoteError("tmux or bash is unavailable", code="REMOTE_PREREQUISITES_MISSING")
    state_dir = Path(job["state_dir"])
    helper = state_dir / "codex-job-runner.py"
    current_helper = Path(__file__).resolve()
    current_helper_sha256 = sha256_file(current_helper)
    if not helper.exists() or sha256_file(helper) != current_helper_sha256:
        helper.write_bytes(current_helper.read_bytes())
        helper.chmod(0o700)
    job["runner_helper_sha256"] = current_helper_sha256
    session = f"analysis-{project_id[-9:]}-{run_id[-10:]}"
    runner_argv = [
        python3,
        str(helper),
        "_server-job-analyze",
        "--project-id",
        project_id,
        "--run-id",
        run_id,
    ]
    command = shlex.join([bash, "-lc", "exec " + shlex.join(runner_argv)])
    analysis = {
        "state": "STARTING",
        "created_at": utc_now(),
        "tmux_session": session,
        "runner_command": command,
    }
    job["analysis"] = analysis
    job = save_server_job(paths, job)
    run([tmux, "kill-session", "-t", session], check=False)
    try:
        run([tmux, "new-session", "-d", "-s", session, command])
        run([tmux, "set-option", "-t", session, "remain-on-exit", "on"])
    except Exception as exc:
        analysis.update(
            {
                "state": "FAILED",
                "error": f"Could not start Codex analysis runner: {exc}",
                "finished_at": utc_now(),
            }
        )
        job["analysis"] = analysis
        save_server_job(paths, job)
        raise
    return {"ok": True, "job": job, "analysis": analysis, "idempotent": False}


def server_job_analysis(project_id: str, run_id: str) -> dict[str, Any]:
    status = server_job_status(project_id, run_id)
    job = status["job"]
    state_dir = Path(job["state_dir"])
    text = (state_dir / "analysis.md").read_text(encoding="utf-8") if (state_dir / "analysis.md").is_file() else ""
    value = read_json(state_dir / "analysis.json")
    return {"ok": True, "job": job, "analysis": value, "markdown": text}


def server_cancel(project_id: str) -> dict[str, Any]:
    paths = ensure_server_layout(project_id)
    task = load_server_task(paths)
    if not task:
        raise CodexRemoteError("No task exists", code="TASK_NOT_FOUND")
    if task.get("state") not in ACTIVE_STATES:
        raise CodexRemoteError(
            f"Task is not active; current state is {task.get('state')}", code="TASK_NOT_ACTIVE", details=task
        )
    task["cancel_requested"] = True
    task["state"] = "CANCEL_REQUESTED"
    task = save_server_task(paths, task)
    pid = task.get("runner_pid")
    if pid:
        pid = int(pid)
        expected_boot = task.get("server_boot_id")
        expected_ticks = task.get("runner_start_ticks")
        actual_boot = linux_boot_id()
        actual_ticks = process_start_ticks(pid)
        if expected_boot and actual_boot and expected_boot != actual_boot:
            raise CodexRemoteError(
                "Server rebooted since this task started; refusing to signal a reused PID",
                code="STALE_RUNNER_PID",
                details=task,
            )
        if expected_ticks is not None and actual_ticks != expected_ticks:
            raise CodexRemoteError(
                "Runner PID no longer belongs to this task; refusing to signal it",
                code="STALE_RUNNER_PID",
                details=task,
            )
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    return {"ok": True, "task": task}


def server_mark_imported(project_id: str, task_id_value: str) -> dict[str, Any]:
    paths = ensure_server_layout(project_id)
    task = load_server_task(paths, task_id_value)
    if not task:
        raise CodexRemoteError("Task not found", code="TASK_NOT_FOUND")
    if task.get("state") not in RESULT_READY_STATES | {"NOOP", "CANCELLED_NOOP", "IMPORTED"}:
        raise CodexRemoteError(
            f"Task cannot be marked imported from state {task.get('state')}", code="TASK_NOT_READY"
        )
    task["state"] = "IMPORTED"
    task["imported_at"] = utc_now()
    task = save_server_task(paths, task)
    return {"ok": True, "task": task}


def server_clean(project_id: str, action: str) -> dict[str, Any]:
    paths = ensure_server_layout(project_id)
    task = load_server_task(paths)
    if not task:
        raise CodexRemoteError("No task exists", code="TASK_NOT_FOUND")
    if task.get("state") in ACTIVE_STATES:
        raise CodexRemoteError("Cannot clean an active task; cancel it first", code="TASK_ACTIVE")
    if action == "archive" and task.get("state") != "IMPORTED":
        raise CodexRemoteError(
            "Archive cleanup is allowed only after a successful import. Use explicit discard to abandon a result.",
            code="TASK_NOT_IMPORTED",
        )
    task = cleanup_server_task_artifacts(paths, task, action)
    return {"ok": True, "task": task}


def server_discard_stale(project_id: str, task_id_value: str) -> dict[str, Any]:
    """Explicitly discard a locally-known task when submission acknowledgement was lost."""
    validate_safe_id(task_id_value, "task id")
    paths = ensure_server_layout(project_id)
    current = load_server_task(paths)
    existing = load_server_task(paths, task_id_value)
    if existing:
        if existing.get("state") in ACTIVE_STATES:
            raise CodexRemoteError(
                f"Task {task_id_value} is active and cannot be discarded as stale",
                code="TASK_ACTIVE",
                details=existing,
            )
        return {"ok": True, "task": cleanup_server_task_artifacts(paths, existing, "discard")}
    if current and current.get("task_id") != task_id_value and task_outstanding(current):
        raise CodexRemoteError(
            "A different outstanding task exists; refusing stale cleanup",
            code="OUTSTANDING_TASK",
            details=current,
        )

    worktree = paths["worktrees"] / task_id_value
    if worktree.exists():
        removed = run(
            ["git", "--git-dir", paths["broker"], "worktree", "remove", "--force", str(worktree)],
            check=False,
        )
        if removed.returncode != 0 and worktree.exists():
            raise CommandError(
                ["git", "--git-dir", str(paths["broker"]), "worktree", "remove", "--force", str(worktree)],
                removed.returncode,
                removed.stdout,
                removed.stderr,
            )
    run(["git", "--git-dir", paths["broker"], "worktree", "prune"], check=False)
    input_ref = f"refs/codex/{project_id}/input/{task_id_value}"
    result_ref = f"refs/codex/{project_id}/result/{task_id_value}"
    checkpoint_ref = f"refs/codex/{project_id}/checkpoint/{task_id_value}"
    for ref in (input_ref, result_ref, checkpoint_ref):
        run(["git", "--git-dir", paths["broker"], "update-ref", "-d", ref], check=False)
    state_dir = paths["project_state"] / task_id_value
    state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    task = {
        "schema_version": SCHEMA_VERSION,
        "project_id": project_id,
        "task_id": task_id_value,
        "state": "DISCARDED",
        "input_ref": input_ref,
        "result_ref": result_ref,
        "worktree": str(worktree),
        "state_dir": str(state_dir),
        "discarded_at": utc_now(),
        "error": "Explicitly discarded after an unresolved/lost submission acknowledgement",
    }
    return {"ok": True, "task": save_server_task(paths, task)}


def internal_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--project-id", required=True)
    return parser


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    def add_common(command: argparse.ArgumentParser) -> None:
        command.add_argument("--project-root", required=True)
        command.add_argument("--host", required=True)
        command.add_argument("--remote-dir", required=True)
        command.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT)
        command.add_argument("--max-untracked-bytes", type=int, default=DEFAULT_MAX_UNTRACKED_BYTES)

    def add_task_options(command: argparse.ArgumentParser) -> None:
        command.add_argument("--bootstrap-cmd", default="")
        command.add_argument("--test-cmd", default="")
        command.add_argument("--data-link", action="append", default=[])
        command.add_argument("--model", default="")
        command.add_argument("--profile", default="")
        command.add_argument("--reasoning-effort", choices=sorted(SAFE_REASONING), default="")
        command.add_argument("--enable-search", action="store_true")
        command.add_argument(
            "--job-policy",
            choices=sorted(JOB_POLICIES),
            default="deny",
            help="whether Codex may prepare or request one frozen experiment launch",
        )

    doctor = sub.add_parser("doctor", help="verify local and remote prerequisites")
    add_common(doctor)
    add_task_options(doctor)

    start = sub.add_parser("start", help="start a durable remote Codex task")
    add_common(start)
    start.add_argument("--prompt-file", default="-")
    add_task_options(start)

    interactive = sub.add_parser(
        "interactive",
        help="start or reattach to a managed interactive Codex TUI",
    )
    add_common(interactive)
    add_task_options(interactive)

    status = sub.add_parser("status", help="show the current project task")
    add_common(status)

    logs = sub.add_parser("logs", help="show task logs")
    add_common(logs)
    logs.add_argument("--tail", type=int, default=300)

    apply_parser = sub.add_parser("apply", help="integrate and apply a completed result")
    add_common(apply_parser)
    apply_parser.add_argument("--allow-branch-change", action="store_true")
    apply_parser.add_argument("--preserve-local-branch", action="store_true")
    apply_parser.add_argument("--push-backup", action="store_true")
    apply_parser.add_argument("--backup-remote", default="origin")

    pull_parser = sub.add_parser(
        "pull",
        help="pull committed interactive checkpoints without stopping Codex",
    )
    add_common(pull_parser)
    pull_parser.add_argument("--allow-branch-change", action="store_true")

    cancel = sub.add_parser("cancel", help="request cancellation while preserving work")
    add_common(cancel)

    recover = sub.add_parser("recover", help="finalize a preserved orphaned worktree")
    add_common(recover)

    clean = sub.add_parser("clean", help="archive an imported task or explicitly discard it")
    add_common(clean)
    clean.add_argument("--discard", action="store_true")

    jobs = sub.add_parser("jobs", help="list frozen experiment jobs for this project")
    add_common(jobs)

    job_status_parser = sub.add_parser("job-status", help="show one frozen experiment job")
    add_common(job_status_parser)
    job_status_parser.add_argument("--run-id", required=True)

    job_logs_parser = sub.add_parser("job-logs", help="show logs for one experiment job")
    add_common(job_logs_parser)
    job_logs_parser.add_argument("--run-id", required=True)
    job_logs_parser.add_argument("--tail", type=int, default=400)

    job_stop_parser = sub.add_parser("job-stop", help="stop one active experiment job")
    add_common(job_stop_parser)
    job_stop_parser.add_argument("--run-id", required=True)

    job_summarize_parser = sub.add_parser(
        "job-summarize", help="start a read-only Codex interpretation of a finished job"
    )
    add_common(job_summarize_parser)
    job_summarize_parser.add_argument("--run-id", required=True)

    job_analysis_parser = sub.add_parser(
        "job-analysis", help="show the structured interpretation of a job"
    )
    add_common(job_analysis_parser)
    job_analysis_parser.add_argument("--run-id", required=True)

    install_agents = sub.add_parser(
        "install-agents", help="install/update the managed global AGENTS.md block on the server"
    )
    add_common(install_agents)

    server_init_parser = sub.add_parser("_server-init", parents=[internal_parser()])
    server_doctor_parser = sub.add_parser("_server-doctor", parents=[internal_parser()])
    server_status_parser = sub.add_parser("_server-status", parents=[internal_parser()])
    server_checkpoint_parser = sub.add_parser(
        "_server-checkpoint", parents=[internal_parser()]
    )
    server_checkpoint_parser.add_argument("--task-id", required=True)
    server_logs_parser = sub.add_parser("_server-logs", parents=[internal_parser()])
    server_logs_parser.add_argument("--tail", type=int, default=300)
    server_start_parser = sub.add_parser("_server-start", parents=[internal_parser()])
    server_start_parser.add_argument("--task-id", required=True)
    server_run_parser = sub.add_parser("_server-run", parents=[internal_parser()])
    server_run_parser.add_argument("--task-id", required=True)
    server_cancel_parser = sub.add_parser("_server-cancel", parents=[internal_parser()])
    server_recover_parser = sub.add_parser("_server-recover", parents=[internal_parser()])
    server_imported_parser = sub.add_parser("_server-mark-imported", parents=[internal_parser()])
    server_imported_parser.add_argument("--task-id", required=True)
    server_clean_parser = sub.add_parser("_server-clean", parents=[internal_parser()])
    server_clean_parser.add_argument("--action", choices=("archive", "discard"), required=True)
    server_stale_parser = sub.add_parser("_server-discard-stale", parents=[internal_parser()])
    server_stale_parser.add_argument("--task-id", required=True)
    job_request_parser = sub.add_parser("_job-request")
    job_request_parser.add_argument("--request-file", required=True)
    job_request_parser.add_argument("--response-file", default="")
    job_request_parser.add_argument("--wait-seconds", type=int, default=0)
    job_request_parser.add_argument("--name", required=True)
    job_request_parser.add_argument("--gpus", default="")
    job_request_parser.add_argument("--completion-marker", default="")
    job_request_parser.add_argument("--resume-command", default="")
    job_request_parser.add_argument("--metadata", action="append", default=[])
    job_request_parser.add_argument("job_command", nargs=argparse.REMAINDER)
    env_request_parser = sub.add_parser("_env-request")
    env_request_parser.add_argument("--request-file", required=True)
    env_request_parser.add_argument("--response-file", required=True)
    env_request_parser.add_argument("--wait-seconds", type=int, default=1800)
    env_request_parser.add_argument("--action", choices=sorted(ENV_ACTIONS), required=True)
    server_job_request_parser = sub.add_parser("_server-request-job")
    server_job_request_parser.add_argument("--project-id", required=True)
    server_job_request_parser.add_argument("--task-id", required=True)
    server_job_request_parser.add_argument("--name", required=True)
    server_job_request_parser.add_argument("--gpus", default="")
    server_job_request_parser.add_argument("--completion-marker", default="")
    server_job_request_parser.add_argument("--resume-command", default="")
    server_job_request_parser.add_argument("--metadata", action="append", default=[])
    server_job_request_parser.add_argument("job_command", nargs=argparse.REMAINDER)
    sub.add_parser("_server-jobs", parents=[internal_parser()])
    internal_job_status = sub.add_parser("_server-job-status", parents=[internal_parser()])
    internal_job_status.add_argument("--run-id", required=True)
    internal_job_logs = sub.add_parser("_server-job-logs", parents=[internal_parser()])
    internal_job_logs.add_argument("--run-id", required=True)
    internal_job_logs.add_argument("--tail", type=int, default=400)
    internal_job_stop = sub.add_parser("_server-job-stop", parents=[internal_parser()])
    internal_job_stop.add_argument("--run-id", required=True)
    internal_job_summarize = sub.add_parser("_server-job-summarize", parents=[internal_parser()])
    internal_job_summarize.add_argument("--run-id", required=True)
    internal_job_analysis = sub.add_parser("_server-job-analysis", parents=[internal_parser()])
    internal_job_analysis.add_argument("--run-id", required=True)
    internal_job_run = sub.add_parser("_server-job-run", parents=[internal_parser()])
    internal_job_run.add_argument("--run-id", required=True)
    internal_job_analyze = sub.add_parser("_server-job-analyze", parents=[internal_parser()])
    internal_job_analyze.add_argument("--run-id", required=True)
    sub.add_parser("_server-install-agents", parents=[internal_parser()])
    return parser


def dispatch(args: argparse.Namespace) -> dict[str, Any] | int:
    if args.command == "doctor":
        return cmd_doctor(args)
    if args.command == "start":
        return cmd_start(args)
    if args.command == "interactive":
        return cmd_interactive(args)
    if args.command == "status":
        return cmd_status(args)
    if args.command == "logs":
        return cmd_logs(args)
    if args.command == "apply":
        return cmd_apply(args)
    if args.command == "pull":
        return cmd_pull(args)
    if args.command == "cancel":
        return cmd_cancel(args)
    if args.command == "recover":
        return cmd_recover(args)
    if args.command == "clean":
        return cmd_clean(args)
    if args.command == "jobs":
        return cmd_jobs(args)
    if args.command == "job-status":
        return cmd_job_status(args)
    if args.command == "job-logs":
        return cmd_job_logs(args)
    if args.command == "job-stop":
        return cmd_job_stop(args)
    if args.command == "job-summarize":
        return cmd_job_summarize(args)
    if args.command == "job-analysis":
        return cmd_job_analysis(args)
    if args.command == "install-agents":
        return cmd_install_agents(args)
    if args.command == "_server-init":
        return server_init(args.project_id)
    if args.command == "_server-doctor":
        return server_doctor(args.project_id)
    if args.command == "_server-status":
        return server_status(args.project_id)
    if args.command == "_server-checkpoint":
        return server_checkpoint(args.project_id, args.task_id)
    if args.command == "_server-logs":
        return server_logs(args.project_id, args.tail)
    if args.command == "_server-start":
        return server_start(args.project_id, args.task_id, read_json_stdin())
    if args.command == "_server-run":
        return server_run(args.project_id, args.task_id)
    if args.command == "_server-cancel":
        return server_cancel(args.project_id)
    if args.command == "_server-recover":
        return server_recover(args.project_id)
    if args.command == "_server-mark-imported":
        return server_mark_imported(args.project_id, args.task_id)
    if args.command == "_server-clean":
        return server_clean(args.project_id, args.action)
    if args.command == "_server-discard-stale":
        return server_discard_stale(args.project_id, args.task_id)
    if args.command == "_job-request":
        command = list(args.job_command)
        if command and command[0] == "--":
            command.pop(0)
        return request_job_file(
            Path(args.request_file),
            name=args.name,
            command=command,
            gpus=args.gpus,
            completion_marker=args.completion_marker,
            resume_command=args.resume_command,
            metadata_values=args.metadata,
            response_file=Path(args.response_file) if args.response_file else None,
            wait_seconds=args.wait_seconds,
        )
    if args.command == "_env-request":
        return request_env_action_file(
            Path(args.request_file),
            Path(args.response_file),
            action=args.action,
            wait_seconds=args.wait_seconds,
        )
    if args.command == "_server-request-job":
        command = list(args.job_command)
        if command and command[0] == "--":
            command.pop(0)
        request = job_request_from_arguments(
            name=args.name,
            command=command,
            gpus=args.gpus,
            completion_marker=args.completion_marker,
            resume_command=args.resume_command,
            metadata_values=args.metadata,
        )
        return server_request_job(args.project_id, args.task_id, request)
    if args.command == "_server-jobs":
        return server_jobs(args.project_id)
    if args.command == "_server-job-status":
        return server_job_status(args.project_id, args.run_id)
    if args.command == "_server-job-logs":
        return server_job_logs(args.project_id, args.run_id, args.tail)
    if args.command == "_server-job-stop":
        return server_job_stop(args.project_id, args.run_id)
    if args.command == "_server-job-summarize":
        return server_job_summarize(args.project_id, args.run_id)
    if args.command == "_server-job-analysis":
        return server_job_analysis(args.project_id, args.run_id)
    if args.command == "_server-job-run":
        return server_job_run(args.project_id, args.run_id)
    if args.command == "_server-job-analyze":
        return server_job_analyze(args.project_id, args.run_id)
    if args.command == "_server-install-agents":
        return server_install_agents(args.project_id, read_json_stdin())
    raise CodexRemoteError(f"Unknown command: {args.command}", code="INVALID_COMMAND")


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    try:
        result = dispatch(args)
        if isinstance(result, int):
            raise SystemExit(result)
        emit(result)
    except CodexRemoteError as exc:
        emit(
            {
                "ok": False,
                "error": str(exc),
                "error_code": exc.code,
                "details": exc.details,
            },
            exit_code=2,
        )
    except KeyboardInterrupt:
        emit({"ok": False, "error": "Interrupted", "error_code": "INTERRUPTED"}, exit_code=130)
    except SystemExit:
        raise
    except Exception as exc:
        emit(
            {
                "ok": False,
                "error": str(exc),
                "error_code": "UNEXPECTED_ERROR",
                "details": traceback.format_exc(),
            },
            exit_code=3,
        )


if __name__ == "__main__":
    main()

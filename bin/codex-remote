class CodexRemoteError(RuntimeError):
    """Expected, user-actionable failure."""

    def __init__(self, message: str, *, code: str = "ERROR", details: Any = None):
        super().__init__(message)
        self.code = code
        self.details = details


class CommandError(CodexRemoteError):
    """A subprocess returned nonzero or timed out."""

    def __init__(
        self,
        argv: Sequence[str],
        returncode: int | None,
        stdout: str = "",
        stderr: str = "",
        *,
        timed_out: bool = False,
    ):
        rendered = shlex.join([str(x) for x in argv])
        if timed_out:
            message = f"Command timed out: {rendered}"
            code = "TIMEOUT"
        else:
            detail = stderr.strip() or stdout.strip() or "no diagnostic output"
            message = f"Command failed ({returncode}): {rendered}\n{detail}"
            code = "COMMAND_FAILED"
        super().__init__(message, code=code)
        self.argv = list(argv)
        self.returncode = returncode
        self.stdout = stdout
        self.stderr = stderr
        self.timed_out = timed_out


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")


def emit(payload: Mapping[str, Any], *, exit_code: int = 0) -> None:
    print(json.dumps(payload, sort_keys=True, ensure_ascii=False))
    raise SystemExit(exit_code)


def read_json_stdin() -> dict[str, Any]:
    try:
        value = json.load(sys.stdin)
    except json.JSONDecodeError as exc:
        raise CodexRemoteError(f"Invalid JSON input: {exc}", code="INVALID_JSON") from exc
    if not isinstance(value, dict):
        raise CodexRemoteError("Expected a JSON object on stdin", code="INVALID_JSON")
    return value


def atomic_write_json(path: Path, value: Mapping[str, Any], mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    tmp = Path(tmp_name)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, sort_keys=True, indent=2, ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            tmp.unlink()


def atomic_write_text(path: Path, value: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    tmp = Path(tmp_name)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(value)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            tmp.unlink()


def read_json(path: Path) -> dict[str, Any] | None:
    try:
        with path.open("r", encoding="utf-8") as handle:
            value = json.load(handle)
    except FileNotFoundError:
        return None
    except json.JSONDecodeError as exc:
        raise CodexRemoteError(f"Corrupt state file {path}: {exc}", code="CORRUPT_STATE") from exc
    if not isinstance(value, dict):
        raise CodexRemoteError(f"State file is not a JSON object: {path}", code="CORRUPT_STATE")
    return value


def sha256_file(path: Path) -> str | None:
    if not path.is_file():
        return None
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def run(
    argv: Sequence[str | os.PathLike[str]],
    *,
    cwd: Path | str | None = None,
    env: Mapping[str, str] | None = None,
    input_data: str | bytes | None = None,
    timeout: int | float | None = None,
    check: bool = True,
    text: bool | None = None,
) -> subprocess.CompletedProcess[Any]:
    args = [os.fspath(item) for item in argv]
    if text is None:
        text = not isinstance(input_data, bytes)
    try:
        completed = subprocess.run(
            args,
            cwd=os.fspath(cwd) if cwd is not None else None,
            env=dict(env) if env is not None else None,
            input=input_data,
            stdin=subprocess.DEVNULL if input_data is None else None,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
            text=text,
        )
    except subprocess.TimeoutExpired as exc:
        stdout = exc.stdout.decode(errors="replace") if isinstance(exc.stdout, bytes) else (exc.stdout or "")
        stderr = exc.stderr.decode(errors="replace") if isinstance(exc.stderr, bytes) else (exc.stderr or "")
        raise CommandError(args, None, stdout, stderr, timed_out=True) from exc
    except OSError as exc:
        raise CodexRemoteError(f"Could not execute {args[0]}: {exc}", code="EXEC_FAILED") from exc
    if check and completed.returncode != 0:
        stdout = completed.stdout.decode(errors="replace") if isinstance(completed.stdout, bytes) else completed.stdout
        stderr = completed.stderr.decode(errors="replace") if isinstance(completed.stderr, bytes) else completed.stderr
        raise CommandError(args, completed.returncode, stdout or "", stderr or "")
    return completed


def git(root: Path, *args: str, **kwargs: Any) -> subprocess.CompletedProcess[Any]:
    return run(["git", "-C", root, *args], **kwargs)


def git_dir_path(root: Path, name: str) -> Path:
    value = git(root, "rev-parse", "--git-path", name).stdout.strip()
    return (root / value).resolve() if not os.path.isabs(value) else Path(value)


def repository_root(path: str | os.PathLike[str]) -> Path:
    candidate = Path(path).expanduser().resolve()
    completed = run(["git", "-C", candidate, "rev-parse", "--show-toplevel"])
    return Path(completed.stdout.strip()).resolve()


def common_git_dir(root: Path) -> Path:
    value = git(root, "rev-parse", "--git-common-dir").stdout.strip()
    path = Path(value)
    if not path.is_absolute():
        path = root / path
    return path.resolve()


def current_branch(root: Path) -> str | None:
    completed = git(root, "symbolic-ref", "--quiet", "--short", "HEAD", check=False)
    return completed.stdout.strip() if completed.returncode == 0 else None


def current_head(root: Path) -> str:
    return git(root, "rev-parse", "HEAD").stdout.strip()


def index_tree(root: Path) -> str:
    return git(root, "write-tree").stdout.strip()


def validate_safe_id(value: str, label: str) -> str:
    if not SAFE_ID_RE.fullmatch(value):
        raise CodexRemoteError(f"Unsafe {label}: {value!r}", code="INVALID_IDENTIFIER")
    return value


def validate_remote_host(value: str) -> str:
    if not SAFE_SSH_HOST_RE.fullmatch(value):
        raise CodexRemoteError(
            f"Unsafe SSH host/alias: {value!r}. Use a normal SSH config alias or user@host value.",
            code="INVALID_REMOTE_HOST",
        )
    return value


def validate_remote_dir(value: str) -> str:
    if not value or "\0" in value or "\n" in value or "\r" in value:
        raise CodexRemoteError("Invalid normal remote project directory", code="INVALID_REMOTE_DIR")
    if not value.startswith("/"):
        raise CodexRemoteError(
            "The normal remote project directory must be an absolute server path",
            code="INVALID_REMOTE_DIR",
        )
    return value


def project_identity(root: Path, host: str, remote_dir: str) -> tuple[str, str]:
    common = common_git_dir(root)
    material = "\0".join((str(common), host, remote_dir)).encode("utf-8")
    suffix = hashlib.sha256(material).hexdigest()[:12]
    base = re.sub(r"[^A-Za-z0-9._-]+", "-", root.name).strip("-._") or "project"
    project_id = f"{base[:48]}-{suffix}"
    return project_id, base


def ensure_git_idle(root: Path) -> None:
    operation_markers = {
        "MERGE_HEAD": "merge",
        "CHERRY_PICK_HEAD": "cherry-pick",
        "REVERT_HEAD": "revert",
        "BISECT_LOG": "bisect",
        "rebase-merge": "rebase",
        "rebase-apply": "rebase/git-am",
        "sequencer": "sequencer operation",
    }
    active = []
    for marker, description in operation_markers.items():
        if git_dir_path(root, marker).exists():
            active.append(description)
    if active:
        raise CodexRemoteError(
            "Git operation in progress: " + ", ".join(sorted(set(active))),
            code="GIT_OPERATION_IN_PROGRESS",
        )
    unmerged = git(root, "ls-files", "-u").stdout.strip()
    if unmerged:
        raise CodexRemoteError("The local index contains unmerged entries", code="UNMERGED_INDEX")


def ensure_no_submodules(root: Path) -> None:
    gitmodules = root / ".gitmodules"
    if gitmodules.exists():
        names = git(root, "config", "--file", str(gitmodules), "--get-regexp", r"^submodule\..*\.path$", check=False)
        detail = names.stdout.strip() or ".gitmodules is present"
        raise CodexRemoteError(
            "Version 1 does not transport submodule worktrees. Remove/flatten submodules or handle them outside this workflow.\n"
            + detail,
            code="SUBMODULES_UNSUPPORTED",
        )


def nul_paths(output: str) -> list[str]:
    if not output:
        return []
    return [item for item in output.split("\0") if item]


def untracked_paths(root: Path) -> list[str]:
    completed = git(root, "ls-files", "--others", "--exclude-standard", "-z")
    return nul_paths(completed.stdout)


def path_is_secret(relative: str) -> bool:
    path = PurePosixPath(relative.replace(os.sep, "/"))
    lower_parts = [part.lower() for part in path.parts]
    basename = path.name.lower()
    placeholder_suffixes = (".example", ".sample", ".template", ".dist")
    placeholder_document = basename.endswith(placeholder_suffixes)
    secret_document = not placeholder_document and (
        basename == ".env"
        or basename.startswith(".env.")
        or basename == "credentials"
        or basename.startswith("credentials.")
        or basename == "secrets"
        or basename.startswith("secrets.")
    )
    if (
        secret_document
        or basename in SECRET_BASENAMES
        or any(basename.endswith(suffix) for suffix in SECRET_SUFFIXES)
    ):
        return True
    sensitive_parts = {".aws", ".gnupg", ".ssh", "secrets", "credentials"}
    return any(part in sensitive_parts for part in lower_parts)


def path_is_generated(relative: str) -> bool:
    path = PurePosixPath(relative.replace(os.sep, "/"))
    parts = tuple(part for part in path.parts if part not in {"", "."})
    if not parts:
        return False
    lower = tuple(part.lower() for part in parts)
    if any(part in GENERATED_ANYWHERE_PARTS for part in lower):
        return True
    first = lower[0]
    return (
        first in GENERATED_ROOT_PARTS
        or first == "result"
        or first.startswith("result-")
    )


def safe_relative_symlink(relative: str, target: str) -> bool:
    """Return whether TARGET stays lexically inside the repository.

    Git stores a symlink's target text rather than dereferencing it.  Internal
    relative links are therefore safe to transport, while absolute links and
    links that walk above the repository are rejected because they would point
    somewhere different on the server.
    """
    target_path = PurePosixPath(target.replace(os.sep, "/"))
    if target_path.is_absolute():
        return False
    stack: list[str] = []
    for part in (PurePosixPath(relative).parent / target_path).parts:
        if part in {"", "."}:
            continue
        if part == "..":
            if not stack:
                return False
            stack.pop()
        else:
            stack.append(part)
    return True


def inspect_untracked(root: Path, max_bytes: int) -> list[dict[str, Any]]:
    unsafe: list[dict[str, Any]] = []
    for relative in untracked_paths(root):
        absolute = root / relative
        try:
            info = absolute.lstat()
        except FileNotFoundError:
            continue
        if stat.S_ISLNK(info.st_mode):
            target = os.readlink(absolute)
            if path_is_secret(relative):
                unsafe.append({"path": relative, "reason": "secret-like filename"})
            elif path_is_generated(relative):
                unsafe.append({"path": relative, "reason": "generated/cache/output path is not ignored"})
            elif not safe_relative_symlink(relative, target):
                unsafe.append({"path": relative, "reason": f"symlink escapes repository: {target}"})
            continue
        if not stat.S_ISREG(info.st_mode):
            unsafe.append({"path": relative, "reason": "non-regular untracked file"})
            continue
        if path_is_secret(relative):
            unsafe.append({"path": relative, "reason": "secret-like filename"})
        elif path_is_generated(relative):
            unsafe.append({"path": relative, "reason": "generated/cache/output path is not ignored"})
        elif info.st_size > max_bytes:
            unsafe.append(
                {
                    "path": relative,
                    "reason": f"untracked file is {info.st_size} bytes (limit {max_bytes})",
                }
            )
    return unsafe


def ensure_safe_untracked(root: Path, max_bytes: int) -> None:
    unsafe = inspect_untracked(root, max_bytes)
    if unsafe:
        lines = "\n".join(f"  {item['path']}: {item['reason']}" for item in unsafe[:30])
        more = "\n  ..." if len(unsafe) > 30 else ""
        raise CodexRemoteError(
            "Unsafe nonignored untracked files block the snapshot:\n" + lines + more,
            code="UNSAFE_UNTRACKED",
            details=unsafe,
        )


def changed_paths(root: Path, *, include_untracked: bool = True) -> list[str]:
    tracked = nul_paths(git(root, "diff", "--name-only", "-z", "HEAD", "--").stdout)
    if include_untracked:
        tracked.extend(untracked_paths(root))
    return sorted(set(tracked))


def ensure_no_changed_lfs_paths(root: Path, *, include_untracked: bool = True) -> None:
    paths = changed_paths(root, include_untracked=include_untracked)
    if not paths:
        return
    lfs_paths: list[str] = []
    # check-attr emits path NUL attr NUL value NUL for each path.
    completed = git(root, "check-attr", "-z", "filter", "--", *paths)
    fields = nul_paths(completed.stdout)
    for index in range(0, len(fields), 3):
        if index + 2 < len(fields) and fields[index + 1] == "filter" and fields[index + 2] == "lfs":
            lfs_paths.append(fields[index])
    if lfs_paths:
        raise CodexRemoteError(
            "Version 1 does not transport modified Git LFS objects to the private broker. "
            "Commit/push those objects through an LFS-capable remote or keep them outside the Codex task.\n  "
            + "\n  ".join(lfs_paths),
            code="LFS_CHANGES_UNSUPPORTED",
            details=lfs_paths,
        )


def result_changed_paths(root: Path, old: str, new: str) -> list[str]:
    completed = git(
        root,
        "diff",
        "--name-only",
        "--diff-filter=ACMRTUXB",
        "-z",
        old,
        new,
        "--",
    )
    return nul_paths(completed.stdout)


def tree_entry(root: Path, commit: str, relative: str) -> tuple[str, str, str] | None:
    """Return (mode, type, object id) for RELATIVE in COMMIT."""
    completed = git(root, "ls-tree", "-z", commit, "--", relative)
    if not completed.stdout:
        return None
    record = completed.stdout.split("\0", 1)[0]
    try:
        metadata, returned_path = record.split("\t", 1)
        mode, object_type, object_id = metadata.split(" ", 2)
    except ValueError as exc:
        raise CodexRemoteError(
            f"Could not inspect result tree entry for {relative}", code="RESULT_INSPECTION_FAILED"
        ) from exc
    if returned_path != relative:
        raise CodexRemoteError(
            f"Result tree returned unexpected path {returned_path!r} for {relative!r}",
            code="RESULT_INSPECTION_FAILED",
        )
    return mode, object_type, object_id


def inspect_tree_delta(root: Path, old: str, new: str, max_bytes: int) -> list[dict[str, Any]]:
    """Inspect the net tree delta OLD..NEW for unsafe paths or blobs."""
    unsafe: list[dict[str, Any]] = []
    paths = result_changed_paths(root, old, new)
    if paths:
        completed = git(root, "check-attr", "-z", "filter", "--", *paths)
        fields = nul_paths(completed.stdout)
        lfs_paths = {
            fields[index]
            for index in range(0, len(fields), 3)
            if index + 2 < len(fields)
            and fields[index + 1] == "filter"
            and fields[index + 2] == "lfs"
        }
    else:
        lfs_paths = set()

    for relative in paths:
        if relative in lfs_paths:
            unsafe.append({"path": relative, "reason": "modified Git LFS path"})
            continue
        if path_is_secret(relative):
            unsafe.append({"path": relative, "reason": "secret-like filename"})
            continue
        if path_is_generated(relative):
            unsafe.append({"path": relative, "reason": "generated/cache/output path"})
            continue
        entry = tree_entry(root, new, relative)
        if entry is None:
            continue
        mode, object_type, object_id = entry
        if object_type != "blob":
            unsafe.append({"path": relative, "reason": f"unsupported Git object type {object_type}"})
            continue
        size = int(git(root, "cat-file", "-s", object_id).stdout.strip())
        if size > max_bytes:
            unsafe.append(
                {
                    "path": relative,
                    "reason": f"result blob is {size} bytes (limit {max_bytes})",
                }
            )
            continue
        if mode == "120000":
            target_bytes = run(
                ["git", "-C", root, "cat-file", "blob", object_id],
                text=False,
            ).stdout
            target = target_bytes.decode("utf-8", errors="surrogateescape")
            if not safe_relative_symlink(relative, target):
                unsafe.append({"path": relative, "reason": f"symlink escapes repository: {target}"})
        elif not mode.startswith("100"):
            unsafe.append({"path": relative, "reason": f"unsupported Git mode {mode}"})
    return unsafe


def inspect_result_delta(root: Path, old: str, new: str, max_bytes: int) -> list[dict[str, Any]]:
    """Inspect every committed state in OLD..NEW, not only the final tree.

    Codex may create and later delete an unsafe file in intermediate commits.
    Such an object would otherwise remain reachable from the result history and
    could be fetched even though the final tree looked harmless.
    """
    if git(root, "merge-base", "--is-ancestor", old, new, check=False).returncode != 0:
        return [{"path": "(history)", "reason": "result is not descended from input"}]
    commits = [
        line.strip()
        for line in git(root, "rev-list", "--reverse", f"{old}..{new}").stdout.splitlines()
        if line.strip()
    ]
    unsafe: list[dict[str, Any]] = []
    seen: set[tuple[str, str]] = set()
    for commit in commits:
        for item in inspect_tree_delta(root, old, commit, max_bytes):
            key = (str(item["path"]), str(item["reason"]))
            if key in seen:
                continue
            seen.add(key)
            annotated = dict(item)
            annotated["commit"] = commit
            unsafe.append(annotated)
    return unsafe


def ensure_safe_result_delta(root: Path, old: str, new: str, max_bytes: int) -> None:
    unsafe = inspect_result_delta(root, old, new, max_bytes)
    if unsafe:
        lines = "\n".join(f"  {item['path']}: {item['reason']}" for item in unsafe[:30])
        more = "\n  ..." if len(unsafe) > 30 else ""
        raise CodexRemoteError(
            "Unsafe files in the committed Codex result block publication:\n" + lines + more,
            code="UNSAFE_RESULT",
            details=unsafe,
        )


def snapshot_tree_only(root: Path) -> str:
    with tempfile.TemporaryDirectory(prefix="codex-remote-index-") as temp_dir:
        temp_index = Path(temp_dir) / "index"
        env = os.environ.copy()
        env["GIT_INDEX_FILE"] = str(temp_index)
        git(root, "read-tree", "HEAD", env=env)
        git(root, "add", "-A", "--", ".", env=env)
        return git(root, "write-tree", env=env).stdout.strip()


def create_hidden_snapshot(
    root: Path,
    ref: str,
    message: str,
    *,
    include_untracked: bool = True,
) -> dict[str, str]:
    """Create a hidden commit without touching the visible checkout.

    One-shot tasks keep their historical behavior and may include safety-checked
    untracked source files. Managed interactive tasks pass ``include_untracked=False``:
    their input contains the exact tracked working-tree state, while every untracked
    path remains private to the laptop and invisible to Codex.
    """
    head = current_head(root)
    with tempfile.TemporaryDirectory(prefix="codex-remote-index-") as temp_dir:
        temp_index = Path(temp_dir) / "index"
        env = os.environ.copy()
        env["GIT_INDEX_FILE"] = str(temp_index)
        env.setdefault("GIT_AUTHOR_NAME", "Codex Remote")
        env.setdefault("GIT_AUTHOR_EMAIL", "codex-remote@localhost")
        env.setdefault("GIT_COMMITTER_NAME", "Codex Remote")
        env.setdefault("GIT_COMMITTER_EMAIL", "codex-remote@localhost")
        git(root, "read-tree", "HEAD", env=env)
        git(
            root,
            "add",
            "-A" if include_untracked else "-u",
            "--",
            ".",
            env=env,
        )
        tree = git(root, "write-tree", env=env).stdout.strip()
        commit = git(
            root,
            "commit-tree",
            tree,
            "-p",
            head,
            env=env,
            input_data=message.rstrip() + "\n",
        ).stdout.strip()
        git(root, "update-ref", ref, commit)
        return {"commit": commit, "tree": tree, "head": head, "index_tree": index_tree(root)}


def verify_fingerprint(root: Path, fingerprint: Mapping[str, str]) -> None:
    now_head = current_head(root)
    now_index = index_tree(root)
    now_tree = snapshot_tree_only(root)
    changed = []
    if now_head != fingerprint["head"]:
        changed.append("HEAD")
    if now_index != fingerprint["index_tree"]:
        changed.append("index/staging area")
    if now_tree != fingerprint["tree"]:
        changed.append("working tree")
    if changed:
        raise CodexRemoteError(
            "The canonical checkout changed while integration was being computed: " + ", ".join(changed),
            code="LOCAL_STATE_CHANGED",
        )


def file_hashes(root: Path) -> dict[str, str | None]:
    return {
        "flake.lock": sha256_file(root / "flake.lock"),
        "uv.lock": sha256_file(root / "uv.lock"),
    }


def changed_lock_files(task: Mapping[str, Any], root: Path) -> tuple[dict[str, str | None], list[str]]:
    before = task.get("lock_hashes") or {}
    after = file_hashes(root)
    changed = [name for name, digest in after.items() if before.get(name) != digest]
    return after, changed


def ssh_argv(host: str, timeout: int, remote_command: str) -> list[str]:
    return [
        "ssh",
        "-o",
        "BatchMode=yes",
        "-o",
        f"ConnectTimeout={timeout}",
        "-o",
        "ConnectionAttempts=1",
        host,
        remote_command,
    ]


def ssh_run(
    host: str,
    remote_args: Sequence[str],
    *,
    timeout: int,
    input_data: str | bytes | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess[Any]:
    command = shlex.join([str(item) for item in remote_args])
    return run(
        ssh_argv(host, timeout, command),
        input_data=input_data,
        timeout=max(timeout + 2, 10),
        check=check,
    )


def ssh_login_shell(
    host: str,
    script: str,
    *,
    timeout: int,
    input_data: str | bytes | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess[Any]:
    return ssh_run(
        host,
        ["bash", "-lc", script],
        timeout=timeout,
        input_data=input_data,
        check=check,
    )


def ensure_remote_helper(host: str, timeout: int) -> dict[str, str]:
    # Prefer a sufficiently new explicitly-versioned interpreter over an old
    # system `python3` commonly found on long-lived RHEL installations.
    probe_script = r"""set -eu
py=""
for name in python3.14 python3.13 python3.12 python3.11 python3.10 python3; do
  candidate="$(type -P "$name" 2>/dev/null || true)"
  if [ -n "$candidate" ] && "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 10))'; then
    py="$candidate"
    break
  fi
done
[ -n "$py" ] || { echo '__CODEX_REMOTE_NO_PYTHON__' >&2; exit 42; }
printf '__CODEX_REMOTE_PY__%s\n' "$py"
"$py" -c 'import sys; print("__CODEX_REMOTE_PYVER__" + ".".join(map(str, sys.version_info[:3])))'
printf '__CODEX_REMOTE_HOME__%s\n' "$HOME"
"$py" -c 'import hashlib,pathlib; p=pathlib.Path.home()/".local/libexec/codex-remote"; print("__CODEX_REMOTE_HELPER_SHA__" + (hashlib.sha256(p.read_bytes()).hexdigest() if p.is_file() else ""))'
"""
    try:
        probe = ssh_login_shell(host, probe_script, timeout=timeout)
    except CommandError as exc:
        if "__CODEX_REMOTE_NO_PYTHON__" in (exc.stderr + exc.stdout):
            raise CodexRemoteError(
                "The remote login environment needs Python 3.10 or newer",
                code="REMOTE_PYTHON_TOO_OLD",
            ) from exc
        raise
    python_values = [
        line.removeprefix("__CODEX_REMOTE_PY__").strip()
        for line in probe.stdout.splitlines()
        if line.startswith("__CODEX_REMOTE_PY__")
    ]
    version_values = [
        line.removeprefix("__CODEX_REMOTE_PYVER__").strip()
        for line in probe.stdout.splitlines()
        if line.startswith("__CODEX_REMOTE_PYVER__")
    ]
    home_values = [
        line.removeprefix("__CODEX_REMOTE_HOME__").strip()
        for line in probe.stdout.splitlines()
        if line.startswith("__CODEX_REMOTE_HOME__")
    ]
    helper_hash_values = [
        line.removeprefix("__CODEX_REMOTE_HELPER_SHA__").strip()
        for line in probe.stdout.splitlines()
        if line.startswith("__CODEX_REMOTE_HELPER_SHA__")
    ]
    if (
        len(python_values) != 1
        or len(version_values) != 1
        or len(home_values) != 1
        or len(helper_hash_values) != 1
    ):
        raise CodexRemoteError(
            f"Could not determine remote Python and HOME on {host}", code="REMOTE_PROBE_FAILED"
        )
    python_path, python_version, home_value = python_values[0], version_values[0], home_values[0]
    remote_helper_hash = helper_hash_values[0]
    if not python_path.startswith("/"):
        raise CodexRemoteError(
            f"Remote Python did not resolve to an absolute executable: {python_path}",
            code="REMOTE_PROBE_FAILED",
        )
    home = Path(home_value)
    if not home.is_absolute():
        raise CodexRemoteError(f"Remote HOME is not absolute: {home}", code="REMOTE_PROBE_FAILED")
    helper = home / REMOTE_HELPER_RELATIVE
    source = Path(__file__).resolve().read_bytes()
    source_hash = hashlib.sha256(source).hexdigest()
    if remote_helper_hash != source_hash:
        tmp = helper.with_name(helper.name + f".tmp-{os.getpid()}")
        install_script = (
            "set -eu; umask 077; "
            f"mkdir -p {shlex.quote(str(helper.parent))}; "
            f"cat > {shlex.quote(str(tmp))}; "
            f"chmod 700 {shlex.quote(str(tmp))}; "
            f"mv -f {shlex.quote(str(tmp))} {shlex.quote(str(helper))}"
        )
        ssh_login_shell(host, install_script, timeout=timeout, input_data=source)
    return {
        "host": host,
        "home": str(home),
        "python": python_path,
        "python_version": python_version,
        "helper": str(helper),
        "helper_sha256": source_hash,
    }


def remote_invoke(
    context: Mapping[str, str],
    args: Sequence[str],
    *,
    timeout: int,
    payload: Mapping[str, Any] | None = None,
) -> dict[str, Any]:
    input_data = json.dumps(payload) if payload is not None else None
    completed = ssh_run(
        context["host"],
        [context["python"], context["helper"], *args],
        timeout=timeout,
        input_data=input_data,
    )
    value = None
    parse_error: json.JSONDecodeError | None = None
    for line in reversed(completed.stdout.splitlines()):
        if not line.strip():
            continue
        try:
            candidate = json.loads(line)
        except json.JSONDecodeError as exc:
            parse_error = exc
            continue
        if isinstance(candidate, dict):
            value = candidate
            break
    if value is None:
        raise CodexRemoteError(
            "Remote helper returned invalid JSON:\n" + completed.stdout + completed.stderr,
            code="REMOTE_PROTOCOL_ERROR",
        ) from parse_error
    if not value.get("ok", False):
        raise CodexRemoteError(
            value.get("error", "Remote helper failed"),
            code=value.get("error_code", "REMOTE_ERROR"),
            details=value.get("details"),
        )
    return value


def git_ssh_environment(timeout: int) -> dict[str, str]:
    env = os.environ.copy()
    env["GIT_SSH_COMMAND"] = shlex.join(
        [
            "ssh",
            "-o",
            "BatchMode=yes",
            "-o",
            f"ConnectTimeout={timeout}",
            "-o",
            "ConnectionAttempts=1",
        ]
    )
    return env


def broker_url(host: str, absolute_path: str) -> str:
    if not absolute_path.startswith("/"):
        raise CodexRemoteError("Remote broker path is not absolute", code="REMOTE_PROTOCOL_ERROR")
    return f"{host}:{absolute_path}"


def local_project_state_dir(project_id: str) -> Path:
    validate_safe_id(project_id, "project id")
    path = LOCAL_STATE_ROOT / project_id
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    return path


def local_current_path(project_id: str) -> Path:
    return local_project_state_dir(project_id) / "current.json"


def local_project_config_path(root: Path) -> Path:
    """Return the repository-local, untracked configuration path.

    ``git rev-parse --git-path`` keeps this correct for ordinary repositories
    and linked worktrees without committing machine-specific SSH paths.
    """
    value = git(root, "rev-parse", "--git-path", PROJECT_CONFIG_RELATIVE).stdout.strip()
    path = Path(value)
    return path if path.is_absolute() else (root / path).resolve()


def task_option_values(args: argparse.Namespace) -> dict[str, Any]:
    """Return normalized task options that are present on ARGS."""
    values: dict[str, Any] = {}
    if hasattr(args, "bootstrap_cmd"):
        values.update(
            {
                "bootstrap_cmd": args.bootstrap_cmd or "",
                "test_cmd": args.test_cmd or "",
                "data_links": list(args.data_link or []),
                "model": args.model or "",
                "profile": args.profile or "",
                "reasoning_effort": args.reasoning_effort or "",
                "enable_search": bool(args.enable_search),
                "job_policy": getattr(args, "job_policy", "deny") or "deny",
            }
        )
    return values


def persist_project_config(root: Path, args: argparse.Namespace) -> Path:
    """Persist the resolved project settings for terminal frontends.

    Doom remains the authority for directory-local variables.  The terminal
    ``codex-remote-job`` frontend reads this private Git-metadata file so it can
    launch the exact same backend operation without parsing Emacs Lisp.
    """
    path = local_project_config_path(root)
    existing = read_json(path) or {}
    value: dict[str, Any] = dict(existing)
    value.update(
        {
            "schema_version": SCHEMA_VERSION,
            "project_root": str(root),
            "host": validate_remote_host(args.host),
            "remote_dir": validate_remote_dir(args.remote_dir),
            "timeout": int(args.timeout),
            "max_untracked_bytes": int(args.max_untracked_bytes),
            "updated_at": utc_now(),
        }
    )
    value.update(task_option_values(args))
    atomic_write_json(path, value)
    return path


def task_id() -> str:
    timestamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    entropy = os.urandom(4).hex()
    return f"{timestamp}-{entropy}"


def common_local_args(args: argparse.Namespace) -> tuple[Path, str, str, int, str, str]:
    root = repository_root(args.project_root)
    host = validate_remote_host(args.host)
    remote_dir = validate_remote_dir(args.remote_dir)
    timeout = args.timeout
    if timeout < 1 or timeout > 60:
        raise CodexRemoteError("SSH timeout must be between 1 and 60 seconds", code="INVALID_TIMEOUT")
    if args.max_untracked_bytes < 1:
        raise CodexRemoteError(
            "Maximum untracked-file size must be positive", code="INVALID_FILE_SIZE_LIMIT"
        )
    project_id, project_name = project_identity(root, host, remote_dir)
    persist_project_config(root, args)
    return root, host, remote_dir, timeout, project_id, project_name


def check_startable_local(
    root: Path,
    max_bytes: int,
    *,
    include_untracked: bool = True,
) -> None:
    """Validate local state before creating a task snapshot.

    One-shot tasks intentionally transport selected untracked source files, so
    they retain the existing untracked-file safety checks. Managed interactive
    tasks preserve real commits and start from tracked Git state only: unrelated
    untracked files are neither inspected nor uploaded and therefore must not
    block ``SPC r c i``.
    """
    ensure_git_idle(root)
    ensure_no_submodules(root)
    if include_untracked:
        ensure_safe_untracked(root, max_bytes)
    ensure_no_changed_lfs_paths(root, include_untracked=include_untracked)


def cmd_doctor(args: argparse.Namespace) -> dict[str, Any]:
    root, host, remote_dir, timeout, project_id, project_name = common_local_args(args)
    ensure_git_idle(root)
    context = ensure_remote_helper(host, timeout)
    remote = remote_invoke(context, ["_server-doctor", "--project-id", project_id], timeout=timeout + 20)
    return {
        "ok": True,
        "command": "doctor",
        "project_id": project_id,
        "project_name": project_name,
        "project_root": str(root),
        "remote_host": host,
        "normal_remote_dir": remote_dir,
        "local": {
            "git": shutil.which("git"),
            "ssh": shutil.which("ssh"),
            "python": sys.executable,
            "branch": current_branch(root),
            "head": current_head(root),
        },
        "remote": remote["remote"],
    }


def remote_status(
    context: Mapping[str, str], project_id: str, timeout: int
) -> dict[str, Any]:
    return remote_invoke(context, ["_server-status", "--project-id", project_id], timeout=timeout)


def task_execution_mode(task: Mapping[str, Any]) -> str:
    """Return TASK's execution mode, treating legacy tasks as noninteractive."""
    value = task.get("execution_mode")
    return value if value in EXECUTION_MODES else "exec"


def submitted_data_links(args: argparse.Namespace) -> list[dict[str, str]]:
    """Validate and normalize command-line data-link specifications."""
    result: list[dict[str, str]] = []
    for value in args.data_link:
        if "=" not in value:
            raise CodexRemoteError(
                f"Data link must have REMOTE_SOURCE=WORKTREE_RELATIVE form: {value}",
                code="INVALID_DATA_LINK",
            )
        source, target = value.split("=", 1)
        if not source or not target:
            raise CodexRemoteError(
                f"Data link must have nonempty source and target: {value}",
                code="INVALID_DATA_LINK",
            )
        result.append({"source": source, "target": target})
    return result


def start_new_task(
    args: argparse.Namespace,
    *,
    execution_mode: str,
    prompt: str | None,
) -> dict[str, Any]:
    """Create and submit one managed remote task from the current local state."""
    if execution_mode not in EXECUTION_MODES:
        raise CodexRemoteError(
            f"Unsupported execution mode: {execution_mode}", code="INVALID_EXECUTION_MODE"
        )
    if execution_mode == "exec" and (not isinstance(prompt, str) or not prompt.strip()):
        raise CodexRemoteError("The Codex prompt is empty", code="EMPTY_PROMPT")
    if execution_mode == "interactive" and prompt is not None:
        raise CodexRemoteError(
            "Interactive Codex tasks do not accept a startup prompt",
            code="INVALID_EXECUTION_MODE",
        )

    root, host, remote_dir, timeout, project_id, project_name = common_local_args(args)
    check_startable_local(
        root,
        args.max_untracked_bytes,
        include_untracked=execution_mode != "interactive",
    )
    context = ensure_remote_helper(host, timeout)
    init = remote_invoke(context, ["_server-init", "--project-id", project_id], timeout=timeout)
    status = remote_status(context, project_id, timeout)
    existing = status.get("task", {})
    previous_imported = existing if existing.get("state") == "IMPORTED" else None
    state = existing.get("state", "NONE")
    local_before = read_json(local_current_path(project_id))
    if (
        local_before
        and local_before.get("state") == "APPLIED_PENDING_REMOTE_ACK"
        and local_before.get("task_id") == existing.get("task_id")
        and state == "IMPORTED"
    ):
        mark_local_imported(project_id, existing, local_before.get("changed_files") or [])
        local_before = read_json(local_current_path(project_id))
    if state not in ALLOW_NEW_TASK_STATES:
        raise CodexRemoteError(
            f"Project already has an outstanding Codex task {existing.get('task_id', '?')} in state {state}. "
            "Import, archive, or explicitly discard it before starting another.",
            code="OUTSTANDING_TASK",
            details=existing,
        )
    if local_before and local_before.get("state") not in LOCAL_RESOLVED_STATES:
        raise CodexRemoteError(
            f"Local task {local_before.get('task_id', '?')} is still recorded in state "
            f"{local_before.get('state')}. This can follow a lost SSH acknowledgement. "
            "Check status/logs; if the server has no matching task, explicitly discard the stale state.",
            code="LOCAL_TASK_UNRESOLVED",
            details=local_before,
        )

    data_links = submitted_data_links(args)
    identifier = task_id()
    input_ref = f"refs/codex/{project_id}/input/{identifier}"
    local_branch = current_branch(root)
    if execution_mode == "interactive" and not local_branch:
        raise CodexRemoteError(
            "Managed interactive Codex requires a named local branch so committed "
            "checkpoints can be pulled back safely.",
            code="INTERACTIVE_REQUIRES_BRANCH",
        )
    if execution_mode == "interactive":
        tracked_status = tracked_status_porcelain(root)
        if tracked_status.strip():
            snapshot = create_hidden_snapshot(
                root,
                input_ref,
                f"Codex remote interactive tracked snapshot {project_id}/{identifier}",
                include_untracked=False,
            )
        else:
            head = current_head(root)
            tree = git(root, "rev-parse", f"{head}^{{tree}}").stdout.strip()
            git(root, "update-ref", input_ref, head)
            snapshot = {
                "commit": head,
                "tree": tree,
                "head": head,
                "index_tree": index_tree(root),
            }
    else:
        snapshot = create_hidden_snapshot(
            root,
            input_ref,
            f"Codex remote {execution_mode} input snapshot {project_id}/{identifier}",
        )
    prompt_sha256 = (
        hashlib.sha256(prompt.encode("utf-8")).hexdigest()
        if isinstance(prompt, str)
        else None
    )
    local_state = {
        "schema_version": SCHEMA_VERSION,
        "project_id": project_id,
        "project_name": project_name,
        "task_id": identifier,
        "state": "SUBMITTING",
        "execution_mode": execution_mode,
        "project_root": str(root),
        "host": host,
        "normal_remote_dir": remote_dir,
        "input_ref": input_ref,
        "input_sha": snapshot["commit"],
        "input_tree": snapshot["tree"],
        "input_index_tree": snapshot["index_tree"],
        "local_head": snapshot["head"],
        "local_branch": local_branch,
        "created_at": utc_now(),
        "prompt_sha256": prompt_sha256,
    }
    atomic_write_json(local_current_path(project_id), local_state)

    remote_url = broker_url(host, init["remote"]["broker"])
    push = git(
        root,
        "push",
        "--porcelain",
        remote_url,
        f"{input_ref}:{input_ref}",
        env=git_ssh_environment(timeout),
        timeout=max(timeout + 30, 60),
    )

    payload = {
        "schema_version": SCHEMA_VERSION,
        "project_id": project_id,
        "project_name": project_name,
        "task_id": identifier,
        "execution_mode": execution_mode,
        "input_ref": input_ref,
        "input_sha": snapshot["commit"],
        "input_tree": snapshot["tree"],
        "input_index_tree": snapshot["index_tree"],
        "local_head": snapshot["head"],
        "local_branch": local_branch,
        "normal_remote_dir": remote_dir,
        "prompt": prompt,
        "prompt_sha256": prompt_sha256,
        "bootstrap_cmd": args.bootstrap_cmd or None,
        "test_cmd": args.test_cmd or None,
        "data_links": data_links,
        "max_untracked_bytes": args.max_untracked_bytes,
        "model": args.model or None,
        "profile": args.profile or None,
        "reasoning_effort": args.reasoning_effort or None,
        "enable_search": bool(args.enable_search),
        "job_policy": getattr(args, "job_policy", "deny") or "deny",
        "lock_hashes": file_hashes(root),
        "created_at": local_state["created_at"],
    }
    started = remote_invoke(
        context,
        ["_server-start", "--project-id", project_id, "--task-id", identifier],
        timeout=timeout + 20,
        payload=payload,
    )
    started_task = started["task"]
    if execution_mode == "interactive":
        refreshed = remote_status(context, project_id, timeout)
        candidate = refreshed.get("task", {})
        if candidate.get("task_id") == identifier:
            started_task = candidate
    local_state.update(
        {
            "state": started_task["state"],
            "remote": started_task,
            "push_output": push.stdout.strip(),
            "updated_at": utc_now(),
        }
    )
    atomic_write_json(local_current_path(project_id), local_state)
    if previous_imported and previous_imported.get("task_id"):
        previous_id = validate_safe_id(previous_imported["task_id"], "task id")
        cleanup_local_integration(root, project_id, previous_id)
        cleanup_local_refs(root, project_id, previous_id, previous_imported)
    label = "interactive Codex TUI" if execution_mode == "interactive" else "remote Codex task"
    return {
        "ok": True,
        "command": "interactive" if execution_mode == "interactive" else "start",
        "project_id": project_id,
        "task": started_task,
        "reused": False,
        "message": (
            f"Started {label} {identifier} on {host}; "
            f"worktree {started_task.get('worktree')}"
        ),
    }


def cmd_start(args: argparse.Namespace) -> dict[str, Any]:
    # Capture stdin before any Git/SSH subprocess is launched.  In particular,
    # OpenSSH reads its stdin even for noninteractive remote commands, so a
    # prompt supplied with --prompt-file - would otherwise be consumed by the
    # prerequisite probes before we reached the prompt read below.
    prompt = (
        sys.stdin.read()
        if args.prompt_file == "-"
        else Path(args.prompt_file).read_text(encoding="utf-8")
    )
    return start_new_task(args, execution_mode="exec", prompt=prompt)


def cmd_interactive(args: argparse.Namespace) -> dict[str, Any]:
    """Start or reattach to a managed interactive Codex TUI for this project."""
    root, host, remote_dir, timeout, project_id, project_name = common_local_args(args)
    context = ensure_remote_helper(host, timeout)
    remote_invoke(context, ["_server-init", "--project-id", project_id], timeout=timeout)
    status = remote_status(context, project_id, timeout)
    existing = status.get("task", {"state": "NONE"})
    state = existing.get("state", "NONE")
    if state in INTERACTIVE_ATTACH_STATES and task_execution_mode(existing) == "interactive":
        local = reconcile_local_status(
            project_id,
            existing,
            read_json(local_current_path(project_id)),
        )
        return {
            "ok": True,
            "command": "interactive",
            "project_id": project_id,
            "project_name": project_name,
            "project_root": str(root),
            "remote_host": host,
            "normal_remote_dir": remote_dir,
            "task": existing,
            "local_state": local,
            "reused": True,
            "message": f"Reattaching to interactive Codex task {existing.get('task_id')}",
        }
    if state not in ALLOW_NEW_TASK_STATES:
        mode = task_execution_mode(existing)
        raise CodexRemoteError(
            f"Project already has an outstanding {mode} Codex task "
            f"{existing.get('task_id', '?')} in state {state}. Import, archive, or "
            "explicitly discard it before starting an interactive TUI.",
            code="OUTSTANDING_TASK",
            details=existing,
        )
    return start_new_task(args, execution_mode="interactive", prompt=None)


def reconcile_local_status(
    project_id: str,
    task: Mapping[str, Any],
    local: dict[str, Any] | None,
) -> dict[str, Any] | None:
    """Refresh a matching local orchestration record from remote task state."""
    if not local or task.get("state") == "NONE":
        return local
    if local.get("task_id") != task.get("task_id"):
        return local
    if local.get("state") == "APPLIED_PENDING_REMOTE_ACK":
        return local

    updated = dict(local)
    updated["state"] = task.get("state")
    updated["remote"] = dict(task)
    updated["updated_at"] = utc_now()
    atomic_write_json(local_current_path(project_id), updated)
    return updated


def cmd_status(args: argparse.Namespace) -> dict[str, Any]:
    root, host, remote_dir, timeout, project_id, project_name = common_local_args(args)
    context = ensure_remote_helper(host, timeout)
    status = remote_status(context, project_id, timeout)
    task = status.get("task", {"state": "NONE"})
    local = reconcile_local_status(
        project_id,
        task,
        read_json(local_current_path(project_id)),
    )
    return {
        "ok": True,
        "command": "status",
        "project_id": project_id,
        "project_name": project_name,
        "project_root": str(root),
        "remote_host": host,
        "normal_remote_dir": remote_dir,
        "task": task,
        "local_state": local,
    }


def cmd_logs(args: argparse.Namespace) -> dict[str, Any]:
    _root, host, _remote_dir, timeout, project_id, _project_name = common_local_args(args)
    context = ensure_remote_helper(host, timeout)
    value = remote_invoke(
        context,
        ["_server-logs", "--project-id", project_id, "--tail", str(args.tail)],
        timeout=timeout + 10,
    )
    return {
        "ok": True,
        "command": "logs",
        "project_id": project_id,
        "task": value.get("task", {"state": "NONE"}),
        "log": value.get("log", ""),
    }


def cmd_cancel(args: argparse.Namespace) -> dict[str, Any]:
    _root, host, _remote_dir, timeout, project_id, _project_name = common_local_args(args)
    context = ensure_remote_helper(host, timeout)
    value = remote_invoke(
        context, ["_server-cancel", "--project-id", project_id], timeout=timeout
    )
    return {"ok": True, "command": "cancel", "project_id": project_id, "task": value["task"]}


def cmd_recover(args: argparse.Namespace) -> dict[str, Any]:
    """Finalize a preserved orphaned/failed worktree without rerunning Codex."""
    _root, host, _remote_dir, timeout, project_id, _project_name = common_local_args(args)
    context = ensure_remote_helper(host, timeout)
    value = remote_invoke(
        context,
        ["_server-recover", "--project-id", project_id],
        timeout=max(timeout + 60, 120),
    )
    task = value["task"]
    reconcile_local_status(
        project_id, task, read_json(local_current_path(project_id))
    )
    return {
        "ok": True,
        "command": "recover",
        "project_id": project_id,
        "task": task,
        "message": value.get("message") or "Recovered the preserved Codex worktree.",
    }


def changed_file_summary(root: Path, old: str, new: str) -> list[dict[str, str]]:
    completed = git(root, "diff", "--name-status", "-z", old, new, "--")
    fields = nul_paths(completed.stdout)
    result: list[dict[str, str]] = []
    i = 0
    while i < len(fields):
        status = fields[i]
        i += 1
        if status.startswith(("R", "C")) and i + 1 < len(fields):
            old_path, new_path = fields[i], fields[i + 1]
            i += 2
            result.append({"status": status, "path": new_path, "old_path": old_path})
        elif i < len(fields):
            path = fields[i]
            i += 1
            result.append({"status": status, "path": path})
    return result


def remove_worktree(root: Path, path: Path) -> None:
    completed = git(root, "worktree", "remove", "--force", str(path), check=False)
    if completed.returncode != 0 and path.exists():
        raise CommandError(
            ["git", "-C", str(root), "worktree", "remove", "--force", str(path)],
            completed.returncode,
            completed.stdout,
            completed.stderr,
        )
    git(root, "worktree", "prune")


def integration_worktree_path(project_id: str, task_id_value: str, state_dir: Path | None = None) -> Path:
    base = state_dir if state_dir is not None else local_project_state_dir(project_id)
    return base / "integration" / task_id_value


def integration_state_path(project_id: str, state_dir: Path | None = None) -> Path:
    base = state_dir if state_dir is not None else local_project_state_dir(project_id)
    return base / "integration-conflict.json"


def rebase_in_progress(root: Path) -> bool:
    return any(
        git_dir_path(root, marker).exists()
        for marker in ("rebase-merge", "rebase-apply")
    )


def apply_integrated_snapshot(
    root: Path,
    project_id: str,
    identifier: str,
    current: Mapping[str, str],
    merged: str,
    fingerprint: Mapping[str, str],
    integration: Path,
    state_root: Path,
) -> dict[str, Any]:
    """Apply CURRENT..MERGED to the canonical checkout after verification."""
    verify_fingerprint(root, fingerprint)
    patch = git(
        root,
        "diff",
        "--binary",
        "--full-index",
        current["commit"],
        merged,
        "--",
        text=False,
    ).stdout
    changed = changed_file_summary(root, current["commit"], merged)
    if patch:
        git(root, "apply", "--check", "--binary", "-", input_data=patch, text=False)
        git(root, "apply", "--binary", "-", input_data=patch, text=False)
        try:
            post_tree = snapshot_tree_only(root)
            merged_tree = git(root, "rev-parse", f"{merged}^{{tree}}").stdout.strip()
            if post_tree != merged_tree or index_tree(root) != fingerprint["index_tree"]:
                raise CodexRemoteError(
                    "Post-apply verification failed; attempting to restore the pre-import working tree.",
                    code="POST_APPLY_VERIFY_FAILED",
                )
        except Exception as verification_error:
            reverse = git(
                root,
                "apply",
                "--reverse",
                "--binary",
                "-",
                input_data=patch,
                text=False,
                check=False,
            )
            if reverse.returncode != 0:
                failure_state = {
                    "schema_version": SCHEMA_VERSION,
                    "project_id": project_id,
                    "task_id": identifier,
                    "state": "ROLLBACK_FAILED",
                    "conflict_path": str(integration),
                    "current_snapshot": current["commit"],
                    "merged_snapshot": merged,
                    "created_at": utc_now(),
                    "reverse_stdout": reverse.stdout.decode(errors="replace")
                    if isinstance(reverse.stdout, bytes)
                    else reverse.stdout,
                    "reverse_stderr": reverse.stderr.decode(errors="replace")
                    if isinstance(reverse.stderr, bytes)
                    else reverse.stderr,
                }
                atomic_write_json(state_root / "integration-failure.json", failure_state)
                raise CodexRemoteError(
                    "Post-apply verification failed and automatic rollback also failed. "
                    "The integration worktree was preserved; inspect the canonical checkout immediately.",
                    code="ROLLBACK_FAILED",
                    details=failure_state,
                ) from verification_error
            raise

    with contextlib.suppress(FileNotFoundError):
        integration_state_path(project_id, state_root).unlink()
    with contextlib.suppress(FileNotFoundError):
        (state_root / "integration-failure.json").unlink()
    return {
        "current": dict(current),
        "merged": merged,
        "changed_files": changed,
        "integration_path": str(integration),
    }


def resume_preserved_integration(
    root: Path,
    project_id: str,
    task_id_value: str,
    input_sha: str,
    result_sha: str,
    *,
    state_dir: Path | None = None,
) -> dict[str, Any] | None:
    """Finish a conflict that the user resolved in the isolated worktree."""
    state_root = state_dir if state_dir is not None else local_project_state_dir(project_id)
    path = integration_state_path(project_id, state_root)
    conflict = read_json(path)
    if not conflict:
        return None
    identifier = validate_safe_id(task_id_value, "task id")
    if (
        conflict.get("project_id") != project_id
        or conflict.get("task_id") != identifier
        or conflict.get("input_sha") != input_sha
        or conflict.get("result_sha") != result_sha
    ):
        raise CodexRemoteError(
            "The preserved integration state does not match the current task.",
            code="INTEGRATION_STATE_MISMATCH",
            details=conflict,
        )
    integration = Path(str(conflict.get("conflict_path") or ""))
    if not integration.is_dir():
        raise CodexRemoteError(
            "The preserved integration worktree is missing; discard the conflict state or use the local-backup option.",
            code="INTEGRATION_WORKTREE_MISSING",
            details=conflict,
        )
    unmerged = git(integration, "ls-files", "-u").stdout.strip()
    if unmerged or rebase_in_progress(integration):
        raise CodexRemoteError(
            "The isolated integration is still unresolved. Resolve all files and complete the rebase, then run the fetch/apply command again.",
            code="INTEGRATION_CONFLICT_PENDING",
            details=conflict,
        )
    merged = git(integration, "rev-parse", "HEAD").stdout.strip()
    current_snapshot = str(conflict.get("current_snapshot") or "")
    if not current_snapshot or git(
        integration,
        "merge-base",
        "--is-ancestor",
        current_snapshot,
        merged,
        check=False,
    ).returncode != 0:
        raise CodexRemoteError(
            "The preserved integration no longer contains the recorded local base. Do not import it; restart conflict handling or use the local-backup option.",
            code="INVALID_RESOLVED_INTEGRATION",
            details=conflict,
        )
    fingerprint = conflict.get("fingerprint")
    if not isinstance(fingerprint, dict) or not all(
        isinstance(fingerprint.get(key), str) for key in ("head", "index_tree", "tree")
    ):
        raise CodexRemoteError(
            "The preserved conflict lacks a complete canonical-checkout fingerprint.",
            code="INTEGRATION_STATE_MISMATCH",
            details=conflict,
        )
    current = {
        "commit": current_snapshot,
        "head": fingerprint["head"],
        "index_tree": fingerprint["index_tree"],
        "tree": fingerprint["tree"],
    }
    result = apply_integrated_snapshot(
        root,
        project_id,
        identifier,
        current,
        merged,
        fingerprint,
        integration,
        state_root,
    )
    remove_worktree(root, integration)
    return result


def integrate_result_into_worktree(
    root: Path,
    project_id: str,
    task_id_value: str,
    input_sha: str,
    result_sha: str,
    *,
    state_dir: Path | None = None,
) -> dict[str, Any]:
    """Replay INPUT..RESULT onto the current dirty state and apply it unstaged.

    All three-way work happens in a temporary linked worktree.  A true conflict
    is preserved there, while the canonical checkout is touched only after a
    clean rebase and a fresh fingerprint check.  Re-running the operation after
    completing that rebase imports the resolved result.
    """
    validate_safe_id(project_id, "project id")
    identifier = validate_safe_id(task_id_value, "task id")
    if git(root, "merge-base", "--is-ancestor", input_sha, result_sha, check=False).returncode != 0:
        raise CodexRemoteError(
            "Remote result is not a descendant of its input", code="INVALID_RESULT_HISTORY"
        )

    resumed = resume_preserved_integration(
        root,
        project_id,
        identifier,
        input_sha,
        result_sha,
        state_dir=state_dir,
    )
    if resumed is not None:
        return resumed

    current_ref = f"refs/codex/{project_id}/current/{identifier}"
    current = create_hidden_snapshot(
        root,
        current_ref,
        f"Codex remote import base {project_id}/{identifier}",
    )
    fingerprint = {
        "head": current["head"],
        "index_tree": current["index_tree"],
        "tree": current["tree"],
    }
    state_root = state_dir if state_dir is not None else local_project_state_dir(project_id)
    integration = integration_worktree_path(project_id, identifier, state_root)
    integration.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if integration.exists():
        raise CodexRemoteError(
            f"A preserved integration worktree already exists at {integration}. Resolve or discard it before retrying.",
            code="INTEGRATION_EXISTS",
            details={"conflict_path": str(integration)},
        )

    env = os.environ.copy()
    env.setdefault("GIT_AUTHOR_NAME", "Codex Remote")
    env.setdefault("GIT_AUTHOR_EMAIL", "codex-remote@localhost")
    env.setdefault("GIT_COMMITTER_NAME", "Codex Remote")
    env.setdefault("GIT_COMMITTER_EMAIL", "codex-remote@localhost")
    created = False
    preserve = False
    try:
        git(root, "worktree", "add", "--detach", str(integration), result_sha, env=env)
        created = True
        rebase = git(
            integration,
            "rebase",
            "--onto",
            current["commit"],
            input_sha,
            result_sha,
            env=env,
            check=False,
        )
        if rebase.returncode != 0:
            preserve = True
            conflict_state = {
                "schema_version": SCHEMA_VERSION,
                "project_id": project_id,
                "task_id": identifier,
                "state": "CONFLICT",
                "conflict_path": str(integration),
                "current_snapshot": current["commit"],
                "fingerprint": fingerprint,
                "input_sha": input_sha,
                "result_sha": result_sha,
                "created_at": utc_now(),
                "rebase_stdout": rebase.stdout,
                "rebase_stderr": rebase.stderr,
            }
            atomic_write_json(integration_state_path(project_id, state_root), conflict_state)
            raise CodexRemoteError(
                "Codex changes conflict with the current local state. The canonical checkout was not modified.",
                code="INTEGRATION_CONFLICT",
                details=conflict_state,
            )

        merged = git(integration, "rev-parse", "HEAD").stdout.strip()
        return apply_integrated_snapshot(
            root,
            project_id,
            identifier,
            current,
            merged,
            fingerprint,
            integration,
            state_root,
        )
    except CodexRemoteError as exc:
        if exc.code == "ROLLBACK_FAILED":
            preserve = True
        raise
    finally:
        if created and not preserve:
            remove_worktree(root, integration)


def commit_integration_worktree_path(
    project_id: str, task_id_value: str, state_dir: Path | None = None
) -> Path:
    base = state_dir if state_dir is not None else local_project_state_dir(project_id)
    return base / "commit-integration" / validate_safe_id(task_id_value, "task id")


def commit_integration_state_path(
    project_id: str, state_dir: Path | None = None
) -> Path:
    base = state_dir if state_dir is not None else local_project_state_dir(project_id)
    return base / "commit-integration-conflict.json"


def ensure_clean_commit_pull_checkout(root: Path) -> tuple[str, str, str]:
    """Require tracked cleanliness while preserving unrelated untracked files."""
    ensure_git_idle(root)
    branch = current_branch(root)
    if not branch:
        raise CodexRemoteError(
            "Live Codex commits cannot be pulled onto a detached local HEAD",
            code="LOCAL_BRANCH_REQUIRED",
        )
    tracked_status = git(
        root, "status", "--porcelain=v1", "--untracked-files=no"
    ).stdout
    if tracked_status.strip():
        raise CodexRemoteError(
            "Codex has new committed work, but the local checkout has tracked changes. "
            "Commit or stash them, then retry the sync/run command so the Codex commit "
            "boundaries can be preserved. Untracked files may remain unless an incoming "
            "commit would overwrite one of their paths.",
            code="LOCAL_DIRTY_FOR_COMMIT_PULL",
            details={"status": tracked_status},
        )
    return branch, current_head(root), git_status_porcelain(root)


def commit_summaries(root: Path, old: str, new: str) -> list[dict[str, str]]:
    completed = git(
        root,
        "log",
        "--reverse",
        "--format=%H%x00%an%x00%ae%x00%s%x00",
        f"{old}..{new}",
    )
    fields = completed.stdout.split("\0")
    result: list[dict[str, str]] = []
    for index in range(0, len(fields) - 3, 4):
        sha, author, email, subject = fields[index : index + 4]
        if sha:
            result.append(
                {
                    "sha": sha.strip(),
                    "author": author,
                    "email": email,
                    "subject": subject.rstrip("\n"),
                }
            )
    return result


def finish_commit_integration(
    root: Path,
    project_id: str,
    identifier: str,
    integration: Path,
    state_root: Path,
    expected_branch: str,
    expected_head: str,
    expected_status: str,
) -> dict[str, Any]:
    status = git_status_porcelain(root)
    if (
        status != expected_status
        or current_branch(root) != expected_branch
        or current_head(root) != expected_head
    ):
        raise CodexRemoteError(
            "The local checkout changed while Codex commits were being integrated; "
            "the canonical branch was left untouched.",
            code="LOCAL_STATE_CHANGED",
            details={
                "expected_branch": expected_branch,
                "current_branch": current_branch(root),
                "expected_head": expected_head,
                "current_head": current_head(root),
                "expected_status": expected_status,
                "status": status,
                "conflict_path": str(integration),
            },
        )
    integrated_tip = current_head(integration)
    commits = commit_summaries(integration, expected_head, integrated_tip)
    merged = git(root, "merge", "--ff-only", integrated_tip, check=False)
    if merged.returncode != 0:
        after_head = current_head(root)
        after_status = git_status_porcelain(root)
        if after_head != expected_head or after_status != expected_status:
            raise CodexRemoteError(
                "The local checkout changed after a failed fast-forward attempt; inspect it "
                "before retrying.",
                code="POST_PULL_VERIFY_FAILED",
                details={
                    "expected_head": expected_head,
                    "current_head": after_head,
                    "expected_status": expected_status,
                    "status": after_status,
                    "stdout": merged.stdout,
                    "stderr": merged.stderr,
                },
            )
        raise CodexRemoteError(
            "The Codex commits integrated cleanly, but Git could not fast-forward the local "
            "checkout. An untracked path may be in the way; the canonical checkout was left "
            "unchanged.",
            code="LOCAL_CHECKOUT_BLOCKED",
            details={"stdout": merged.stdout, "stderr": merged.stderr},
        )
    tracked_after = git(
        root, "status", "--porcelain=v1", "--untracked-files=no"
    ).stdout
    if (
        current_head(root) != integrated_tip
        or tracked_after.strip()
        or git_status_porcelain(root) != expected_status
    ):
        raise CodexRemoteError(
            "Post-pull verification failed after fast-forwarding Codex commits",
            code="POST_PULL_VERIFY_FAILED",
        )
    with contextlib.suppress(FileNotFoundError):
        commit_integration_state_path(project_id, state_root).unlink()
    remove_worktree(root, integration)
    return {
        "previous_local_head": expected_head,
        "local_tip": integrated_tip,
        "commits": commits,
        "changed_commit_count": len(commits),
    }


def integrate_committed_checkpoint(
    root: Path,
    project_id: str,
    task_id_value: str,
    remote_base: str,
    remote_tip: str,
    *,
    prior_local_tip: str | None = None,
    state_dir: Path | None = None,
) -> dict[str, Any]:
    """Replay only newly published Codex commits onto the current local branch."""
    identifier = validate_safe_id(task_id_value, "task id")
    if git(root, "merge-base", "--is-ancestor", remote_base, remote_tip, check=False).returncode != 0:
        raise CodexRemoteError(
            "Published Codex checkpoint is not descended from the previously pulled checkpoint",
            code="CHECKPOINT_HISTORY_REWRITTEN",
            details={"remote_base": remote_base, "remote_tip": remote_tip},
        )
    if remote_base == remote_tip:
        return {
            "previous_local_head": current_head(root),
            "local_tip": current_head(root),
            "commits": [],
            "changed_commit_count": 0,
        }

    branch, local_head, local_status = ensure_clean_commit_pull_checkout(root)
    if prior_local_tip and git(
        root,
        "merge-base",
        "--is-ancestor",
        prior_local_tip,
        local_head,
        check=False,
    ).returncode != 0:
        raise CodexRemoteError(
            "The local branch no longer contains the previously imported Codex checkpoint. "
            "Do not replay later checkpoints until the local history is reconciled.",
            code="LOCAL_CHECKPOINT_HISTORY_DIVERGED",
            details={"prior_local_tip": prior_local_tip, "current_head": local_head},
        )

    state_root = state_dir if state_dir is not None else local_project_state_dir(project_id)
    integration = commit_integration_worktree_path(project_id, identifier, state_root)
    conflict_path = commit_integration_state_path(project_id, state_root)
    conflict = read_json(conflict_path)
    if conflict:
        if (
            conflict.get("project_id") != project_id
            or conflict.get("task_id") != identifier
            or conflict.get("remote_base") != remote_base
            or conflict.get("remote_tip") != remote_tip
        ):
            raise CodexRemoteError(
                "A preserved live-checkpoint integration belongs to a different checkpoint",
                code="INTEGRATION_STATE_MISMATCH",
                details=conflict,
            )
        if not integration.is_dir():
            raise CodexRemoteError(
                "The preserved live-checkpoint integration worktree is missing",
                code="INTEGRATION_WORKTREE_MISSING",
                details=conflict,
            )
        if git(integration, "ls-files", "-u").stdout.strip() or rebase_in_progress(integration):
            raise CodexRemoteError(
                "The live-checkpoint rebase is still conflicted. Resolve it in the preserved "
                "worktree, complete the rebase, then retry the pull.",
                code="INTEGRATION_CONFLICT_PENDING",
                details=conflict,
            )
        return finish_commit_integration(
            root,
            project_id,
            identifier,
            integration,
            state_root,
            str(conflict["local_branch"]),
            str(conflict["local_head"]),
            str(conflict.get("local_status") or ""),
        )

    integration.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if integration.exists():
        raise CodexRemoteError(
            f"A live-checkpoint integration worktree already exists at {integration}",
            code="INTEGRATION_EXISTS",
            details={"conflict_path": str(integration)},
        )
    env = os.environ.copy()
    env.setdefault("GIT_COMMITTER_NAME", "Codex Remote")
    env.setdefault("GIT_COMMITTER_EMAIL", "codex-remote@localhost")
    created = False
    preserve = False
    try:
        git(root, "worktree", "add", "--detach", str(integration), remote_tip, env=env)
        created = True
        rebase = git(
            integration,
            "rebase",
            "--onto",
            local_head,
            remote_base,
            remote_tip,
            env=env,
            check=False,
        )
        if rebase.returncode != 0:
            preserve = True
            conflict = {
                "schema_version": SCHEMA_VERSION,
                "project_id": project_id,
                "task_id": identifier,
                "state": "CONFLICT",
                "integration_kind": "commit-checkpoint",
                "conflict_path": str(integration),
                "remote_base": remote_base,
                "remote_tip": remote_tip,
                "local_branch": branch,
                "local_head": local_head,
                "local_status": local_status,
                "created_at": utc_now(),
                "rebase_stdout": rebase.stdout,
                "rebase_stderr": rebase.stderr,
            }
            atomic_write_json(conflict_path, conflict)
            raise CodexRemoteError(
                "New Codex commits conflict with local commits. The canonical checkout was "
                "not modified; resolve the preserved rebase and retry.",
                code="INTEGRATION_CONFLICT",
                details=conflict,
            )
        return finish_commit_integration(
            root,
            project_id,
            identifier,
            integration,
            state_root,
            branch,
            local_head,
            local_status,
        )
    finally:
        if created and not preserve and integration.exists():
            # ``finish_commit_integration`` normally removed it already.
            remove_worktree(root, integration)


def cmd_pull(args: argparse.Namespace) -> dict[str, Any]:
    """Pull committed interactive checkpoints while leaving Codex running."""
    root, host, _remote_dir, timeout, project_id, project_name = common_local_args(args)
    context = ensure_remote_helper(host, timeout)
    status = remote_status(context, project_id, timeout)
    task = status.get("task", {})
    state = str(task.get("state") or "NONE")
    mode = task_execution_mode(task)

    if state in {"NONE", "IMPORTED", "DISCARDED", "ARCHIVED"} or mode != "interactive":
        return {
            "ok": True,
            "command": "pull",
            "project_id": project_id,
            "project_name": project_name,
            "task": task,
            "changed_commit_count": 0,
            "commits": [],
            "message": "No live interactive Codex commits are waiting to be pulled.",
        }

    local = reconcile_local_status(
        project_id,
        task,
        read_json(local_current_path(project_id)),
    ) or {}
    identifier = validate_safe_id(str(task.get("task_id") or ""), "task id")

    final = state in RESULT_READY_STATES | {"NOOP", "CANCELLED_NOOP"}
    if state in ACTIVE_STATES:
        published = remote_invoke(
            context,
            [
                "_server-checkpoint",
                "--project-id",
                project_id,
                "--task-id",
                identifier,
            ],
            timeout=max(timeout + 60, 120),
        )
        checkpoint = published["checkpoint"]
        remote_ref = str(checkpoint["ref"])
        remote_tip_expected = str(checkpoint["sha"])
    elif state in RESULT_READY_STATES:
        remote_ref = str(task.get("result_ref") or "")
        remote_tip_expected = str(task.get("result_sha") or "")
        checkpoint = task.get("checkpoint") or {
            "ref": remote_ref,
            "sha": remote_tip_expected,
            "dirty": False,
        }
    elif state in {"NOOP", "CANCELLED_NOOP"}:
        marked = remote_invoke(
            context,
            ["_server-mark-imported", "--project-id", project_id, "--task-id", identifier],
            timeout=timeout,
        )
        mark_local_imported(project_id, marked["task"], [])
        return {
            "ok": True,
            "command": "pull",
            "project_id": project_id,
            "task": marked["task"],
            "changed_commit_count": 0,
            "commits": [],
            "message": "Interactive Codex produced no commits; task marked imported.",
        }
    else:
        raise CodexRemoteError(
            f"Interactive task is not pullable in state {state}",
            code="TASK_NOT_PULLABLE",
            details=task,
        )

    input_ref = str(task.get("input_ref") or "")
    input_sha = str(task.get("input_sha") or "")
    if not input_ref or not input_sha or not remote_ref or not remote_tip_expected:
        raise CodexRemoteError(
            "Interactive task is missing checkpoint/ref metadata",
            code="REMOTE_PROTOCOL_ERROR",
            details=task,
        )
    local_input_ref = f"refs/codex/{project_id}/fetched-input/{identifier}"
    local_checkpoint_ref = f"refs/codex/{project_id}/fetched-checkpoint/{identifier}"
    remote_url = broker_url(host, str(task["broker"]))
    git(
        root,
        "fetch",
        "--no-tags",
        remote_url,
        f"+{input_ref}:{local_input_ref}",
        f"+{remote_ref}:{local_checkpoint_ref}",
        env=git_ssh_environment(timeout),
        timeout=max(timeout + 30, 60),
    )
    if git(root, "rev-parse", local_input_ref).stdout.strip() != input_sha:
        raise CodexRemoteError(
            "Fetched interactive input ref does not match task metadata",
            code="REF_MISMATCH",
        )
    remote_tip = git(root, "rev-parse", local_checkpoint_ref).stdout.strip()
    if remote_tip != remote_tip_expected:
        raise CodexRemoteError(
            "Fetched interactive checkpoint does not match server metadata",
            code="REF_MISMATCH",
        )

    same_task = local.get("task_id") == identifier
    remote_base = (
        str(local.get("last_checkpoint_remote_sha"))
        if same_task and local.get("last_checkpoint_remote_sha")
        else input_sha
    )
    prior_local_tip = (
        str(local.get("last_checkpoint_local_sha"))
        if same_task and local.get("last_checkpoint_local_sha")
        else None
    )
    if remote_base != remote_tip:
        expected_branch = (
            str(local.get("checkpoint_local_branch"))
            if same_task and local.get("checkpoint_local_branch")
            else str(task.get("local_branch") or "")
        )
        active_branch = current_branch(root) or ""
        allow_branch_change = bool(getattr(args, "allow_branch_change", False))
        if expected_branch and active_branch != expected_branch and not allow_branch_change:
            raise CodexRemoteError(
                "This interactive task started (or was previously pulled) on branch "
                f"{expected_branch!r}, but the current branch is {active_branch or '(detached)'!r}. "
                "Switch back before running a normal remote command, or use the explicit "
                "branch-change override when importing deliberately.",
                code="TASK_BRANCH_CHANGED",
                details={
                    "expected_branch": expected_branch,
                    "current_branch": active_branch or None,
                },
            )
    integrated = integrate_committed_checkpoint(
        root,
        project_id,
        identifier,
        remote_base,
        remote_tip,
        prior_local_tip=prior_local_tip,
    )
    changed_count = int(integrated["changed_commit_count"])
    updated = dict(local)
    updated.update(
        {
            "schema_version": SCHEMA_VERSION,
            "project_id": project_id,
            "project_name": project_name,
            "task_id": identifier,
            "state": state,
            "execution_mode": "interactive",
            "last_checkpoint_remote_sha": remote_tip,
            "last_checkpoint_local_sha": integrated["local_tip"],
            "checkpoint_local_branch": current_branch(root),
            "last_checkpoint_pulled_at": utc_now(),
            "last_checkpoint_commits": integrated["commits"],
            "remote": task,
        }
    )
    atomic_write_json(local_current_path(project_id), updated)

    resulting_task = task
    if final:
        marked = remote_invoke(
            context,
            ["_server-mark-imported", "--project-id", project_id, "--task-id", identifier],
            timeout=timeout,
        )
        resulting_task = marked["task"]
        updated["state"] = "IMPORTED"
        updated["imported_at"] = utc_now()
        updated["remote"] = resulting_task
        atomic_write_json(local_current_path(project_id), updated)

    suffix = " Codex still has uncommitted server-side edits." if checkpoint.get("dirty") else ""
    if changed_count:
        message = f"Pulled {changed_count} committed Codex change(s) into {current_branch(root)}.{suffix}"
    else:
        message = "No new committed Codex changes were available." + suffix
    return {
        "ok": True,
        "command": "pull",
        "project_id": project_id,
        "project_name": project_name,
        "task": resulting_task,
        "source_state": state,
        "checkpoint": checkpoint,
        "changed_commit_count": changed_count,
        "commits": integrated["commits"],
        "local_tip": integrated["local_tip"],
        "final": final,
        "message": message,
    }

def cleanup_local_refs(root: Path, project_id: str, task_id_value: str, task: Mapping[str, Any] | None) -> None:
    refs = {
        f"refs/codex/{project_id}/fetched-input/{task_id_value}",
        f"refs/codex/{project_id}/fetched-result/{task_id_value}",
        f"refs/codex/{project_id}/fetched-checkpoint/{task_id_value}",
        f"refs/codex/{project_id}/current/{task_id_value}",
    }
    if task and isinstance(task.get("input_ref"), str):
        refs.add(task["input_ref"])
    for ref in refs:
        git(root, "update-ref", "-d", ref, check=False)


def cleanup_local_integration(
    root: Path,
    project_id: str,
    task_id_value: str,
    *,
    state_dir: Path | None = None,
) -> None:
    state_root = state_dir if state_dir is not None else local_project_state_dir(project_id)
    path = integration_worktree_path(project_id, task_id_value, state_root)
    if path.exists():
        remove_worktree(root, path)
    commit_path = commit_integration_worktree_path(
        project_id, task_id_value, state_root
    )
    if commit_path.exists():
        remove_worktree(root, commit_path)
    for name in (
        "integration-conflict.json",
        "integration-failure.json",
        "commit-integration-conflict.json",
    ):
        with contextlib.suppress(FileNotFoundError):
            (state_root / name).unlink()



def unique_local_backup_branch(root: Path, branch: str) -> str:
    """Return a collision-free ``<branch>-local-<UTC timestamp>`` name."""
    timestamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    base = f"{branch}-local-{timestamp}"
    candidates = [base, *[f"{base}-{index}" for index in range(2, 100)]]
    for candidate in candidates:
        checked = git(root, "check-ref-format", "--branch", candidate, check=False)
        if checked.returncode != 0:
            continue
        exists = git(
            root,
            "show-ref",
            "--verify",
            "--quiet",
            f"refs/heads/{candidate}",
            check=False,
        )
        if exists.returncode != 0:
            return candidate
    raise CodexRemoteError(
        f"Could not allocate a local backup branch derived from {branch!r}",
        code="BACKUP_BRANCH_FAILED",
    )


def reconstruct_task_input_state(
    root: Path,
    task: Mapping[str, Any],
    local: Mapping[str, Any],
    input_sha: str,
) -> dict[str, str]:
    """Restore the exact visible state that was sent to Codex.

    HEAD returns to the task's recorded starting commit, the index returns to the
    recorded index tree, and the remaining input-snapshot delta is applied only
    to the worktree.  This recreates the original staged/unstaged/untracked
    organization rather than merely checking out the snapshot tree.
    """
    local_head = task.get("local_head") or local.get("local_head")
    input_tree = task.get("input_tree") or local.get("input_tree")
    input_index_tree = task.get("input_index_tree") or local.get("input_index_tree")
    if not isinstance(local_head, str) or not local_head:
        raise CodexRemoteError(
            "Task metadata does not contain the original local HEAD",
            code="TASK_INPUT_METADATA_MISSING",
        )
    if not isinstance(input_tree, str) or not input_tree:
        input_tree = git(root, "rev-parse", f"{input_sha}^{{tree}}").stdout.strip()
    if not isinstance(input_index_tree, str) or not input_index_tree:
        # Older task metadata cannot reconstruct the precise staged/unstaged
        # split, so refuse this destructive recovery option rather than guess.
        raise CodexRemoteError(
            "This task predates exact index-state recording; use the isolated conflict worktree instead.",
            code="TASK_INPUT_METADATA_MISSING",
        )

    git(root, "reset", "--hard", local_head)
    git(root, "clean", "-fd", "--")
    git(root, "read-tree", "--reset", "-u", input_index_tree)
    patch = git(
        root,
        "diff",
        "--binary",
        "--full-index",
        input_index_tree,
        input_sha,
        "--",
        text=False,
    ).stdout
    if patch:
        git(root, "apply", "--check", "--binary", "-", input_data=patch, text=False)
        git(root, "apply", "--binary", "-", input_data=patch, text=False)

    actual = {
        "head": current_head(root),
        "index_tree": index_tree(root),
        "tree": snapshot_tree_only(root),
    }
    expected = {
        "head": local_head,
        "index_tree": input_index_tree,
        "tree": input_tree,
    }
    if actual != expected:
        raise CodexRemoteError(
            "Could not reconstruct the exact task input after preserving local work. "
            "The backup branch remains available; stop and inspect the checkout.",
            code="TASK_INPUT_RECONSTRUCTION_FAILED",
            details={"expected": expected, "actual": actual},
        )
    return actual


def preserve_local_state_on_branch(
    root: Path,
    project_id: str,
    task: Mapping[str, Any],
    local: Mapping[str, Any],
    input_sha: str,
    *,
    max_untracked_bytes: int,
    push_backup: bool = False,
    backup_remote: str = "origin",
    state_dir: Path | None = None,
) -> dict[str, Any]:
    """Preserve the exact current checkout, then restore the task input state."""
    ensure_git_idle(root)
    ensure_no_submodules(root)
    ensure_safe_untracked(root, max_untracked_bytes)
    ensure_no_changed_lfs_paths(root)

    start_branch = task.get("local_branch") or local.get("local_branch")
    now_branch = current_branch(root)
    if not isinstance(start_branch, str) or not start_branch:
        raise CodexRemoteError(
            "The local-backup strategy requires a named task-start branch",
            code="BACKUP_REQUIRES_BRANCH",
        )
    if now_branch != start_branch:
        raise CodexRemoteError(
            f"The local-backup strategy is available only on the original branch {start_branch}; "
            f"the checkout is currently on {now_branch or '(detached)' }.",
            code="BACKUP_WRONG_BRANCH",
            details={"start_branch": start_branch, "current_branch": now_branch},
        )

    before = {
        "head": current_head(root),
        "index_tree": index_tree(root),
        "tree": snapshot_tree_only(root),
    }
    backup_ref_name = unique_local_backup_branch(root, start_branch)
    snapshot_ref = f"refs/codex/{project_id}/local-backup/{validate_safe_id(task['task_id'], 'task id')}"
    snapshot = create_hidden_snapshot(
        root,
        snapshot_ref,
        f"Preserve local state before Codex import {project_id}/{task['task_id']}",
    )
    backup_ref = f"refs/heads/{backup_ref_name}"
    try:
        git(root, "update-ref", backup_ref, snapshot["commit"])
    finally:
        git(root, "update-ref", "-d", snapshot_ref, check=False)

    backup_tree = git(root, "rev-parse", f"{backup_ref}^{{tree}}").stdout.strip()
    backup_parent = git(root, "rev-parse", f"{backup_ref}^").stdout.strip()
    if backup_tree != before["tree"] or backup_parent != before["head"]:
        git(root, "update-ref", "-d", backup_ref, check=False)
        raise CodexRemoteError(
            "The local backup branch did not reproduce the current checkout exactly",
            code="BACKUP_VERIFY_FAILED",
            details={
                "branch": backup_ref_name,
                "expected_tree": before["tree"],
                "actual_tree": backup_tree,
                "expected_parent": before["head"],
                "actual_parent": backup_parent,
            },
        )

    pushed = False
    if push_backup:
        remote_check = git(root, "remote", "get-url", backup_remote, check=False)
        if remote_check.returncode != 0:
            raise CodexRemoteError(
                f"Backup branch {backup_ref_name} was created locally, but remote {backup_remote!r} does not exist. "
                "The canonical checkout was not changed.",
                code="BACKUP_PUSH_FAILED",
                details={"branch": backup_ref_name, "remote": backup_remote},
            )
        push = git(
            root,
            "push",
            "--porcelain",
            backup_remote,
            f"{backup_ref}:{backup_ref}",
            check=False,
        )
        if push.returncode != 0:
            raise CodexRemoteError(
                f"Backup branch {backup_ref_name} was created locally, but pushing it to {backup_remote} failed. "
                "The canonical checkout was not changed.",
                code="BACKUP_PUSH_FAILED",
                details={
                    "branch": backup_ref_name,
                    "remote": backup_remote,
                    "stdout": push.stdout,
                    "stderr": push.stderr,
                },
            )
        pushed = True

    state_root = state_dir if state_dir is not None else local_project_state_dir(project_id)
    recovery = {
        "schema_version": SCHEMA_VERSION,
        "project_id": project_id,
        "task_id": task.get("task_id"),
        "state": "LOCAL_STATE_PRESERVED",
        "backup_branch": backup_ref_name,
        "backup_commit": snapshot["commit"],
        "backup_remote": backup_remote if pushed else None,
        "pushed": pushed,
        "original_branch": start_branch,
        "pre_reconstruction": before,
        "created_at": utc_now(),
    }
    atomic_write_json(state_root / "local-backup.json", recovery)

    cleanup_local_integration(
        root, project_id, str(task["task_id"]), state_dir=state_root
    )
    reconstructed = reconstruct_task_input_state(root, task, local, input_sha)
    recovery["reconstructed_input"] = reconstructed
    recovery["reconstructed_at"] = utc_now()
    atomic_write_json(state_root / "local-backup.json", recovery)
    return recovery


def mark_local_imported(project_id: str, task: Mapping[str, Any], changed: list[dict[str, str]]) -> None:
    local = read_json(local_current_path(project_id)) or {}
    local.update(
        {
            "schema_version": SCHEMA_VERSION,
            "project_id": project_id,
            "task_id": task.get("task_id"),
            "state": "IMPORTED",
            "imported_at": utc_now(),
            "changed_files": changed,
        }
    )
    atomic_write_json(local_current_path(project_id), local)


def cmd_apply(args: argparse.Namespace) -> dict[str, Any]:
    root, host, _remote_dir, timeout, project_id, _project_name = common_local_args(args)
    context = ensure_remote_helper(host, timeout)
    status = remote_status(context, project_id, timeout)
    task = status.get("task", {})
    state = task.get("state", "NONE")
    local = read_json(local_current_path(project_id)) or {}

    # Interactive tasks preserve Codex's individual commits and can be pulled
    # incrementally while the TUI stays alive.  Keep `apply` as a compatibility
    # entry point, but route it through the commit-preserving pull path.
    if task_execution_mode(task) == "interactive" and (
        state in ACTIVE_STATES
        or state in RESULT_READY_STATES
        or state in {"NOOP", "CANCELLED_NOOP"}
    ):
        return cmd_pull(args)

    if (
        local.get("task_id") == task.get("task_id")
        and local.get("state") == "APPLIED_PENDING_REMOTE_ACK"
    ):
        marked = remote_invoke(
            context,
            ["_server-mark-imported", "--project-id", project_id, "--task-id", task["task_id"]],
            timeout=timeout,
        )
        changed = local.get("changed_files") or []
        mark_local_imported(project_id, marked["task"], changed)
        return {
            "ok": True,
            "command": "apply",
            "project_id": project_id,
            "task": marked["task"],
            "source_state": state,
            "changed_files": changed,
            "tests": task.get("tests"),
            "message": "Recovered the prior local import and acknowledged it on the server.",
        }

    if state in {"NOOP", "CANCELLED_NOOP"}:
        marked = remote_invoke(
            context,
            ["_server-mark-imported", "--project-id", project_id, "--task-id", task["task_id"]],
            timeout=timeout,
        )
        mark_local_imported(project_id, marked["task"], [])
        return {
            "ok": True,
            "command": "apply",
            "project_id": project_id,
            "task": marked["task"],
            "source_state": state,
            "changed_files": [],
            "message": "Codex produced no changes; task marked imported.",
        }
    if state not in RESULT_READY_STATES:
        raise CodexRemoteError(
            f"Task is not ready to import; current state is {state}",
            code="TASK_NOT_READY",
            details=task,
        )
    check_startable_local(root, args.max_untracked_bytes)

    start_branch = task.get("local_branch")
    now_branch = current_branch(root)
    if start_branch != now_branch and not args.allow_branch_change:
        raise CodexRemoteError(
            f"Task started on branch {start_branch or '(detached)'} but the checkout is now on "
            f"{now_branch or '(detached)'}. Re-run with --allow-branch-change only when applying "
            "the Codex delta to the current branch is intentional.",
            code="BRANCH_CHANGED",
            details={"start_branch": start_branch, "current_branch": now_branch},
        )

    identifier = validate_safe_id(task["task_id"], "task id")
    input_ref = task.get("input_ref")
    result_ref = task.get("result_ref")
    result_expected_sha = task.get("result_sha")
    expected_input_ref = f"refs/codex/{project_id}/input/{identifier}"
    expected_result_ref = f"refs/codex/{project_id}/result/{identifier}"
    if input_ref != expected_input_ref or result_ref != expected_result_ref:
        raise CodexRemoteError(
            "Ready task contains unexpected hidden-ref metadata",
            code="REF_MISMATCH",
            details={
                "input_ref": input_ref,
                "expected_input_ref": expected_input_ref,
                "result_ref": result_ref,
                "expected_result_ref": expected_result_ref,
            },
        )
    if not isinstance(result_expected_sha, str) or not result_expected_sha:
        raise CodexRemoteError("Ready task has no result SHA", code="REMOTE_PROTOCOL_ERROR")
    local_input_ref = f"refs/codex/{project_id}/fetched-input/{identifier}"
    local_result_ref = f"refs/codex/{project_id}/fetched-result/{identifier}"
    remote_url = broker_url(host, task["broker"])
    git(
        root,
        "fetch",
        "--no-tags",
        remote_url,
        f"+{input_ref}:{local_input_ref}",
        f"+{result_ref}:{local_result_ref}",
        env=git_ssh_environment(timeout),
        timeout=max(timeout + 30, 60),
    )
    input_sha = git(root, "rev-parse", local_input_ref).stdout.strip()
    result_sha = git(root, "rev-parse", local_result_ref).stdout.strip()
    if input_sha != task["input_sha"]:
        raise CodexRemoteError("Fetched input ref does not match task metadata", code="REF_MISMATCH")
    if result_sha != result_expected_sha:
        raise CodexRemoteError("Fetched result ref does not match task metadata", code="REF_MISMATCH")

    backup = None
    if args.preserve_local_branch:
        backup = preserve_local_state_on_branch(
            root,
            project_id,
            task,
            local,
            input_sha,
            max_untracked_bytes=args.max_untracked_bytes,
            push_backup=args.push_backup,
            backup_remote=args.backup_remote,
        )

    integrated = integrate_result_into_worktree(
        root,
        project_id,
        identifier,
        input_sha,
        result_sha,
    )
    changed = integrated["changed_files"]
    pending = read_json(local_current_path(project_id)) or {}
    pending.update(
        {
            "schema_version": SCHEMA_VERSION,
            "project_id": project_id,
            "task_id": identifier,
            "state": "APPLIED_PENDING_REMOTE_ACK",
            "applied_at": utc_now(),
            "changed_files": changed,
            "merged_snapshot": integrated["merged"],
            "local_backup": backup,
        }
    )
    atomic_write_json(local_current_path(project_id), pending)

    marked = remote_invoke(
        context,
        ["_server-mark-imported", "--project-id", project_id, "--task-id", identifier],
        timeout=timeout,
    )
    mark_local_imported(project_id, marked["task"], changed)
    prefix = "Preserved current local work on branch " + backup["backup_branch"] + ". " if backup else ""
    return {
        "ok": True,
        "command": "apply",
        "project_id": project_id,
        "task": marked["task"],
        "source_state": state,
        "local_backup": backup,
        "changed_files": changed,
        "tests": task.get("tests"),
        "message": prefix + f"Imported {len(changed)} Codex-changed path(s) as ordinary local working-tree changes.",
    }

def cmd_clean(args: argparse.Namespace) -> dict[str, Any]:
    root, host, _remote_dir, timeout, project_id, _project_name = common_local_args(args)
    context = ensure_remote_helper(host, timeout)
    action = "discard" if args.discard else "archive"
    status = remote_status(context, project_id, timeout)
    task = status.get("task", {})
    local = read_json(local_current_path(project_id)) or {}
    if task.get("state", "NONE") == "NONE":
        if action != "discard" or not local.get("task_id"):
            raise CodexRemoteError("No task exists to clean", code="TASK_NOT_FOUND")
        task_id_value = validate_safe_id(local["task_id"], "task id")
        value = remote_invoke(
            context,
            ["_server-discard-stale", "--project-id", project_id, "--task-id", task_id_value],
            timeout=timeout + 10,
        )
    else:
        task_id_value = validate_safe_id(task["task_id"], "task id")
        value = remote_invoke(
            context,
            ["_server-clean", "--project-id", project_id, "--action", action],
            timeout=timeout + 10,
        )

    cleanup_local_integration(root, project_id, task_id_value)
    cleanup_local_refs(root, project_id, task_id_value, task or local)
    local.update(
        {
            "schema_version": SCHEMA_VERSION,
            "project_id": project_id,
            "task_id": task_id_value,
            "state": value["task"]["state"],
            f"{action}ed_at": utc_now(),
        }
    )
    atomic_write_json(local_current_path(project_id), local)
    return {"ok": True, "command": "clean", "project_id": project_id, "task": value["task"]}


def job_remote_context(
    args: argparse.Namespace,
) -> tuple[Path, str, int, str, str, dict[str, str]]:
    root, host, _remote_dir, timeout, project_id, project_name = common_local_args(args)
    context = ensure_remote_helper(host, timeout)
    remote_invoke(context, ["_server-init", "--project-id", project_id], timeout=timeout)
    return root, host, timeout, project_id, project_name, context



#!/bin/sh

set -u

usage() {
  printf 'usage: %s LATEXMK [LATEXMK-OPTION ...] MASTER.tex\n' "$0" >&2
}

if [ "$#" -lt 2 ]; then
  usage
  exit 64
fi

latexmk=$1
shift

run_build() {
  "$latexmk" "$@"
}

clean_intermediates() {
  # Reuse the build arguments so project-specific output-directory options are
  # honored.  In cleanup mode latexmk retains final PDF/DVI/PS output.
  "$latexmk" -c "$@"
}

on_signal() {
  signal=$1
  status=$2
  shift 2

  trap - HUP INT TERM
  printf '\nlatexmk-safe: interrupted by %s; cleaning intermediate files\n' \
    "$signal" >&2
  clean_intermediates "$@" >/dev/null 2>&1 || true
  exit "$status"
}

trap 'on_signal HUP 129 "$@"' HUP
trap 'on_signal INT 130 "$@"' INT
trap 'on_signal TERM 143 "$@"' TERM

run_build "$@"
status=$?
if [ "$status" -eq 0 ]; then
  exit 0
fi

# Do not turn an interrupted compilation into a second compilation.
if [ "$status" -ge 128 ]; then
  clean_intermediates "$@" || true
  exit "$status"
fi

printf '\nlatexmk-safe: build failed with status %d; cleaning intermediates and retrying once\n' \
  "$status" >&2
if ! clean_intermediates "$@"; then
  printf 'latexmk-safe: warning: cleanup reported an error; retrying anyway\n' >&2
fi

run_build "$@"
status=$?
if [ "$status" -ne 0 ]; then
  printf '\nlatexmk-safe: retry failed with status %d; cleaning intermediates before exit\n' \
    "$status" >&2
  clean_intermediates "$@" || true
fi

exit "$status"

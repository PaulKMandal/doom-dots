#!/bin/sh

set -u

usage() {
  printf 'usage: %s LATEXMK [LATEXMK-OPTION ...] MASTER.tex\n' "$0" >&2
}

if [ "$#" -lt 2 ]; then
  usage
  exit 64
fi

latexmk=$1
shift

run_build() {
  "$latexmk" "$@"
}

run_full_rebuild() {
  # Recovery must not reuse artifacts from the failed incremental build.
  # latexmk -gg performs a full clean (-C) and then a regular make
  # from a clean initial state.
  "$latexmk" -gg "$@"
}

on_signal() {
  signal=$1
  status=$2

  trap - HUP INT TERM
  printf '\nlatexmk-safe: interrupted by %s\n' "$signal" >&2
  exit "$status"
}

trap 'on_signal HUP 129' HUP
trap 'on_signal INT 130' INT
trap 'on_signal TERM 143' TERM

# Keep the common case incremental: latexmk itself checks the dependency graph
# and does nothing when the existing artifacts are current.
run_build "$@"
status=$?
if [ "$status" -eq 0 ]; then
  exit 0
fi

# Do not turn an interrupted compilation into a second compilation.
if [ "$status" -ge 128 ]; then
  exit "$status"
fi

printf '\nlatexmk-safe: incremental build failed with status %d; forcing a clean, complete rebuild\n' \
  "$status" >&2
run_full_rebuild "$@"
status=$?
if [ "$status" -ne 0 ]; then
  # Keep the final log, aux, and dependency files: they describe the clean
  # attempt and are useful for diagnosing a real source/toolchain failure.
  printf '\nlatexmk-safe: clean rebuild failed with status %d; preserving its diagnostics\n' \
    "$status" >&2
fi

exit "$status"
